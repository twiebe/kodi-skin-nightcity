<?xml version="1.0" encoding="UTF-8"?>
<smartplaylist type="movies">
    <name>WidgetRecentMovies.xsp</name>
    <match>one</match>
    <rule field="playcount" operator="greaterthan"><value>0</value></rule>
    <rule field="inprogress" operator="true"/>
    <limit>25</limit>
    <order direction="descending">lastplayed</order>
</smartplaylist>
