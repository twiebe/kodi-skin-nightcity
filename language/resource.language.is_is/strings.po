msgctxt "#31460"
msgid "IMDb users, 0 to 10, with the Top 250 rank. Needs an OMDb or MDbList key in TMDb Helper."
msgstr "IMDb-notendur, 0 til 10, með sætinu á Top 250. Þarf OMDb- eða MDbList-lykil í TMDb Helper."

msgctxt "#31461"
msgid "TMDb users, 0 to 10. Needs no key."
msgstr "TMDb-notendur, 0 til 10. Þarf engan lykil."

msgctxt "#31462"
msgid "Tomatometer: the share of positive critic reviews. Needs an OMDb or MDbList key in TMDb Helper."
msgstr "Tomatometer: hlutfall jákvæðra dóma gagnrýnenda. Þarf OMDb- eða MDbList-lykil í TMDb Helper."

msgctxt "#31463"
msgid "Popcornmeter: the share of positive audience ratings. Needs an MDbList or OMDb key in TMDb Helper."
msgstr "Popcornmeter: hlutfall jákvæðra einkunna áhorfenda. Þarf MDbList- eða OMDb-lykil í TMDb Helper."

msgctxt "#31464"
msgid "A weighted average of critic reviews, 0 to 100, mostly for theatrical films and big series. Needs an OMDb or MDbList key in TMDb Helper."
msgstr "Vegið meðaltal dóma gagnrýnenda, 0 til 100, aðallega fyrir bíómyndir og stórar þáttaraðir. Þarf OMDb- eða MDbList-lykil í TMDb Helper."

msgctxt "#31465"
msgid "Trakt users, 0 to 10. Needs a connected Trakt account in TMDb Helper: fetched from Trakt, not MDbList."
msgstr "Trakt-notendur, 0 til 10. Þarf tengdan Trakt-aðgang í TMDb Helper: sótt frá Trakt, ekki MDbList."

msgctxt "#31466"
msgid "Letterboxd users, 0 to 5, mostly films. Needs an MDbList key in TMDb Helper."
msgstr "Letterboxd-notendur, 0 til 5, aðallega kvikmyndir. Þarf MDbList-lykil í TMDb Helper."

msgctxt "#31467"
msgid "MDbList score: an average of the other sources, 0 to 100. Needs an MDbList key in TMDb Helper."
msgstr "MDbList-skor: meðaltal hinna uppsprettnanna, 0 til 100. Þarf MDbList-lykil í TMDb Helper."

