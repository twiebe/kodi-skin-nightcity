msgctxt "#31460"
msgid "IMDb users, 0 to 10, with the Top 250 rank. Needs an OMDb or MDbList key in TMDb Helper."
msgstr "IMDb-käyttäjät, 0-10, Top 250 -sijoituksen kanssa. Vaatii OMDb- tai MDbList-avaimen TMDb Helperissä."

msgctxt "#31461"
msgid "TMDb users, 0 to 10. Needs no key."
msgstr "TMDb-käyttäjät, 0-10. Ei vaadi avainta."

msgctxt "#31462"
msgid "Tomatometer: the share of positive critic reviews. Needs an OMDb or MDbList key in TMDb Helper."
msgstr "Tomatometer: myönteisten kriitikkoarvioiden osuus. Vaatii OMDb- tai MDbList-avaimen TMDb Helperissä."

msgctxt "#31463"
msgid "Popcornmeter: the share of positive audience ratings. Needs an MDbList or OMDb key in TMDb Helper."
msgstr "Popcornmeter: myönteisten yleisöarvioiden osuus. Vaatii MDbList- tai OMDb-avaimen TMDb Helperissä."

msgctxt "#31464"
msgid "A weighted average of critic reviews, 0 to 100, mostly for theatrical films and big series. Needs an OMDb or MDbList key in TMDb Helper."
msgstr "Kriitikkoarvioiden painotettu keskiarvo, 0-100, lähinnä elokuvateatterielokuville ja suurille sarjoille. Vaatii OMDb- tai MDbList-avaimen TMDb Helperissä."

msgctxt "#31465"
msgid "Trakt users, 0 to 10. Needs a connected Trakt account in TMDb Helper: fetched from Trakt, not MDbList."
msgstr "Trakt-käyttäjät, 0-10. Vaatii yhdistetyn Trakt-tilin TMDb Helperissä: haetaan Traktista, ei MDbLististä."

msgctxt "#31466"
msgid "Letterboxd users, 0 to 5, mostly films. Needs an MDbList key in TMDb Helper."
msgstr "Letterboxd-käyttäjät, 0-5, lähinnä elokuvia. Vaatii MDbList-avaimen TMDb Helperissä."

msgctxt "#31467"
msgid "MDbList score: an average of the other sources, 0 to 100. Needs an MDbList key in TMDb Helper."
msgstr "MDbList-pisteet: muiden lähteiden keskiarvo, 0-100. Vaatii MDbList-avaimen TMDb Helperissä."

