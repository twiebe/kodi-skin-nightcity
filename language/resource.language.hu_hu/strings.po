msgctxt "#31460"
msgid "IMDb users, 0 to 10, with the Top 250 rank. Needs an OMDb or MDbList key in TMDb Helper."
msgstr "IMDb felhasználók, 0-10, a Top 250 helyezéssel. OMDb vagy MDbList kulcs kell a TMDb Helperben."

msgctxt "#31461"
msgid "TMDb users, 0 to 10. Needs no key."
msgstr "TMDb felhasználók, 0-10. Nem kell kulcs."

msgctxt "#31462"
msgid "Tomatometer: the share of positive critic reviews. Needs an OMDb or MDbList key in TMDb Helper."
msgstr "Tomatometer: a pozitív kritikusi vélemények aránya. OMDb vagy MDbList kulcs kell a TMDb Helperben."

msgctxt "#31463"
msgid "Popcornmeter: the share of positive audience ratings. Needs an MDbList or OMDb key in TMDb Helper."
msgstr "Popcornmeter: a pozitív közönségértékelések aránya. MDbList vagy OMDb kulcs kell a TMDb Helperben."

msgctxt "#31464"
msgid "A weighted average of critic reviews, 0 to 100, mostly for theatrical films and big series. Needs an OMDb or MDbList key in TMDb Helper."
msgstr "A kritikusi vélemények súlyozott átlaga, 0-100, főleg mozifilmekhez és nagy sorozatokhoz. OMDb vagy MDbList kulcs kell a TMDb Helperben."

msgctxt "#31465"
msgid "Trakt users, 0 to 10. Needs a connected Trakt account in TMDb Helper: fetched from Trakt, not MDbList."
msgstr "Trakt felhasználók, 0-10. Összekapcsolt Trakt fiók kell a TMDb Helperben: a Traktról jön, nem az MDbListről."

msgctxt "#31466"
msgid "Letterboxd users, 0 to 5, mostly films. Needs an MDbList key in TMDb Helper."
msgstr "Letterboxd felhasználók, 0-5, főleg filmek. MDbList kulcs kell a TMDb Helperben."

msgctxt "#31467"
msgid "MDbList score: an average of the other sources, 0 to 100. Needs an MDbList key in TMDb Helper."
msgstr "MDbList pontszám: a többi forrás átlaga, 0-100. MDbList kulcs kell a TMDb Helperben."

