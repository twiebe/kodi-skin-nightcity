msgctxt "#31460"
msgid "IMDb users, 0 to 10, with the Top 250 rank. Needs an OMDb or MDbList key in TMDb Helper."
msgstr "IMDb-brugere, 0 til 10, med Top 250-placering. Kræver en OMDb- eller MDbList-nøgle i TMDb Helper."

msgctxt "#31461"
msgid "TMDb users, 0 to 10. Needs no key."
msgstr "TMDb-brugere, 0 til 10. Kræver ingen nøgle."

msgctxt "#31462"
msgid "Tomatometer: the share of positive critic reviews. Needs an OMDb or MDbList key in TMDb Helper."
msgstr "Tomatometer: andelen af positive anmeldelser fra kritikere. Kræver en OMDb- eller MDbList-nøgle i TMDb Helper."

msgctxt "#31463"
msgid "Popcornmeter: the share of positive audience ratings. Needs an MDbList or OMDb key in TMDb Helper."
msgstr "Popcornmeter: andelen af positive publikumsvurderinger. Kræver en MDbList- eller OMDb-nøgle i TMDb Helper."

msgctxt "#31464"
msgid "A weighted average of critic reviews, 0 to 100, mostly for theatrical films and big series. Needs an OMDb or MDbList key in TMDb Helper."
msgstr "Et vægtet gennemsnit af anmeldelser, 0 til 100, mest for biograffilm og store serier. Kræver en OMDb- eller MDbList-nøgle i TMDb Helper."

msgctxt "#31465"
msgid "Trakt users, 0 to 10. Needs a connected Trakt account in TMDb Helper: fetched from Trakt, not MDbList."
msgstr "Trakt-brugere, 0 til 10. Kræver en tilknyttet Trakt-konto i TMDb Helper: hentet fra Trakt, ikke MDbList."

msgctxt "#31466"
msgid "Letterboxd users, 0 to 5, mostly films. Needs an MDbList key in TMDb Helper."
msgstr "Letterboxd-brugere, 0 til 5, mest film. Kræver en MDbList-nøgle i TMDb Helper."

msgctxt "#31467"
msgid "MDbList score: an average of the other sources, 0 to 100. Needs an MDbList key in TMDb Helper."
msgstr "MDbList-score: et gennemsnit af de andre kilder, 0 til 100. Kræver en MDbList-nøgle i TMDb Helper."

