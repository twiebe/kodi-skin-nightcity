<?xml version="1.0" encoding="UTF-8"?>
<includes>
    <!-- Replaces the Nightcity file of the same name: the one place that names the skin -->
    <variable name="SkinTitle">
        <value>Confuse</value>
    </variable>
    <variable name="SkinVersion">
        <value>confuse $INFO[System.AddonVersion(skin.confuse)]</value>
    </variable>

    <!-- The first screen after boot: the logo in the middle and under it a spinner until Home takes
         over: its spokes stay where they are, only the light walks around them. The wait has no measure, so nothing here pretends to know how long it is.
         Confuse also means to confuse: on this screen something stumbles for a blink, the spinner
         skips, sticks and runs back, the logo points backwards -->
    <include name="LookStartupWordmark">
        <definition>
            <control type="group">
                <left>845</left>
                <top>340</top>
                <animation effect="slide" start="0,16" end="0,0" time="500" delay="100" tween="cubic" easing="out">WindowOpen</animation>
                <!-- the plate in the accent, on it the mark: a disc whose gap points forward -->
                <control type="image">
                    <width>230</width>
                    <height>230</height>
                    <aspectratio>keep</aspectratio>
                    <texture colordiffuse="accent">ui/logo_plate_230.png</texture>
                </control>
                <control type="image">
                    <width>230</width>
                    <height>230</height>
                    <aspectratio>keep</aspectratio>
                    <texture colordiffuse="focus_text">ui/logo_mark_230.png</texture>
                </control>
                <!-- glitch: for 150 ms at 1.9 s the mark points back and the logo hops 5 px left.
                     Animations of one type add up: the first fade shows it, the second hides it -->
                <control type="group">
                    <animation effect="fade" start="0" end="100" time="0" delay="1900">WindowOpen</animation>
                    <animation effect="fade" start="100" end="0" time="0" delay="2050">WindowOpen</animation>
                    <animation effect="slide" start="-5,0" end="-5,0" time="0">WindowOpen</animation>
                    <control type="image">
                        <width>230</width>
                        <height>230</height>
                        <aspectratio>keep</aspectratio>
                        <texture colordiffuse="accent">ui/logo_plate_230.png</texture>
                    </control>
                    <control type="image">
                        <width>230</width>
                        <height>230</height>
                        <aspectratio>keep</aspectratio>
                        <texture colordiffuse="focus_text">ui/logo_mark_230_back.png</texture>
                    </control>
                </control>
            </control>
        </definition>
    </include>
    <include name="LookStartupTrack">
        <param name="waiting"/>
        <param name="online"/>
        <definition>
            <!-- the frames in the order of tools/make_textures_confuse.py glitch_sequence -->
            <control type="multiimage">
                <left>932</left>
                <top>700</top>
                <width>56</width>
                <height>56</height>
                <aspectratio>keep</aspectratio>
                <imagepath colordiffuse="text">ui/spinner_glitch</imagepath>
                <timeperimage>85</timeperimage>
                <fadetime>0</fadetime>
                <loop>true</loop>
                <randomize>false</randomize>
            </control>
        </definition>
    </include>

    <!-- The tabs stand in the middle of the top line, the logo left of them. The logo stays bright
         while the quick menu dims the page, like the menu's own icon -->
    <constant name="LookMenuLeft">-24</constant>
    <constant name="LookMenuWidth">1920</constant>
    <include name="LookMenuAlign">
        <align>center</align>
    </include>
    <include name="LookHomeLogo">
        <control type="group">
            <left>64</left>
            <top>14</top>
            <!-- the plate in the accent, on it the mark: a disc whose gap points forward -->
            <control type="image">
                <width>60</width>
                <height>60</height>
                <aspectratio>keep</aspectratio>
                <texture colordiffuse="accent">ui/logo_plate_60.png</texture>
            </control>
            <control type="image">
                <width>60</width>
                <height>60</height>
                <aspectratio>keep</aspectratio>
                <texture colordiffuse="focus_text">ui/logo_mark_60.png</texture>
            </control>
        </control>
    </include>

    <!-- The hero is a large rounded picture, 64 px from the sides and 116 to 670 down. Its text lies
         on the lower part, the upper part of the picture stays free -->
    <constant name="LookHeroLeft">112</constant>
    <constant name="LookHeroKickerTop">284</constant>
    <constant name="LookHeroLogoTop">316</constant>
    <constant name="LookHeroTitleTop">326</constant>
    <constant name="LookHeroMetaTop">426</constant>
    <constant name="LookHeroRatingsTop">466</constant>
    <constant name="LookHeroPlotTop">506</constant>
    <constant name="LookHeroPlotHeight">72</constant>
    <constant name="LookHeroFocusTop">590</constant>
    <constant name="LookHeroPillsLeft">102</constant>
    <constant name="LookHeroPillsTop">580</constant>
    <constant name="LookHeroProgressTop">660</constant>
    <constant name="LookPageRowsTop">674</constant>

    <!-- The picture of the hero, sharp and round by its mask, and over it the fade that carries the
         text. The shadow under it is the one of a focused card -->
    <include name="LookHomeFanart">
        <param name="art"/>
        <param name="shown"/>
        <param name="fadetime" default="200"/>
        <definition>
            <control type="image">
                <left>40</left>
                <top>92</top>
                <width>1840</width>
                <height>602</height>
                <texture border="40" colordiffuse="shadow">ui/card_halo.png</texture>
                <visible>$PARAM[shown]</visible>
            </control>
            <control type="image">
                <description>hero picture</description>
                <left>64</left>
                <top>116</top>
                <width>1792</width>
                <height>554</height>
                <aspectratio scalediffuse="false">scale</aspectratio>
                <fadetime>$PARAM[fadetime]</fadetime>
                <texture diffuse="ui/mask_hero.png" background="true">$INFO[$PARAM[art]]</texture>
                <visible>$PARAM[shown]</visible>
            </control>
            <control type="image">
                <left>64</left>
                <top>116</top>
                <width>1792</width>
                <height>554</height>
                <texture colordiffuse="bg">ui/hero_scrim.png</texture>
                <visible>$PARAM[shown]</visible>
            </control>
        </definition>
    </include>

    <!-- The picture says it all: no poster beside it -->
    <include name="LookHeroPoster">
        <param name="image"/>
        <param name="item"/>
        <param name="label"/>
        <param name="missing"/>
        <definition/>
    </include>

    <!-- The title of the focused card in the top line of its row: none here, the hero and the card name it -->
    <include name="LookRowFocusTitle">
        <param name="label"/>
        <param name="shown"/>
        <definition/>
    </include>

    <!-- The other rows of Home show posters, as Nightcity -->
    <variable name="LookRowArt">
        <value condition="!String.IsEmpty(ListItem.Art(tvshow.poster))">$INFO[ListItem.Art(tvshow.poster)]</value>
        <value>$INFO[ListItem.Art(poster)]</value>
    </variable>
    <include name="LookRowCard">
        <param name="image"/>
        <param name="dim" default="false"/>
        <param name="focused" default="false"/>
        <definition>
            <include content="CutCard">
                <param name="image" value="$PARAM[image]"/>
                <param name="dim" value="$PARAM[dim]"/>
                <param name="focused" value="$PARAM[focused]"/>
                <include>CardExtras</include>
            </include>
        </definition>
    </include>
    <constant name="LookRowWideItemWidth">444</constant>
    <!-- What plays on (continue, next up) is wide: the picture of the film or the show, never the
         still of an episode; fanart is 16:9, so nothing is cut. A wide picture does not always name
         its title, so the label stands under the card. Only these rows load large pictures -->
    <variable name="LookRowWideArt">
        <value condition="!String.IsEmpty(ListItem.Art(landscape))">$INFO[ListItem.Art(landscape)]</value>
        <value condition="!String.IsEmpty(ListItem.Art(tvshow.landscape))">$INFO[ListItem.Art(tvshow.landscape)]</value>
        <value condition="!String.IsEmpty(ListItem.Art(fanart))">$INFO[ListItem.Art(fanart)]</value>
        <value condition="!String.IsEmpty(ListItem.Art(tvshow.fanart))">$INFO[ListItem.Art(tvshow.fanart)]</value>
        <value condition="!String.IsEmpty(ListItem.Art(tvshow.poster))">$INFO[ListItem.Art(tvshow.poster)]</value>
        <value>$INFO[ListItem.Art(poster)]</value>
    </variable>
    <include name="LookRowWideCard">
        <param name="image"/>
        <param name="dim" default="false"/>
        <param name="focused" default="false"/>
        <definition>
            <include content="CutCard">
                <param name="width" value="400"/>
                <param name="height" value="225"/>
                <param name="mask" value="ui/mask_400x225.png"/>
                <param name="glowwidth" value="448"/>
                <param name="glowheight" value="273"/>
                <param name="image" value="$PARAM[image]"/>
                <param name="dim" value="$PARAM[dim]"/>
                <param name="focused" value="$PARAM[focused]"/>
                <include content="CardExtras">
                    <param name="textwidth" value="368"/>
                    <param name="textheight" value="193"/>
                    <param name="linetop" value="209"/>
                    <param name="linewidth" value="376"/>
                </include>
                <control type="label">
                    <top>236</top>
                    <width>400</width>
                    <height>34</height>
                    <font>font_small</font>
                    <textcolor>text_mute</textcolor>
                    <label>$INFO[ListItem.Label]</label>
                </control>
            </include>
        </definition>
    </include>

    <!-- The split of a combo row, drawn by the first card of next up (RowBox split): a thin rule
         in the middle of the 44 px gap before the card, from the top of a small heading over the
         card down to the card's label, quiet like any separator. Relative to the card -->
    <include name="LookRowSplit">
        <param name="visible"/>
        <definition>
            <control type="group">
                <visible>$PARAM[visible]</visible>
                <control type="image">
                    <left>-23</left>
                    <top>-38</top>
                    <width>2</width>
                    <height>308</height>
                    <texture colordiffuse="state">ui/white.png</texture>
                </control>
                <control type="label">
                    <left>0</left>
                    <top>-42</top>
                    <width>400</width>
                    <height>30</height>
                    <font>font_caps_small</font>
                    <textcolor>state_text</textcolor>
                    <include content="LookLabelCase">
                        <param name="text" value="$LOCALIZE[31234]"/>
                    </include>
                </control>
            </control>
        </definition>
    </include>

    <!-- The look of the shared building blocks: texture tags, focus frames, decoration and
         sizes. The names of 1080i/Includes_Look.xml, with values of this skin. No ids, no on*
         actions, a visible only as a $PARAM: what a control does stays in the shared files. -->

    <!-- how far a focused card grows and how long it takes -->
    <constant name="LookCardFocusZoom">108</constant>
    <constant name="LookCardFocusTime">120</constant>
    <!-- the space between the rows of a page of Home -->
    <constant name="LookRowGap">0</constant>
    <!-- The list of a row and the room around a card in it, for what a focused card draws past its
         edges; a list clips its items. A 400 x 225 card at 108 % grows 16 px to a side and 9 up and
         down (a poster 8 and 12), its glow is 24 px x 1.08 more: ItemTop at least 38, ItemLeft at
         least 42. ItemWidth is a poster and its gap, the wide rows take LookRowWideItemWidth. The list
         starts where the card before ends, so no strip of that card shows on a scrolled row:
         ItemLeft is also the gap between the cards, 44.
         In pairs, since a constant cannot add up: ListLeft + ItemLeft stays 64, ListTop + ItemTop
         stays 78, ListLeft + ListWidth stays 1920, ListTop + ListHeight stays 468 (the height of a
         row), which keeps the 90 px under the card. ItemWidth is the card and its space to the next.
         tests/static/test_confuse_look.py checks the sums. -->
    <constant name="LookRowListLeft">20</constant>
    <constant name="LookRowItemLeft">44</constant>
    <constant name="LookRowListTop">30</constant>
    <constant name="LookRowItemTop">48</constant>
    <constant name="LookRowListWidth">1900</constant>
    <constant name="LookRowListHeight">438</constant>
    <constant name="LookRowItemWidth">244</constant>

    <!-- The genre tabs of a row: no number before them here, so the text of the first stands over
         the first card (24 px gap, 10 px of padding) -->
    <constant name="LookGenreTabsLeft">30</constant>

    <!-- Full screen page: the base colour, a little lighter at the top. One opaque picture, small,
         Kodi scales it up smoothly -->
    <include name="LookBackground">
        <control type="image">
            <left>0</left>
            <top>0</top>
            <width>1920</width>
            <height>1080</height>
            <texture colordiffuse="surface">ui/page_wash.png</texture>
        </control>
    </include>

    <!-- The info page's fanart is quieter than Home's in the draft: over its mask a fade in the base
         colour, the second and last full screen layer with alpha. Right column of the page stays
         readable on a white picture. -->
    <include name="LookInfoFade">
        <control type="image">
            <left>0</left>
            <top>0</top>
            <width>1920</width>
            <height>1080</height>
            <texture colordiffuse="bg">ui/info_fade.png</texture>
        </control>
    </include>

    <!-- The plate under a card's artwork, round like it: what shows of a card without artwork. A
         9-slice with the radius of the masks, drawn without one -->
    <include name="LookCardFrame">
        <param name="width"/>
        <param name="height"/>
        <param name="mask"/>
        <param name="focused"/>
        <param name="unfocused"/>
        <definition>
            <control type="image">
                <width>$PARAM[width]</width>
                <height>$PARAM[height]</height>
                <texture border="12" colordiffuse="surface">ui/cut_btn_fill.png</texture>
            </control>
        </definition>
    </include>

    <!-- A card's artwork, round in both states. scalediffuse="false" keeps the mask on the card when
         scale crops artwork of another ratio -->
    <include name="LookCardArt">
        <param name="image"/>
        <param name="mask"/>
        <param name="fadetime"/>
        <definition>
            <aspectratio scalediffuse="false">scale</aspectratio>
            <fadetime>$PARAM[fadetime]</fadetime>
            <texture diffuse="$PARAM[mask]" background="true">$PARAM[image]</texture>
        </definition>
    </include>
    <include name="LookCardArtFocused">
        <param name="image"/>
        <param name="mask"/>
        <param name="fadetime"/>
        <definition>
            <aspectratio scalediffuse="false">scale</aspectratio>
            <fadetime>$PARAM[fadetime]</fadetime>
            <texture diffuse="$PARAM[mask]" background="true">$PARAM[image]</texture>
        </definition>
    </include>

    <!-- A focused card grows and glows, under its artwork. Fixed at 24 px past the card since
         card_halo.png has this margin: the callers pass card + 48 -->
    <include name="LookCardFocus">
        <param name="glowwidth"/>
        <param name="glowheight"/>
        <param name="focused"/>
        <definition>
            <control type="image">
                <left>-24</left>
                <top>-24</top>
                <width>$PARAM[glowwidth]</width>
                <height>$PARAM[glowheight]</height>
                <texture border="40" colordiffuse="card_glow">ui/card_halo.png</texture>
                <visible>$PARAM[focused]</visible>
            </control>
        </definition>
    </include>

    <!-- A focused card's amber ring, over its artwork and extras -->
    <include name="LookCardFocusRing">
        <param name="width"/>
        <param name="height"/>
        <param name="focused"/>
        <param name="current"/>
        <param name="unfocused"/>
        <definition>
            <control type="image">
                <width>$PARAM[width]</width>
                <height>$PARAM[height]</height>
                <texture border="16" colordiffuse="focus">ui/card_ring.png</texture>
                <visible>$PARAM[focused]</visible>
            </control>
            <!-- the current one (the episode the page is about): the focus frame without the glow -->
            <control type="image">
                <width>$PARAM[width]</width>
                <height>$PARAM[height]</height>
                <texture border="16" colordiffuse="focus">ui/card_ring.png</texture>
                <visible>$PARAM[current]</visible>
            </control>
        </definition>
    </include>

    <!-- The mark of an unwatched title, in the bottom right corner of a group as large as the card:
         a warm white dot, inside the round corner, on a soft dark spot that keeps it on bright
         posters -->
    <include name="LookCardUnwatched">
        <param name="visible"/>
        <definition>
            <control type="image">
                <right>4</right>
                <bottom>4</bottom>
                <width>28</width>
                <height>28</height>
                <aspectratio>keep</aspectratio>
                <texture colordiffuse="shadow">ui/dot_shade.png</texture>
                <visible>$PARAM[visible]</visible>
            </control>
            <control type="image">
                <right>10</right>
                <bottom>10</bottom>
                <width>16</width>
                <height>16</height>
                <aspectratio>keep</aspectratio>
                <texture colordiffuse="text">ui/dot.png</texture>
                <visible>$PARAM[visible]</visible>
            </control>
        </definition>
    </include>

    <!-- A button, 74 px high with 10 px of padding: a pill of white at .15, focused filled with a glow
         in the padding.
         Border 37 is the padding and the round end of the 54 px pill. A primary button looks like
         the others here: `color` stays unused, `rest` is what a caller can still change (a cursor
         that lies waiting, invisible, on its rail). -->
    <include name="LookButtonTextures">
        <param name="color" default="border_dim"/>
        <param name="rest" default="border_dim"/>
        <definition>
            <include>LookButtonFill</include>
            <texturenofocus border="37" colordiffuse="$PARAM[rest]">ui/pill_pad.png</texturenofocus>
        </definition>
    </include>
    <include name="LookButtonFill">
        <texturefocus border="37" colordiffuse="focus">ui/pill_halo.png</texturefocus>
    </include>
    <include name="LookButtonOutline">
        <param name="color"/>
        <definition>
            <texturenofocus border="37" colordiffuse="border_dim">ui/pill_pad.png</texturenofocus>
        </definition>
    </include>
    <!-- The fill for a button that shows another one's focus: it has no focus itself -->
    <include name="LookButtonFillNoFocus">
        <texturenofocus border="37" colordiffuse="focus">ui/pill_halo.png</texturenofocus>
    </include>

    <!-- The focused row of a list: the fill as an image of the row, and as the textures of a row
         that is a button -->
    <include name="LookListFocus">
        <texture border="22" colordiffuse="focus">ui/cut_btn_glow.png</texture>
    </include>
    <include name="LookListFocusButton">
        <texturefocus border="22" colordiffuse="focus">ui/cut_btn_glow.png</texturefocus>
        <texturenofocus/>
    </include>

    <!-- The plate of the time bubble over the seek line, 260 x 50 px: no outline in this look -->
    <include name="LookSeekBubble">
        <control type="image">
            <width>260</width>
            <height>50</height>
            <texture border="12" colordiffuse="surface">ui/cut_btn_fill.png</texture>
        </control>
    </include>

    <!-- The fill behind the quick menu's icon in the top line while it has the focus -->
    <include name="LookMenuIconFocus">
        <texture border="32" colordiffuse="accent">ui/pill_menu.png</texture>
    </include>

    <!-- A tile (settings groups, quick menu): the outline, the focused fill with its glow, and both
         for a tile that is a button itself, padded for the glow -->
    <include name="LookTileFrame">
        <texture border="16" colordiffuse="border_dim">ui/cut.png</texture>
    </include>
    <include name="LookTileFocus">
        <texture border="26" colordiffuse="focus">ui/cut_fill_glow.png</texture>
    </include>
    <include name="LookTileButtonTextures">
        <texturenofocus border="26" colordiffuse="border_dim">ui/cut_pad.png</texturenofocus>
        <texturefocus border="26" colordiffuse="focus">ui/cut_fill_glow.png</texturefocus>
    </include>

    <!-- Decoration without a task: none in this look -->
    <include name="LookDecoration">
        <definition/>
    </include>

    <!-- The pill of … on the info page, 116 x 74 px: unfocused and focused like a button. The caller
         names a colour for each state, `focus` only when it has the focus: the texture goes by it. -->
    <include name="LookMorePill">
        <param name="texture"/>
        <param name="color"/>
        <definition>
            <texture border="37" colordiffuse="$PARAM[color]">ui/more_$PARAM[color].png</texture>
        </definition>
    </include>

    <!-- A tab: the shown one has the line under its label, with the focus that line glows. A tab takes
         the focus and shows its page at once, so without the glow the two would look the same. The
         line's clear ends leave out the padding but 2 px; border 11 holds them and the line's round
         ends, border 18 the glow too. -->
    <include name="LookTabTextures">
        <texturefocus colordiffuse="accent" border="18,0,18,0">ui/tab_glow.png</texturefocus>
        <texturenofocus/>
        <alttexturefocus colordiffuse="accent" border="18,0,18,0">ui/tab_glow.png</alttexturefocus>
        <alttexturenofocus colordiffuse="accent" border="11,0,11,0">ui/tab_line.png</alttexturenofocus>
    </include>

    <!-- The season tabs look like the other tabs. A list cuts what lies left of it, so here the list
         starts 10 px further left and the label 10 px in: room for the glow, the text stays over
         the cards. A list layout has no auto width for an image, so one length for all: as long as
         "Season 1" and its padding. The glow lies under the text, the line of the shown season
         without the focus over it. -->
    <constant name="LookSeasonListLeft">54</constant>
    <include name="LookSeasonTabInset">
        <left>10</left>
    </include>
    <include name="LookSeasonTabShown">
        <param name="focused"/>
        <definition>
            <control type="image">
                <width>132</width>
                <height>44</height>
                <texture colordiffuse="accent" border="18,0,18,0">ui/tab_glow.png</texture>
                <visible>$PARAM[focused]</visible>
            </control>
            <include content="SeasonTab">
                <param name="color" value="text"/>
            </include>
        </definition>
    </include>
    <include name="LookSeasonTabLine">
        <param name="unfocused"/>
        <definition>
            <control type="image">
                <width>132</width>
                <height>44</height>
                <texture colordiffuse="accent" border="11,0,11,0">ui/tab_line.png</texture>
                <visible>$PARAM[unfocused]</visible>
            </control>
        </definition>
    </include>

    <!-- An entry of the top menu, 64 px high with a 44 px pill: the shown page white, with the focus
         the accent. The focus shows its page at once, so every other entry stays plain text. -->
    <include name="LookMenuTextures">
        <texturefocus border="32" colordiffuse="accent">ui/pill_menu.png</texturefocus>
        <texturenofocus/>
        <alttexturefocus border="32" colordiffuse="accent">ui/pill_menu.png</alttexturefocus>
        <alttexturenofocus border="32" colordiffuse="text">ui/pill_menu.png</alttexturenofocus>
    </include>

    <!-- Dialog panel: opaque base (surface alone lets the window behind show through), cut-corner
         surface and a thin outline, sized by the parent group -->
    <include name="LookPanel">
        <control type="image">
            <left>0</left>
            <top>0</top>
            <texture border="16" colordiffuse="bg">ui/cut_fill.png</texture>
        </control>
        <control type="image">
            <left>0</left>
            <top>0</top>
            <texture border="16" colordiffuse="surface">ui/cut_fill.png</texture>
        </control>
        <control type="image">
            <left>0</left>
            <top>0</top>
            <texture border="16" colordiffuse="border_dim">ui/cut.png</texture>
        </control>
    </include>

    <!-- The text of a button. tools/build.py strips [UPPERCASE]
         from the assembled skin, so a text shows as written; it reads the tag first, to keep digits
         passed as a label literal. [CAPITALIZE] gives a fixed label its capitals. It stays off
         what can be a film's title, whose small words stay small. -->
    <include name="LookPillText">
        <param name="label"/>
        <param name="textcolor"/>
        <param name="textoffsetx"/>
        <definition>
            <label>[CAPITALIZE][UPPERCASE]$PARAM[label][/UPPERCASE][/CAPITALIZE]</label>
            <font>font_caps</font>
            <textoffsetx>$PARAM[textoffsetx]</textoffsetx>
            <align>center</align>
            <aligny>center</aligny>
            <textcolor>$PARAM[textcolor]</textcolor>
            <focusedcolor>focus_text</focusedcolor>
        </definition>
    </include>

    <include name="LookPillDisabled">
        <param name="color"/>
        <definition>
            <disabledcolor>$PARAM[color]</disabledcolor>
        </definition>
    </include>

    <!-- altlabel is what the tab or menu entry of the shown page reads: the white of the text, in the
         same font. Bold would change the letters and push the entries after it on every move of the
         focus, as the focus shows a page at once. -->
    <include name="LookTabText">
        <param name="label"/>
        <param name="font"/>
        <definition>
            <font>$PARAM[font]</font>
            <textoffsetx>10</textoffsetx>
            <aligny>center</aligny>
            <textcolor>text_mute</textcolor>
            <focusedcolor>text</focusedcolor>
            <label>[CAPITALIZE][UPPERCASE]$PARAM[label][/UPPERCASE][/CAPITALIZE]</label>
            <altlabel>[COLOR text][CAPITALIZE][UPPERCASE]$PARAM[label][/UPPERCASE][/CAPITALIZE][/COLOR]</altlabel>
        </definition>
    </include>

    <include name="LookMenuText">
        <param name="label"/>
        <definition>
            <font>font_caps</font>
            <textoffsetx>32</textoffsetx>
            <aligny>center</aligny>
            <textcolor>text_dim</textcolor>
            <focusedcolor>focus_text</focusedcolor>
            <label>[CAPITALIZE][UPPERCASE]$PARAM[label][/UPPERCASE][/CAPITALIZE]</label>
            <altlabel>[COLOR bg][CAPITALIZE][UPPERCASE]$PARAM[label][/UPPERCASE][/CAPITALIZE][/COLOR]</altlabel>
        </definition>
    </include>

    <!-- A label as written, in this look: line of the path, row titles, tiles of the quick menu -->
    <include name="LookLabelCase">
        <param name="text"/>
        <definition>
            <label>[UPPERCASE]$PARAM[text][/UPPERCASE]</label>
        </definition>
    </include>

    <!-- A quiet plate for one technical fact, no frame -->
    <include name="LookTag">
        <param name="label"/>
        <definition>
            <font>font_caps_small</font>
            <texturenofocus border="8" colordiffuse="chip">ui/chip.png</texturenofocus>
            <texturefocus border="8" colordiffuse="chip">ui/chip.png</texturefocus>
            <label>[UPPERCASE]$PARAM[label][/UPPERCASE]</label>
        </definition>
    </include>

    <!-- The small amber line above a title -->
    <include name="LookKicker">
        <param name="label"/>
        <definition>
            <font>font_caps_small</font>
            <textcolor>accent2</textcolor>
            <label>[UPPERCASE]$PARAM[label][/UPPERCASE]</label>
        </definition>
    </include>

    <!-- The heading of a section of a page, in white -->
    <include name="LookSectionHeading">
        <param name="label"/>
        <definition>
            <font>font_caps</font>
            <textcolor>text</textcolor>
            <label>[UPPERCASE]$PARAM[label][/UPPERCASE]</label>
        </definition>
    </include>

    <!-- The number of a row whose top line holds tabs: rows have no numbers in this look -->
    <include name="LookRowNumber">
        <param name="num"/>
        <definition/>
    </include>

    <!-- The heading of a row of a page of Home: no number, in bold white -->
    <include name="LookNumberedRowLabel">
        <param name="num"/>
        <param name="label"/>
        <definition>
            <font>font_caps</font>
            <textcolor>text</textcolor>
            <label>[B][CAPITALIZE][UPPERCASE]$PARAM[label][/UPPERCASE][/CAPITALIZE][/B]</label>
        </definition>
    </include>

    <!-- The copies of a page title that glitch in another look: none here -->
    <include name="LookTitleGlitch">
        <param name="label"/>
        <param name="width"/>
        <param name="height"/>
        <param name="font"/>
        <param name="align"/>
        <definition/>
    </include>
</includes>
