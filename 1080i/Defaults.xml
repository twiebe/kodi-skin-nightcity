<?xml version="1.0" encoding="UTF-8"?>
<!-- Skin-wide control defaults. Kodi pulses the focus texture of a focused button on every
     frame unless told otherwise, which keeps the whole screen redrawing. -->
<includes>
    <default type="button">
        <pulseonselect>false</pulseonselect>
    </default>
    <default type="togglebutton">
        <pulseonselect>false</pulseonselect>
    </default>
    <default type="radiobutton">
        <pulseonselect>false</pulseonselect>
        <font>font13</font>
    </default>
    <default type="edit">
        <pulseonselect>false</pulseonselect>
    </default>
    <default type="spincontrolex">
        <pulseonselect>false</pulseonselect>
    </default>
    <default type="sliderex">
        <pulseonselect>false</pulseonselect>
    </default>
    <default type="colorbutton">
        <pulseonselect>false</pulseonselect>
    </default>
    <!-- Kodi draws no text for a control without a font. Add-on windows that bring their own XML
         rely on the skin for it, like Estuary and Arctic Fuse 3 do: the CoreELEC Configuration's
         setting rows (labels) were blank, its wizard's choices (radiobuttons) too. The skin's
         own labels all name their font; its fontless buttons are stand-ins and stay without. -->
    <default type="label">
        <font>font13</font>
    </default>
    <default type="fadelabel">
        <font>font13</font>
    </default>
    <default type="textbox">
        <font>font13</font>
    </default>
</includes>
