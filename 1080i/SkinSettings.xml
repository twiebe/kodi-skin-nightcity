<?xml version="1.0" encoding="UTF-8"?>
<!-- Skin settings, laid out like Kodi's settings pages (SettingsCategory.xml): categories on the
     left, the rows of the focused category on the right, its description at the bottom. Home,
     Movies and Shows hold the spotlight and 8 slots of their page: OK on a slot picks a section
     (script section_pick, Kodi's select dialog), right cycles the option, "move" in the dialog
     grabs the slot (dark blue), up/down carry it, OK drops it. Slot rows come from
     Includes_Sections.xml (tools/make_sections.py). Window properties: nc.hp.tab (category
     shown), nc.hp.grab (grabbed slot as page.n), nc.hp.slide (the delay slider of Player is
     taken). Main menu comes first, colour scheme and glow at its end; Ratings and Player last. -->
<window>
    <defaultcontrol always="true">9000</defaultcontrol>
    <onload>SetProperty(nc.hp.tab,menu)</onload>
    <onload>SetFocus(9005)</onload>
    <onload>ClearProperty(nc.hp.grab)</onload>
    <!-- the delay slider of the Player category: the default delay, and let go of the slider -->
    <onload condition="String.IsEmpty(Skin.String(nc.osd.hide.secs))">NotifyAll(nightcity,osd_hide:8:0)</onload>
    <onload>ClearProperty(nc.hp.slide)</onload>
    <include>HomePagesDefaults</include>
    <controls>
        <include>Background</include>
        <include content="StatusBar">
            <param name="title" value="$LOCALIZE[166]"/>
        </include>
        <!-- the content fades in on open; background and status line stay -->
        <control type="group">
            <include>WindowFade</include>
            <control type="grouplist" id="9000">
                <left>120</left>
                <top>100</top>
                <width>400</width>
                <height>840</height>
                <itemgap>0</itemgap>
                <!-- Left leaves the page, back to the console -->
                <onleft>Action(Back)</onleft>
                <onright condition="String.IsEqual(Window.Property(nc.hp.tab),home)">200</onright>
                <onright condition="String.IsEqual(Window.Property(nc.hp.tab),movies)">300</onright>
                <onright condition="String.IsEqual(Window.Property(nc.hp.tab),shows)">400</onright>
                <onright condition="String.IsEqual(Window.Property(nc.hp.tab),menu)">500</onright>
                <onright condition="String.IsEqual(Window.Property(nc.hp.tab),ratings)">800</onright>
                <onright condition="String.IsEqual(Window.Property(nc.hp.tab),player)">700</onright>
                <onright>500</onright>
                <onup>noop</onup>
                <ondown>noop</ondown>
                <include content="SkinSettingsCategory">
                    <param name="id" value="9005"/>
                    <param name="tab" value="menu"/>
                    <param name="label" value="$LOCALIZE[31264]"/>
                </include>
                <include content="SkinSettingsCategory">
                    <param name="id" value="9002"/>
                    <param name="tab" value="home"/>
                    <param name="label" value="$LOCALIZE[10000]"/>
                </include>
                <include content="SkinSettingsCategory">
                    <param name="id" value="9003"/>
                    <param name="tab" value="movies"/>
                    <param name="label" value="$LOCALIZE[342]"/>
                </include>
                <include content="SkinSettingsCategory">
                    <param name="id" value="9004"/>
                    <param name="tab" value="shows"/>
                    <param name="label" value="$LOCALIZE[20343]"/>
                </include>
                <include content="SkinSettingsCategory">
                    <param name="id" value="9007"/>
                    <param name="tab" value="ratings"/>
                    <param name="label" value="$LOCALIZE[31445]"/>
                </include>
                <include content="SkinSettingsCategory">
                    <param name="id" value="9006"/>
                    <param name="tab" value="player"/>
                    <param name="label" value="$LOCALIZE[14200]"/>
                </include>
            </control>
            <include content="SkinSettingsArea">
                <param name="id" value="200"/>
                <param name="tab" value="home"/>
                <param name="category" value="9002"/>
                <param name="height" value="156"/>
                <param name="down" value="221"/>
                <include content="SkinSettingsHeading">
                    <param name="label" value="$LOCALIZE[31225]"/>
                </include>
                <include>HomePagesHeaderHome</include>
            </include>
            <include>HomePagesSlotsHome</include>
            <include content="SkinSettingsArea">
                <param name="id" value="300"/>
                <param name="tab" value="movies"/>
                <param name="category" value="9003"/>
                <param name="height" value="156"/>
                <param name="down" value="321"/>
                <include content="SkinSettingsHeading">
                    <param name="label" value="$LOCALIZE[31225]"/>
                </include>
                <include>HomePagesHeaderMovies</include>
            </include>
            <include>HomePagesSlotsMovies</include>
            <include content="SkinSettingsArea">
                <param name="id" value="400"/>
                <param name="tab" value="shows"/>
                <param name="category" value="9004"/>
                <param name="height" value="156"/>
                <param name="down" value="421"/>
                <include content="SkinSettingsHeading">
                    <param name="label" value="$LOCALIZE[31225]"/>
                </include>
                <include>HomePagesHeaderShows</include>
            </include>
            <include>HomePagesSlotsShows</include>
            <!-- entries of the main menu that can go -->
            <include content="SkinSettingsArea">
                <param name="id" value="500"/>
                <param name="tab" value="menu"/>
                <param name="category" value="9005"/>
                <include content="SkinSettingsToggle">
                    <param name="id" value="511"/>
                    <param name="label" value="$LOCALIZE[342]"/>
                    <param name="setting" value="nc.menu.hide.movies"/>
                </include>
                <include content="SkinSettingsToggle">
                    <param name="id" value="512"/>
                    <param name="label" value="$LOCALIZE[20343]"/>
                    <param name="setting" value="nc.menu.hide.shows"/>
                </include>
                <include content="SkinSettingsToggle">
                    <param name="id" value="516"/>
                    <param name="label" value="$LOCALIZE[2]"/>
                    <param name="setting" value="nc.menu.hide.music"/>
                </include>
                <include content="SkinSettingsToggle">
                    <param name="id" value="513"/>
                    <param name="label" value="$LOCALIZE[137]"/>
                    <param name="setting" value="nc.menu.hide.search"/>
                </include>
                <!-- the script forgets the remembered terms when the switch goes off -->
                <include content="SkinSettingsToggle">
                    <param name="id" value="514"/>
                    <param name="label" value="$LOCALIZE[31336]"/>
                    <param name="setting" value="nc.search.forget"/>
                    <param name="onclick" value="NotifyAll(nightcity,search_forget)"/>
                </include>
                <control type="button" id="515">
                    <width>1240</width>
                    <include>SettingsRowLook</include>
                    <label>$LOCALIZE[31338]</label>
                    <visible>!String.IsEmpty(Window(Home).Property(nc.search.recent.1))</visible>
                    <onclick>NotifyAll(nightcity,search_clear)</onclick>
                </control>
                <!-- the script writes or removes the Home key keymap right away -->
                <include content="SkinSettingsToggle">
                    <param name="id" value="521"/>
                    <param name="label" value="$LOCALIZE[31310]"/>
                    <param name="setting" value="nc.homekey.off"/>
                    <param name="onclick" value="NotifyAll(nightcity,home_keymap)"/>
                </include>
                <!-- the look: colour scheme and glow, no category of their own. One group under a separator
                     and a heading: a grouplist stops at a label, the group takes the focus and
                     hands it to the toggle -->
                <control type="group" id="600">
                    <width>1240</width>
                    <height>157</height>
                    <control type="image">
                        <width>1240</width>
                        <height>1</height>
                        <texture colordiffuse="border_dim">ui/white.png</texture>
                    </control>
                    <include content="SkinSettingsHeading">
                        <param name="label" value="$LOCALIZE[480]"/>
                        <param name="top" value="1"/>
                    </include>
                    <!-- in a group the rows have no grouplist neighbours: their own ways back.
                         Kodi keeps the colour scheme under Interface, the script picks it -->
                    <control type="button" id="602">
                        <top>53</top>
                        <width>1240</width>
                        <include>SettingsRowLook</include>
                        <label>$LOCALIZE[14078]</label>
                        <label2>$VAR[ColourSchemeLabel]</label2>
                        <onclick>NotifyAll(nightcity,colours)</onclick>
                        <onup>521</onup>
                        <ondown>601</ondown>
                        <onleft>9005</onleft>
                        <onright>noop</onright>
                    </control>
                    <control type="radiobutton" id="601">
                        <top>105</top>
                        <width>1240</width>
                        <include>SettingsToggleLook</include>
                        <label>$LOCALIZE[31007]</label>
                        <selected>!Skin.HasSetting(GlowOff)</selected>
                        <onclick>Skin.ToggleSetting(GlowOff)</onclick>
                        <onup>602</onup>
                        <ondown>noop</ondown>
                        <onleft>9005</onleft>
                        <onright>noop</onright>
                    </control>
                </control>
            </include>
            <!-- the ratings line of heroes and info pages (Includes_Info.xml RatingsLine): only
                 TMDb Helper's ratings, on by default (the skin bool stores off); the spotlight's
                 ratings fetched without focus, off by default (scripts/nightcity.py hero_tick);
                 then one toggle per source in the line's order. IMDb and Rotten Tomatoes critics
                 are on by default (nc.ratings.hide.*), the others off (nc.ratings.show.*). -->
            <include content="SkinSettingsArea">
                <param name="id" value="800"/>
                <param name="tab" value="ratings"/>
                <param name="category" value="9007"/>
                <include content="SkinSettingsToggle">
                    <param name="id" value="621"/>
                    <param name="label" value="$LOCALIZE[31441]"/>
                    <param name="setting" value="nc.ratings.library"/>
                </include>
                <include content="SkinSettingsToggleOptIn">
                    <param name="id" value="622"/>
                    <param name="label" value="$LOCALIZE[31443]"/>
                    <param name="setting" value="nc.ratings.spotlight"/>
                </include>
                <!-- a group under a separator and a heading, like the look of the main menu -->
                <control type="group" id="630">
                    <width>1240</width>
                    <height>469</height>
                    <control type="image">
                        <width>1240</width>
                        <height>1</height>
                        <texture colordiffuse="border_dim">ui/white.png</texture>
                    </control>
                    <include content="SkinSettingsHeading">
                        <param name="label" value="$LOCALIZE[31446]"/>
                        <param name="top" value="1"/>
                    </include>
                    <control type="radiobutton" id="631">
                        <top>53</top>
                        <width>1240</width>
                        <include>SettingsToggleLook</include>
                        <label>$LOCALIZE[31450]</label>
                        <selected>!Skin.HasSetting(nc.ratings.hide.imdb)</selected>
                        <onclick>Skin.ToggleSetting(nc.ratings.hide.imdb)</onclick>
                        <onup>622</onup>
                        <ondown>632</ondown>
                        <onleft>9007</onleft>
                        <onright>noop</onright>
                    </control>
                    <control type="radiobutton" id="632">
                        <top>105</top>
                        <width>1240</width>
                        <include>SettingsToggleLook</include>
                        <label>$LOCALIZE[31451]</label>
                        <selected>Skin.HasSetting(nc.ratings.show.tmdb)</selected>
                        <onclick>Skin.ToggleSetting(nc.ratings.show.tmdb)</onclick>
                        <onup>631</onup>
                        <ondown>633</ondown>
                        <onleft>9007</onleft>
                        <onright>noop</onright>
                    </control>
                    <control type="radiobutton" id="633">
                        <top>157</top>
                        <width>1240</width>
                        <include>SettingsToggleLook</include>
                        <label>$LOCALIZE[31452]</label>
                        <selected>!Skin.HasSetting(nc.ratings.hide.rt)</selected>
                        <onclick>Skin.ToggleSetting(nc.ratings.hide.rt)</onclick>
                        <onup>632</onup>
                        <ondown>634</ondown>
                        <onleft>9007</onleft>
                        <onright>noop</onright>
                    </control>
                    <control type="radiobutton" id="634">
                        <top>209</top>
                        <width>1240</width>
                        <include>SettingsToggleLook</include>
                        <label>$LOCALIZE[31453]</label>
                        <selected>Skin.HasSetting(nc.ratings.show.rtu)</selected>
                        <onclick>Skin.ToggleSetting(nc.ratings.show.rtu)</onclick>
                        <onup>633</onup>
                        <ondown>635</ondown>
                        <onleft>9007</onleft>
                        <onright>noop</onright>
                    </control>
                    <control type="radiobutton" id="635">
                        <top>261</top>
                        <width>1240</width>
                        <include>SettingsToggleLook</include>
                        <label>$LOCALIZE[31454]</label>
                        <selected>Skin.HasSetting(nc.ratings.show.mc)</selected>
                        <onclick>Skin.ToggleSetting(nc.ratings.show.mc)</onclick>
                        <onup>634</onup>
                        <ondown>636</ondown>
                        <onleft>9007</onleft>
                        <onright>noop</onright>
                    </control>
                    <control type="radiobutton" id="636">
                        <top>313</top>
                        <width>1240</width>
                        <include>SettingsToggleLook</include>
                        <label>$LOCALIZE[31455]</label>
                        <selected>Skin.HasSetting(nc.ratings.show.trakt)</selected>
                        <onclick>Skin.ToggleSetting(nc.ratings.show.trakt)</onclick>
                        <onup>635</onup>
                        <ondown>637</ondown>
                        <onleft>9007</onleft>
                        <onright>noop</onright>
                    </control>
                    <control type="radiobutton" id="637">
                        <top>365</top>
                        <width>1240</width>
                        <include>SettingsToggleLook</include>
                        <label>$LOCALIZE[31456]</label>
                        <selected>Skin.HasSetting(nc.ratings.show.lb)</selected>
                        <onclick>Skin.ToggleSetting(nc.ratings.show.lb)</onclick>
                        <onup>636</onup>
                        <ondown>638</ondown>
                        <onleft>9007</onleft>
                        <onright>noop</onright>
                    </control>
                    <control type="radiobutton" id="638">
                        <top>417</top>
                        <width>1240</width>
                        <include>SettingsToggleLook</include>
                        <label>$LOCALIZE[31457]</label>
                        <selected>Skin.HasSetting(nc.ratings.show.mdb)</selected>
                        <onclick>Skin.ToggleSetting(nc.ratings.show.mdb)</onclick>
                        <onup>637</onup>
                        <ondown>noop</ondown>
                        <onleft>9007</onleft>
                        <onright>noop</onright>
                    </control>
                </control>
            </include>
            <!-- the player: its controls hide by themselves after the delay of the slider below,
                 3 to 30 s (Timers.xml nc_osd_hide); the plot under the title. Both on by default,
                 the skin bools store off. -->
            <include content="SkinSettingsArea">
                <param name="id" value="700"/>
                <param name="tab" value="player"/>
                <param name="category" value="9006"/>
                <include content="SkinSettingsToggle">
                    <param name="id" value="711"/>
                    <param name="label" value="$LOCALIZE[31360]"/>
                    <param name="setting" value="nc.osd.autohide.off"/>
                </include>
                <!-- the delay as Kodi's settings slider (template 13): OK takes the slider (nib
                     light, nc.hp.slide), left and right move it a second (script osd_hide), OK or
                     leaving the row lets go. Taken, left stays on the row (712): Kodi moves to the
                     first id whose condition holds, after the actions. A group, so the slider bar
                     can sit on the row. -->
                <control type="group" id="720">
                    <width>1240</width>
                    <height>52</height>
                    <visible>!Skin.HasSetting(nc.osd.autohide.off)</visible>
                    <control type="button" id="712">
                        <width>1240</width>
                        <include>SettingsRowLook</include>
                        <label>$LOCALIZE[31362]</label>
                        <onclick condition="String.IsEmpty(Window.Property(nc.hp.slide))">SetProperty(nc.hp.slide,1)</onclick>
                        <onclick condition="!String.IsEmpty(Window.Property(nc.hp.slide))">ClearProperty(nc.hp.slide)</onclick>
                        <onleft condition="!String.IsEmpty(Window.Property(nc.hp.slide))">NotifyAll(nightcity,osd_hide:$INFO[Skin.String(nc.osd.hide.secs)]:-1)</onleft>
                        <onleft condition="!String.IsEmpty(Window.Property(nc.hp.slide))">712</onleft>
                        <onleft>9006</onleft>
                        <onright condition="!String.IsEmpty(Window.Property(nc.hp.slide))">NotifyAll(nightcity,osd_hide:$INFO[Skin.String(nc.osd.hide.secs)]:1)</onright>
                        <onright>noop</onright>
                        <onup>711</onup>
                        <ondown>713</ondown>
                        <onunfocus>ClearProperty(nc.hp.slide)</onunfocus>
                    </control>
                    <control type="label">
                        <width>896</width>
                        <height>52</height>
                        <align>right</align>
                        <aligny>center</aligny>
                        <font>font_label</font>
                        <textcolor>$VAR[OsdHideValueColor]</textcolor>
                        <label>$VAR[OsdHideDelayLabel]</label>
                    </control>
                    <!-- the bar, its nib the fill between nib from and to (Kodi's slider
                         control draws a nib of a plain texture far too large) -->
                    <control type="progress">
                        <left>920</left>
                        <top>20</top>
                        <width>300</width>
                        <height>12</height>
                        <info>Skin.Numeric(nc.osd.hide.to)</info>
                        <info2>Skin.Numeric(nc.osd.hide.from)</info2>
                        <texturebg colordiffuse="surface_alt">ui/white.png</texturebg>
                        <midtexture colordiffuse="$VAR[OsdHideNibColor]">ui/white.png</midtexture>
                    </control>
                </control>
                <!-- the plot under the title in the player (Includes_Player.xml PlayerDetails) -->
                <include content="SkinSettingsToggle">
                    <param name="id" value="713"/>
                    <param name="label" value="$LOCALIZE[31365]"/>
                    <param name="setting" value="nc.osd.plot.off"/>
                </include>
            </include>
            <!-- description of the focused entry, below it the keys of the page rows -->
            <control type="label" id="6">
                <left>560</left>
                <top>920</top>
                <width>1240</width>
                <height>120</height>
                <font>font_tiny</font>
                <textcolor>text_dim</textcolor>
                <aligny>center</aligny>
                <wrapmultiline>true</wrapmultiline>
                <label>$VAR[SkinSettingsDesc]$VAR[HomePagesHint,[CR],]</label>
            </control>
        </control>
    </controls>
</window>
