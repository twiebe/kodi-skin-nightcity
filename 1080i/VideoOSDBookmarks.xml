<?xml version="1.0" encoding="UTF-8"?>
<!-- Chapter panel during playback: OK or Up on the OSD's chapters button (608, VideoOSD.xml)
     opens it above the button row, which stays. Kodi lists the file's chapters and bookmarks in
     list 11, chapters with a thumbnail (Kodi's setting myvideos.extractchapterthumbs, switched on
     once by the startup script), and preselects the playing chapter; the bookmark buttons sit in
     the panel's head. Up from the list goes to the buttons, Down or Back closes the panel back
     onto the button; Left and Right past the ends move on to the neighbouring buttons, as in the
     track panels. Kodi ids: 11 bookmark list, 2 add, 3 clear, 4 add episode bookmark. -->
<window>
    <depth>DepthOSD</depth>
    <!-- Kodi fills list 11 right after it set the focus, so the focus goes to a stand-in: its
         focus actions wait in Kodi's queue, a second hop (93, then 94) sees the filled list and
         picks it or, without chapters or bookmarks, add bookmark. Skin timers would take up to a
         second. -->
    <defaultcontrol always="true">93</defaultcontrol>
    <animation effect="fade" time="120">WindowOpen</animation>
    <animation effect="fade" time="120">WindowClose</animation>
    <controls>
        <control type="group">
            <left>64</left>
            <top>440</top>
            <width>1792</width>
            <height>400</height>
            <include>DialogFrame</include>
        </control>
        <include content="Kicker">
            <param name="label" value="$VAR[PlayerChaptersLevel]"/>
            <param name="left" value="88"/>
            <param name="top" value="458"/>
            <param name="width" value="400"/>
        </include>
        <control type="label">
            <left>288</left>
            <top>458</top>
            <width>400</width>
            <height>34</height>
            <font>font_num</font>
            <textcolor>state_text</textcolor>
            <label>$INFO[Container(11).CurrentItem]/$INFO[Container(11).NumItems]</label>
            <visible>Integer.IsGreater(Container(11).NumItems,0)</visible>
        </control>
        <!-- the bookmark buttons in the head; Left and Right past them: the neighbouring buttons of
             the row below, closed at once so the focus lands on the OSD (SetFocus goes to the
             topmost dialog) -->
        <control type="grouplist" id="9000">
            <left>826</left>
            <top>444</top>
            <width>1020</width>
            <height>74</height>
            <orientation>horizontal</orientation>
            <align>right</align>
            <itemgap>-8</itemgap>
            <onup>noop</onup>
            <ondown condition="Integer.IsGreater(Container(11).NumItems,0)">11</ondown>
            <ondown condition="!Integer.IsGreater(Container(11).NumItems,0)">Dialog.Close(videobookmarks)</ondown>
            <onleft>Dialog.Close(videobookmarks,true)</onleft>
            <onleft>SetFocus(607)</onleft>
            <onright>Dialog.Close(videobookmarks,true)</onright>
            <onright>SetFocus(610)</onright>
            <include content="Button">
                <param name="id" value="2"/>
                <param name="label" value="$LOCALIZE[294]"/>
                <param name="width" value="auto"/>
                <param name="onclick" value="noop"/>
            </include>
            <include content="Button">
                <param name="id" value="4"/>
                <param name="label" value="$LOCALIZE[20406]"/>
                <param name="width" value="auto"/>
                <param name="onclick" value="noop"/>
                <param name="visible" value="Control.IsEnabled(4)"/>
            </include>
            <include content="Button">
                <param name="id" value="3"/>
                <param name="label" value="$LOCALIZE[296]"/>
                <param name="width" value="auto"/>
                <param name="onclick" value="noop"/>
            </include>
        </control>
        <!-- focus hops: see defaultcontrol -->
        <control type="button" id="93">
            <left>-100</left>
            <top>-100</top>
            <width>1</width>
            <height>1</height>
            <texturefocus/>
            <texturenofocus/>
            <onfocus>SetFocus(94)</onfocus>
        </control>
        <control type="button" id="94">
            <left>-100</left>
            <top>-100</top>
            <width>1</width>
            <height>1</height>
            <texturefocus/>
            <texturenofocus/>
            <onfocus condition="Integer.IsGreater(Container(11).NumItems,0)">SetFocus(11)</onfocus>
            <onfocus condition="!Integer.IsGreater(Container(11).NumItems,0)">SetFocus(2)</onfocus>
        </control>
        <!-- Left on the first card and Right on the last one: the neighbouring buttons -->
        <control type="list" id="11">
            <left>64</left>
            <top>506</top>
            <width>1792</width>
            <height>300</height>
            <orientation>horizontal</orientation>
            <scrolltime tween="quadratic">200</scrolltime>
            <preloaditems>2</preloaditems>
            <onup>9000</onup>
            <ondown>Dialog.Close(videobookmarks)</ondown>
            <onleft>Dialog.Close(videobookmarks,true)</onleft>
            <onleft>SetFocus(607)</onleft>
            <onright>Dialog.Close(videobookmarks,true)</onright>
            <onright>SetFocus(610)</onright>
            <itemlayout width="352" height="300">
                <include content="ChapterCard">
                    <param name="dim" value="Control.HasFocus(11)"/>
                </include>
            </itemlayout>
            <focusedlayout width="352" height="300">
                <include content="ChapterCard">
                    <param name="focused" value="Control.HasFocus(11)"/>
                </include>
            </focusedlayout>
        </control>
    </controls>
</window>
