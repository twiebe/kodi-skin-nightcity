<?xml version="1.0" encoding="UTF-8"?>
<!-- The music player screen: the artist's fanart behind (Kodi's visualisation over it when one
     is set), the cover, artist, title, album and year, the seek line with times and the next
     track. OK opens the OSD (MusicOSD.xml, Kodi's keymap); while it is open the block moves up
     to make room for its buttons and the queue row. -->
<window>
    <!-- music started on an album or artist page: Back goes to that page again -->
    <onunload>NotifyAll(nightcity,music_back)</onunload>
    <animation effect="fade" time="200">WindowOpen</animation>
    <animation effect="fade" time="200">WindowClose</animation>
    <controls>
        <include>Background</include>
        <include content="FanartBackdrop">
            <param name="art" value="Player.Art(fanart)"/>
        </include>
        <control type="group">
            <visible>String.IsEmpty(Player.Art(fanart))</visible>
            <include content="FanartBackdrop">
                <param name="art" value="Player.Art(artist.fanart)"/>
            </include>
        </control>
        <control type="visualisation" id="2">
            <left>0</left>
            <top>0</top>
            <width>1920</width>
            <height>1080</height>
            <visible>Visualisation.Enabled</visible>
        </control>
        <control type="image">
            <left>0</left>
            <top>440</top>
            <width>1920</width>
            <height>640</height>
            <texture colordiffuse="scrim">ui/fade_b.png</texture>
        </control>
        <include content="PathLine">
            <param name="id" value="9026"/>
            <param name="path" value="$LOCALIZE[31405] [COLOR state_text]·[/COLOR] $LOCALIZE[31406]"/>
            <param name="left" value="64"/>
            <param name="top" value="30"/>
            <param name="width" value="1792"/>
        </include>

        <!-- what plays; drawn for the open OSD, moved down while it is closed -->
        <control type="group" id="9100">
            <left>64</left>
            <top>130</top>
            <animation effect="slide" end="0,240" time="200" tween="quadratic" condition="!Window.IsActive(musicosd)">Conditional</animation>
            <include content="CutCard">
                <param name="width" value="280"/>
                <param name="height" value="280"/>
                <param name="mask" value="ui/mask_280x280.png"/>
                <param name="glowheight" value="328"/>
                <param name="glowwidth" value="328"/>
                <param name="image" value="$INFO[Player.Art(thumb)]"/>
            </include>
            <include content="Kicker">
                <param name="id" value="9027"/>
                <param name="label" value="$INFO[MusicPlayer.Artist]"/>
                <param name="left" value="320"/>
                <param name="top" value="0"/>
                <param name="width" value="1400"/>
            </include>
            <include content="GlitchTitle">
                <param name="id" value="9030"/>
                <param name="label" value="$INFO[MusicPlayer.Title]"/>
                <param name="left" value="320"/>
                <param name="top" value="44"/>
                <param name="width" value="1400"/>
                <param name="font" value="font_title"/>
            </include>
            <control type="label">
                <left>320</left>
                <top>160</top>
                <width>1400</width>
                <height>40</height>
                <font>font_label</font>
                <textcolor>text_dim</textcolor>
                <label>$VAR[MusicPlayerLine]</label>
            </control>
            <!-- Kodi's own ratings (TMDb Helper has none for music, so the Ratings settings do
                 not apply): the user's rating of the song, the song's, its album's. Jellyfin for
                 Kodi syncs none, the user's own rating from Kodi stays. -->
            <control type="group" id="9029">
                <left>320</left>
                <top>210</top>
                <visible>!String.IsEmpty(MusicPlayer.UserRating) | !String.IsEmpty(MusicPlayer.Rating) | !String.IsEmpty(MusicPlayer.Property(Album_Rating))</visible>
                <animation effect="fade" start="0" end="100" time="200">Visible</animation>
                <control type="grouplist">
                    <width>1400</width>
                    <height>34</height>
                    <orientation>horizontal</orientation>
                    <itemgap>24</itemgap>
                    <include content="RatingEntry">
                        <param name="label" value="[COLOR accent3]★[/COLOR]"/>
                    </include>
                    <!-- the star closer to the first rating, as in the video ratings line -->
                    <control type="group">
                        <width>-36</width>
                    </control>
                    <include content="RatingEntry">
                        <param name="label" value="[COLOR text]$INFO[MusicPlayer.UserRating][/COLOR] $LOCALIZE[38018]"/>
                        <param name="visible" value="!String.IsEmpty(MusicPlayer.UserRating)"/>
                    </include>
                    <include content="RatingEntry">
                        <param name="label" value="[COLOR text]$INFO[MusicPlayer.Rating][/COLOR]"/>
                        <param name="visible" value="!String.IsEmpty(MusicPlayer.Rating)"/>
                    </include>
                    <include content="RatingEntry">
                        <param name="label" value="[COLOR text]$INFO[MusicPlayer.Property(Album_Rating)][/COLOR] $LOCALIZE[558]"/>
                        <param name="visible" value="!String.IsEmpty(MusicPlayer.Property(Album_Rating))"/>
                    </include>
                </control>
            </control>
            <control type="label">
                <left>320</left>
                <top>256</top>
                <width>800</width>
                <height>36</height>
                <font>font_caps_small</font>
                <textcolor>text</textcolor>
                <label>[UPPERCASE]$VAR[PlayerState][/UPPERCASE]</label>
            </control>
            <control type="group">
                <top>340</top>
                <include content="PlayerBar"/>
                <control type="label">
                    <top>16</top>
                    <width>900</width>
                    <height>40</height>
                    <font>font_num</font>
                    <textcolor>text_dim</textcolor>
                    <label>[COLOR accent]$INFO[MusicPlayer.Time][/COLOR] / $INFO[MusicPlayer.Duration]</label>
                </control>
                <control type="label">
                    <left>892</left>
                    <top>16</top>
                    <width>900</width>
                    <height>40</height>
                    <align>right</align>
                    <font>font_num</font>
                    <textcolor>text_dim</textcolor>
                    <label>$INFO[MusicPlayer.PlaylistPosition]/$INFO[MusicPlayer.PlaylistLength]</label>
                </control>
            </control>
            <control type="label">
                <top>416</top>
                <width>1792</width>
                <height>40</height>
                <font>font_label</font>
                <textcolor>text_dim</textcolor>
                <label>$VAR[MusicNextLine]</label>
                <visible>!Window.IsActive(musicosd)</visible>
                <animation effect="fade" time="150">VisibleChange</animation>
            </control>
        </control>
        <!-- OK opens the OSD (Kodi's keymap) -->
        <include content="LevelHint">
            <param name="id" value="9090"/>
            <param name="key" value="⏎"/>
            <param name="label" value="$LOCALIZE[31232]"/>
            <param name="visible" value="!Window.IsActive(musicosd)"/>
        </include>
    </controls>
</window>
