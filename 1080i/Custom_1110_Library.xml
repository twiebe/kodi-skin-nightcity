<?xml version="1.0" encoding="UTF-8"?>
<!-- Full library grid ("all movies", "all shows"): every title as a poster card, sortable.
     It is a custom window, not MyVideoNav, because only here can a click on a show open the info
     page of its next episode (MyVideoNav always opens the show's folder). -->
<window type="window" id="1110">
    <defaultcontrol always="true">5000</defaultcontrol>
    <onload>ClearProperty(nc.lib.menu,home)</onload>
    <onload>NotifyAll(nightcity,lib_bar:changed)</onload>
    <!-- the layouts hold once the window is up (LibraryLayoutReady): each open draws every row anew -->
    <onload>NotifyAll(nightcity,lib_layout)</onload>
    <onunload>ClearProperty(nc.lib.layout,home)</onunload>
    <controls>
        <include>Background</include>
        <include content="FanartBackdrop">
            <param name="art" value="Container(5000).ListItem.Art(fanart)"/>
        </include>
        <include content="StatusBar">
            <param name="title" value="$VAR[LibraryTitle]"/>
            <param name="counter" value="$INFO[Container(5000).CurrentItem]/$INFO[Container(5000).NumItems]"/>
            <param name="weather" value="false"/>
        </include>
        <control type="panel" id="5000">
            <preloaditems>2</preloaditems>
            <pagecontrol>5900</pagecontrol>
            <left>40</left>
            <top>84</top>
            <width>1368</width>
            <height>996</height>
            <orientation>vertical</orientation>
            <scrolltime tween="quadratic">200</scrolltime>
            <!-- back to the button of the bar that had the focus last (nc.lib.menu), the first after opening -->
            <onright condition="!String.IsEmpty(Window(Home).Property(nc.lib.menu))">SetFocus($INFO[Window(Home).Property(nc.lib.menu)])</onright>
            <onright condition="String.IsEmpty(Window(Home).Property(nc.lib.menu))">5101</onright>
            <onup>noop</onup>
            <ondown>noop</ondown>
            <include>ClickRouting</include>
            <!-- posters or a list (nc.libview.<library>), each layout with its condition: Kodi only
                 looks again when the condition of the layout it uses changes, and only then draws
                 its items anew. It keeps them over closing the window, so nothing until the window
                 is up (scripts/nightcity.py lib_layout): then this one goes, and every item with it -->
            <itemlayout width="228" height="340" condition="!$EXP[LibraryLayoutReady]"/>
            <focusedlayout width="228" height="340" condition="!$EXP[LibraryLayoutReady]"/>
            <itemlayout width="228" height="340" condition="$EXP[LibraryLayoutReady] + !$EXP[LibraryAsList]">
                <control type="group">
                    <left>24</left>
                    <top>24</top>
                    <include content="CutCard">
                        <param name="image" value="$VAR[CardArt]"/>
                        <param name="dim" value="Control.HasFocus(5000)"/>
                        <include>CardExtras</include>
                    </include>
                </control>
            </itemlayout>
            <focusedlayout width="228" height="340" condition="$EXP[LibraryLayoutReady] + !$EXP[LibraryAsList]">
                <control type="group">
                    <left>24</left>
                    <top>24</top>
                    <include content="CutCard">
                        <param name="image" value="$VAR[CardArt]"/>
                        <param name="focused" value="Control.HasFocus(5000)"/>
                        <include>CardExtras</include>
                    </include>
                </control>
            </focusedlayout>
            <!-- a row as wide as the panel, so one column: title, year and runtime, format -->
            <itemlayout width="1368" height="60" condition="$EXP[LibraryLayoutReady] + $EXP[LibraryAsList]">
                <include content="LibraryRow">
                    <param name="color" value="text_dim"/>
                    <param name="mute" value="text_mute"/>
                    <param name="mark" value="state_text"/>
                </include>
            </itemlayout>
            <focusedlayout width="1368" height="60" condition="$EXP[LibraryLayoutReady] + $EXP[LibraryAsList]">
                <control type="image">
                    <left>14</left>
                    <top>14</top>
                    <width>1340</width>
                    <height>76</height>
                    <include>LookListFocus</include>
                    <visible>Control.HasFocus(5000)</visible>
                </control>
                <include content="LibraryRow">
                    <param name="color" value="$VAR[LibraryGridFocusColor]"/>
                    <param name="mute" value="$VAR[LibraryGridFocusColor]"/>
                    <param name="mark" value="$VAR[LibraryGridFocusColor]"/>
                    <param name="scroll" value="Control.HasFocus(5000)"/>
                </include>
            </focusedlayout>
            <content target="videos" sortby="$VAR[LibrarySortMethod]" sortorder="$VAR[LibrarySortDirection]">$VAR[LibraryPath]</content>
        </control>
        <!-- Where the grid stands, always: a faint rail, the grid's scrollbar as its mark. Right from
             the menu above makes it a cursor that names the group, a letter, a year, a month or a
             whole rating (scripts/nightcity.py LibBar moves it): Up and Down one group, evenly over
             the rail, the grid follows; OK goes to the group's first title, Left too by way of the
             menu, Back returns to the card it came from. -->
        <control type="image">
            <description>rail</description>
            <left>1898</left>
            <top>98</top>
            <width>2</width>
            <height>900</height>
            <texture colordiffuse="border_dim">ui/white.png</texture>
        </control>
        <control type="scrollbar" id="5900">
            <left>1896</left>
            <top>98</top>
            <width>6</width>
            <height>900</height>
            <orientation>vertical</orientation>
            <showonepage>false</showonepage>
            <enable>false</enable>
            <visible>!Control.HasFocus(5200)</visible>
            <texturesliderbackground/>
            <texturesliderbar colordiffuse="text_mute">ui/white.png</texturesliderbar>
            <texturesliderbarfocus colordiffuse="text_mute">ui/white.png</texturesliderbarfocus>
        </control>
        <control type="grouplist" id="5100">
            <left>1421</left>
            <top>98</top>
            <width>459</width>
            <height>284</height>
            <orientation>vertical</orientation>
            <itemgap>-4</itemgap>
            <onleft>5000</onleft>
            <onright condition="!String.IsEmpty(Window(Home).Property(nc.lib.bar))">5200</onright>
            <onup>noop</onup>
            <ondown>noop</ondown>
            <include content="PillButton">
                <param name="id" value="5101"/>
                <onfocus>SetProperty(nc.lib.menu,5101,home)</onfocus>
                <param name="onfocus" value="NotifyAll(nightcity,lib_bar:prepare)"/>
                <param name="width" value="459"/>
                <param name="label" value="$LOCALIZE[31116]: $VAR[LibrarySortLabel]"/>
            
                <!-- title, year, added, rating, title... (conditions are all checked before any runs) -->
                <onclick condition="String.IsEmpty(Skin.String(nc.sort)) | String.IsEqual(Skin.String(nc.sort),sorttitle)">Skin.SetString(nc.sort,year)</onclick>
                <onclick condition="String.IsEqual(Skin.String(nc.sort),year)">Skin.SetString(nc.sort,dateadded)</onclick>
                <onclick condition="String.IsEqual(Skin.String(nc.sort),dateadded)">Skin.SetString(nc.sort,rating)</onclick>
                <onclick condition="String.IsEqual(Skin.String(nc.sort),rating)">Skin.SetString(nc.sort,sorttitle)</onclick>
                <onclick>NotifyAll(nightcity,lib_bar:changed)</onclick>
            </include>
            <include content="PillButton">
                <param name="id" value="5102"/>
                <onfocus>SetProperty(nc.lib.menu,5102,home)</onfocus>
                <param name="width" value="459"/>
                <param name="label" value="$VAR[LibraryDirectionLabel]"/>
                <param name="onclick" value="Skin.ToggleSetting(nc.sortdesc)"/>
                <param name="onfocus" value="NotifyAll(nightcity,lib_bar:prepare)"/>
                <onclick>NotifyAll(nightcity,lib_bar:changed)</onclick>
            </include>
            <!-- posters or list, for the shown library: a toggle, OK flips it -->
            <include content="PillButton">
                <param name="id" value="5103"/>
                <onfocus>SetProperty(nc.lib.menu,5103,home)</onfocus>
                <param name="width" value="459"/>
                <param name="label" value="$LOCALIZE[31500]: $VAR[LibraryViewLabel]"/>
                <param name="onfocus" value="NotifyAll(nightcity,lib_bar:prepare)"/>
                <onclick condition="String.IsEqual(Window(Home).Property(nc.library),tvshows) + $EXP[LibraryAsList]">Skin.Reset(nc.libview.tvshows)</onclick>
                <onclick condition="String.IsEqual(Window(Home).Property(nc.library),tvshows) + !$EXP[LibraryAsList]">Skin.SetString(nc.libview.tvshows,list)</onclick>
                <onclick condition="!String.IsEqual(Window(Home).Property(nc.library),tvshows) + $EXP[LibraryAsList]">Skin.Reset(nc.libview.movies)</onclick>
                <onclick condition="!String.IsEqual(Window(Home).Property(nc.library),tvshows) + !$EXP[LibraryAsList]">Skin.SetString(nc.libview.movies,list)</onclick>
                <onclick>NotifyAll(nightcity,lib_bar:changed)</onclick>
            </include>
            <!-- by resolution, dynamic range, audio and studio (scripts/nightcity.py lib_filter): the
                 dialog builds the grid's path, the header names the choice -->
            <include content="PillButton">
                <param name="id" value="5104"/>
                <onfocus>SetProperty(nc.lib.menu,5104,home)</onfocus>
                <param name="width" value="459"/>
                <param name="label" value="$LOCALIZE[31502]: $VAR[LibraryFilterLabel]"/>
                <param name="onfocus" value="NotifyAll(nightcity,lib_bar:prepare)"/>
                <param name="onclick" value="NotifyAll(nightcity,lib_filter)"/>
            </include>
        </control>
        <!-- the focused title, large on the right; a text cannot change its width, so two of it:
             the column comes in only as far as the cursor needs, while it has the focus -->
        <control type="group">
            <description>title wide</description>
            <visible>!Control.HasFocus(5200)</visible>
            <include content="LibraryTitle">
                <param name="width" value="439"/>
            </include>
        </control>
        <control type="group">
            <description>title narrow</description>
            <visible>Control.HasFocus(5200)</visible>
            <include content="LibraryTitle">
                <param name="width" value="360"/>
            </include>
        </control>
        <include content="PillButton">
            <param name="id" value="5200"/>
            <param name="width" value="60"/>
            <param name="textoffsetx" value="10"/>
            <param name="label" value="$INFO[Window(Home).Property(nc.lib.label)]"/>
            <param name="visible" value="!String.IsEmpty(Window(Home).Property(nc.lib.bar))"/>
            <!-- nothing shows without the focus: it lies on the rail, waiting. Alpha 0, not colour 0: that
                 is "no colour" to Kodi, which then draws the texture white -->
            <param name="color" value="00FFFFFF"/>
            <param name="rest" value="00FFFFFF"/>
            <param name="textcolor" value="00FFFFFF"/>
            <param name="onclick" value="NotifyAll(nightcity,lib_bar:ok)"/>
            <param name="onfocus" value="NotifyAll(nightcity,lib_bar:enter)"/>
            <onup>NotifyAll(nightcity,lib_bar:step:-1)</onup>
            <ondown>NotifyAll(nightcity,lib_bar:step:1)</ondown>
            <onleft>5100</onleft>
            <onright>noop</onright>
            <!-- the control keeps the window open: without one Kodi takes Back as unhandled -->
            <onunfocus>NotifyAll(nightcity,lib_bar:leave)</onunfocus>
            <onback>NotifyAll(nightcity,lib_bar:cancel)</onback>
            <onback>5000</onback>
        </include>
    </controls>
</window>
