<?xml version="1.0" encoding="UTF-8"?>
<!-- Video versions and extras manager (Kodi 21). Kodi fills the title (2) and the asset list (50). -->
<window>
    <depth>DepthDialog+</depth>
    <defaultcontrol always="true">50</defaultcontrol>
    <controls>
        <control type="group">
            <centerleft>50%</centerleft>
            <centertop>50%</centertop>
            <width>1400</width>
            <height>720</height>
            <include>DialogFrame</include>
            <control type="label" id="2">
                <left>40</left>
                <top>16</top>
                <width>1320</width>
                <height>48</height>
                <font>font_label</font>
                <textcolor>accent3</textcolor>
                <aligny>center</aligny>
            </control>
            <control type="list" id="50">
                <left>40</left>
                <top>84</top>
                <width>960</width>
                <height>560</height>
                <onright>9000</onright>
                <scrolltime>200</scrolltime>
                <itemlayout width="960" height="56">
                    <control type="label">
                        <left>20</left>
                        <width>920</width>
                        <height>56</height>
                        <aligny>center</aligny>
                        <font>font_label</font>
                        <textcolor>text_dim</textcolor>
                        <selectedcolor>text_dim</selectedcolor>
                        <label>$INFO[ListItem.Label]$INFO[ListItem.Label2,  [COLOR text_mute],[/COLOR]]</label>
                    </control>
                </itemlayout>
                <focusedlayout width="960" height="56">
                    <control type="image">
                        <width>960</width>
                        <height>56</height>
                        <texture border="12" colordiffuse="focus">ui/cut_btn_fill.png</texture>
                        <visible>Control.HasFocus(50)</visible>
                    </control>
                    <control type="label">
                        <left>20</left>
                        <width>920</width>
                        <height>56</height>
                        <aligny>center</aligny>
                        <font>font_label</font>
                        <textcolor>text</textcolor>
                        <selectedcolor>text</selectedcolor>
                        <focusedcolor>focus_text</focusedcolor>
                        <label>$INFO[ListItem.Label]$INFO[ListItem.Label2,  ,]</label>
                    </control>
                </focusedlayout>
            </control>
            <control type="label">
                <left>40</left>
                <top>652</top>
                <width>960</width>
                <height>40</height>
                <font>font_tiny</font>
                <textcolor>text_mute</textcolor>
                <label>$INFO[Container(50).ListItem.FileNameAndPath]</label>
            </control>
            <control type="grouplist" id="9000">
                <left>1040</left>
                <top>84</top>
                <width>320</width>
                <height>600</height>
                <itemgap>12</itemgap>
                <onleft>50</onleft>
                <include content="Button">
                    <param name="id" value="21"/>
                    <param name="label" value="$LOCALIZE[208]"/>
                    <param name="width" value="320"/>
                </include>
                <include content="Button">
                    <param name="id" value="22"/>
                    <param name="label" value="$LOCALIZE[40014]"/>
                    <param name="width" value="320"/>
                    <param name="visible" value="Window.IsVisible(managevideoversions)"/>
                </include>
                <include content="Button">
                    <param name="id" value="23"/>
                    <param name="label" value="$LOCALIZE[40015]"/>
                    <param name="width" value="320"/>
                    <param name="visible" value="Window.IsVisible(managevideoextras)"/>
                </include>
                <include content="Button">
                    <param name="id" value="27"/>
                    <param name="label" value="$LOCALIZE[13511]"/>
                    <param name="width" value="320"/>
                </include>
                <include content="Button">
                    <param name="id" value="24"/>
                    <param name="label" value="$LOCALIZE[40004]"/>
                    <param name="width" value="320"/>
                    <param name="visible" value="Window.IsVisible(managevideoversions)"/>
                </include>
                <include content="Button">
                    <param name="id" value="28"/>
                    <param name="label" value="$LOCALIZE[118]"/>
                    <param name="width" value="320"/>
                    <param name="visible" value="Window.IsVisible(managevideoextras)"/>
                </include>
                <include content="Button">
                    <param name="id" value="26"/>
                    <param name="label" value="$LOCALIZE[15015]"/>
                    <param name="width" value="320"/>
                </include>
                <include content="Button">
                    <param name="id" value="25"/>
                    <param name="label" value="$LOCALIZE[40023]"/>
                    <param name="width" value="320"/>
                    <param name="visible" value="Window.IsVisible(managevideoversions)"/>
                </include>
            </control>
        </control>
    </controls>
</window>
