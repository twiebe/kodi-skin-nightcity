<?xml version="1.0" encoding="UTF-8"?>
<!-- Video calibration (Settings > System > Display). Kodi drives the window by id
     (GUIWindowSettingsScreenCalibration.cpp): it puts the movers where the calibration stands,
     moves them with the arrows and goes on to the next with OK: the top left and bottom right
     corners of the picture (8, 9), the subtitle position (10), the pixel ratio (11, square when
     right) and reset (12). It writes the resolution, the help and the value into 2, 3 and 4.
     The textures come from tools/make_textures.py. -->
<window>
    <defaultcontrol>8</defaultcontrol>
    <controls>
        <include>Background</include>
        <control type="mover" id="8">
            <description>top left corner</description>
            <left>0</left>
            <top>0</top>
            <width>128</width>
            <height>128</height>
            <texturefocus colordiffuse="focus">ui/cal_tl.png</texturefocus>
            <texturenofocus colordiffuse="text_mute">ui/cal_tl.png</texturenofocus>
            <movingspeed acceleration="180" maxvelocity="300" resettimeout="200" delta="1">
                <eventconfig type="up"/>
                <eventconfig type="down"/>
                <eventconfig type="left"/>
                <eventconfig type="right"/>
            </movingspeed>
        </control>
        <control type="mover" id="9">
            <description>bottom right corner</description>
            <left>1792</left>
            <top>952</top>
            <width>128</width>
            <height>128</height>
            <texturefocus colordiffuse="focus">ui/cal_br.png</texturefocus>
            <texturenofocus colordiffuse="text_mute">ui/cal_br.png</texturenofocus>
            <movingspeed acceleration="180" maxvelocity="300" resettimeout="200" delta="1">
                <eventconfig type="up"/>
                <eventconfig type="down"/>
                <eventconfig type="left"/>
                <eventconfig type="right"/>
            </movingspeed>
        </control>
        <control type="resize" id="11">
            <description>pixel ratio: square when right</description>
            <left>710</left>
            <top>290</top>
            <width>500</width>
            <height>500</height>
            <texturefocus colordiffuse="focus">ui/cal_ratio.png</texturefocus>
            <texturenofocus colordiffuse="text_mute">ui/cal_ratio.png</texturenofocus>
            <movingspeed acceleration="140" maxvelocity="300" resettimeout="180" delta="1">
                <eventconfig type="left"/>
                <eventconfig type="right"/>
            </movingspeed>
        </control>
        <control type="mover" id="10">
            <description>subtitle position (the bar has 40 px clear above and below)</description>
            <left>770</left>
            <top>900</top>
            <width>380</width>
            <height>90</height>
            <texturefocus colordiffuse="focus">ui/cal_sub.png</texturefocus>
            <texturenofocus colordiffuse="text_mute">ui/cal_sub.png</texturenofocus>
            <movingspeed acceleration="180" maxvelocity="300" resettimeout="200" delta="1">
                <eventconfig type="up"/>
                <eventconfig type="down"/>
            </movingspeed>
        </control>
        <control type="mover" id="12">
            <description>reset the calibration</description>
            <left>910</left>
            <top>820</top>
            <width>100</width>
            <height>100</height>
            <texturefocus colordiffuse="focus">ui/cal_reset.png</texturefocus>
            <texturenofocus colordiffuse="text_mute">ui/cal_reset.png</texturenofocus>
        </control>
        <control type="label">
            <description>title</description>
            <left>0</left>
            <top>96</top>
            <width>1920</width>
            <height>40</height>
            <align>center</align>
            <font>font_caps</font>
            <textcolor>text_dim</textcolor>
            <label>[UPPERCASE]$LOCALIZE[214][/UPPERCASE]</label>
        </control>
        <control type="label" id="2">
            <description>resolution</description>
            <left>0</left>
            <top>140</top>
            <width>1920</width>
            <height>36</height>
            <align>center</align>
            <font>font_num</font>
            <textcolor>state_text</textcolor>
        </control>
        <control type="label" id="3">
            <description>what the focused control sets, and how</description>
            <left>360</left>
            <top>186</top>
            <width>1200</width>
            <height>40</height>
            <align>center</align>
            <font>font_body</font>
            <textcolor>text</textcolor>
        </control>
        <control type="label" id="4">
            <description>its value</description>
            <left>0</left>
            <top>830</top>
            <width>1920</width>
            <height>40</height>
            <align>center</align>
            <font>font_num</font>
            <textcolor>text_dim</textcolor>
        </control>
    </controls>
</window>
