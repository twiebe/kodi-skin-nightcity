<?xml version="1.0" encoding="UTF-8"?>
<!-- Text viewer (changelogs, add-on text, the plot of an info page). Kodi ids: 1 heading, 5 text.
     A leaf: OK, Left and Right close it, Up closes it on the first page (Up at the top goes back)
     and pages up on a later one, Down pages down. A scrollbar handles no OK, so an invisible
     button takes the keys and pages the scrollbar. -->
<window>
    <depth>DepthDialog</depth>
    <defaultcontrol always="true">61</defaultcontrol>
    <controls>
        <control type="group">
            <centerleft>50%</centerleft>
            <centertop>50%</centertop>
            <width>1400</width>
            <height>860</height>
            <include>DialogFrame</include>
            <include content="DialogHeading">
                <param name="id" value="1"/>
                <param name="width" value="1320"/>
            </include>
            <control type="textbox" id="5">
                <left>40</left>
                <top>84</top>
                <width>1290</width>
                <height>740</height>
                <font>font_small</font>
                <textcolor>text</textcolor>
                <pagecontrol>60</pagecontrol>
            </control>
            <!-- over the text: a click on it closes too -->
            <control type="button" id="61">
                <left>40</left>
                <top>84</top>
                <width>1290</width>
                <height>740</height>
                <texturefocus/>
                <texturenofocus/>
                <onclick>Action(Back)</onclick>
                <onup condition="Container(5).HasPrevious">PageUp(60)</onup>
                <onup condition="!Container(5).HasPrevious">Action(Back)</onup>
                <ondown>PageDown(60)</ondown>
                <onleft>Action(Back)</onleft>
                <onright>Action(Back)</onright>
            </control>
            <control type="scrollbar" id="60">
                <left>1350</left>
                <top>84</top>
                <width>10</width>
                <height>740</height>
                <orientation>vertical</orientation>
                <showonepage>false</showonepage>
                <texturesliderbackground colordiffuse="surface_alt">ui/white.png</texturesliderbackground>
                <texturesliderbar colordiffuse="accent">ui/white.png</texturesliderbar>
                <texturesliderbarfocus colordiffuse="focus">ui/white.png</texturesliderbarfocus>
                <!-- the mouse can focus it; Up and Down page, Up at the top falls through to onup -->
                <onup>Action(Back)</onup>
                <onleft>Action(Back)</onleft>
                <onright>Action(Back)</onright>
            </control>
        </control>
    </controls>
</window>
