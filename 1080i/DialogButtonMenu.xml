<?xml version="1.0" encoding="UTF-8"?>
<!-- Kodi's power menu (shutdownmenu: the S key, power and sleep keys, Home held through the
     skin's keymap) leads to the quick menu (Custom_1170_QuickMenu.xml), or closes it when it is
     open: the same key opens and closes it. Like Arctic Fuse 3. -->
<window type="dialog">
    <onload>Close</onload>
    <onload condition="!Window.IsActive(1170)">ActivateWindow(1170)</onload>
    <onload condition="Window.IsActive(1170)">Dialog.Close(1170)</onload>
    <controls/>
</window>
