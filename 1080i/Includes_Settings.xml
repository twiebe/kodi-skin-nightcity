    <!-- Skin settings (SkinSettings.xml), laid out like Kodi's settings pages -->
    <!-- A category on the left: focused it shows its rows on the right (nc.hp.tab) -->
    <include name="SkinSettingsCategory">
        <param name="id"/>
        <param name="tab"/>
        <param name="label"/>
        <definition>
            <control type="togglebutton" id="$PARAM[id]">
                <include>SettingsCategoryLook</include>
                <label>$PARAM[label]</label>
                <usealttexture>String.IsEqual(Window.Property(nc.hp.tab),$PARAM[tab])</usealttexture>
                <onfocus>SetProperty(nc.hp.tab,$PARAM[tab])</onfocus>
            </control>
        </definition>
    </include>

    <!-- The rows of a category on the right; left goes back to its category -->
    <include name="SkinSettingsArea">
        <param name="id"/>
        <param name="tab"/>
        <param name="category"/>
        <param name="height" default="800"/>
        <param name="down" default="noop"/>
        <definition>
            <control type="grouplist" id="$PARAM[id]">
                <left>560</left>
                <top>100</top>
                <width>1240</width>
                <height>$PARAM[height]</height>
                <orientation>vertical</orientation>
                <itemgap>0</itemgap>
                <onup>noop</onup>
                <ondown>$PARAM[down]</ondown>
                <onleft>$PARAM[category]</onleft>
                <onright>noop</onright>
                <visible>String.IsEqual(Window.Property(nc.hp.tab),$PARAM[tab])</visible>
                <nested/>
            </control>
        </definition>
    </include>

    <!-- Group heading in the rows, as Kodi's (settings template 14) -->
    <include name="SkinSettingsHeading">
        <param name="label"/>
        <param name="top" default="0"/>
        <definition>
            <control type="label">
                <top>$PARAM[top]</top>
                <width>1240</width>
                <height>52</height>
                <textoffsetx>20</textoffsetx>
                <aligny>center</aligny>
                <font>font_caps_small</font>
                <textcolor>state_text</textcolor>
                <label>$PARAM[label]</label>
            </control>
        </definition>
    </include>

    <!-- Top of the slot rows of a page category: a separator line, then the rows heading -->
    <include name="HomePagesRowsHeading">
        <control type="image">
            <width>1240</width>
            <height>1</height>
            <texture colordiffuse="border_dim">ui/white.png</texture>
        </control>
        <include content="SkinSettingsHeading">
            <param name="label" value="$LOCALIZE[31224]"/>
            <param name="top" value="1"/>
        </include>
    </include>

    <!-- A setting row: label left, value right, the focused row a cut fill (dark blue while grabbed) -->
    <include name="HomePagesRow">
        <width>1240</width>
        <height>52</height>
        <font>font_label</font>
        <textoffsetx>20</textoffsetx>
        <aligny>center</aligny>
        <textcolor>text</textcolor>
        <focusedcolor>focus_text</focusedcolor>
        <disabledcolor>text_mute</disabledcolor>
        <texturefocus border="12" colordiffuse="$VAR[HomePagesFocusColor]">ui/cut_btn_fill.png</texturefocus>
        <texturenofocus/>
    </include>

    <!-- A check box row: on while the skin setting is not set (e.g. GlowOff, nc.menu.hide.x) -->
    <include name="SkinSettingsToggle">
        <param name="id"/>
        <param name="label"/>
        <param name="setting"/>
        <param name="onclick" default="noop"/>
        <definition>
            <control type="radiobutton" id="$PARAM[id]">
                <width>1240</width>
                <include>SettingsToggleLook</include>
                <label>$PARAM[label]</label>
                <selected>!Skin.HasSetting($PARAM[setting])</selected>
                <onclick>Skin.ToggleSetting($PARAM[setting])</onclick>
                <onclick>$PARAM[onclick]</onclick>
            </control>
        </definition>
    </include>
    <!-- The same for a setting off by default: the skin bool stores on -->
    <include name="SkinSettingsToggleOptIn">
        <param name="id"/>
        <param name="label"/>
        <param name="setting"/>
        <definition>
            <control type="radiobutton" id="$PARAM[id]">
                <width>1240</width>
                <include>SettingsToggleLook</include>
                <label>$PARAM[label]</label>
                <selected>Skin.HasSetting($PARAM[setting])</selected>
                <onclick>Skin.ToggleSetting($PARAM[setting])</onclick>
            </control>
        </definition>
    </include>
</includes>
