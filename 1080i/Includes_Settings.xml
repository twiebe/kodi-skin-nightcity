<?xml version="1.0" encoding="UTF-8"?>
<!-- Settings console (Settings.xml): a rail of all entries under five group headings on the left,
     the focused entry on the right with its description and, where Kodi has them, its categories
     as deep links. One include per group for the rail and one for its previews, so the rail can
     also show a single group. -->
<includes>
    <!-- Group heading in the rail: pink number, caps label. Inside the grouplist it keeps an id:
         Kodi moves over it by id, id 0 stops the move. -->
    <include name="SettingsRailHeading">
        <param name="id"/>
        <param name="num"/>
        <param name="label"/>
        <definition>
            <control type="label" id="$PARAM[id]">
                <width>520</width>
                <height>60</height>
                <textoffsetx>20</textoffsetx>
                <aligny>center</aligny>
                <font>font_caps_small</font>
                <textcolor>text_mute</textcolor>
                <label>[COLOR accent2]$PARAM[num][/COLOR]  [UPPERCASE]$PARAM[label][/UPPERCASE]</label>
            </control>
        </definition>
    </include>

    <!-- Right half for one rail entry, shown while the entry or its list has the focus: group as
         kicker, the entry as glitch title, a description, then the list (nested) under a heading.
         An entry without a list passes its own id as list and no heading. -->
    <include name="SettingsPreview">
        <param name="rail"/>
        <param name="list"/>
        <param name="num"/>
        <param name="group"/>
        <param name="title"/>
        <param name="desc"/>
        <param name="heading" default=""/>
        <definition>
            <control type="group">
                <left>700</left>
                <top>104</top>
                <visible>Control.HasFocus($PARAM[rail]) | Control.HasFocus($PARAM[list])</visible>
                <include content="Kicker">
                    <param name="label" value="$PARAM[num]  $PARAM[group]"/>
                    <param name="width" value="1150"/>
                </include>
                <include content="GlitchTitle">
                    <param name="label" value="$PARAM[title]"/>
                    <param name="top" value="36"/>
                    <param name="width" value="1150"/>
                </include>
                <control type="textbox">
                    <top>142</top>
                    <width>1100</width>
                    <height>120</height>
                    <font>font_body</font>
                    <textcolor>text_dim</textcolor>
                    <label>$PARAM[desc]</label>
                </control>
                <include content="RowHeader">
                    <param name="label" value="$PARAM[heading]"/>
                    <param name="top" value="262"/>
                </include>
                <nested/>
            </control>
        </definition>
    </include>

