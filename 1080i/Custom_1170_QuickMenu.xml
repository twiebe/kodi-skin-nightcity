<?xml version="1.0" encoding="UTF-8"?>
<!-- Quick menu as a dialog: a small panel that slides in at the top right over any window but
     Home alone (an info page, a TMDb chain, the video). Clock and date, the weather, the power
     commands and links to the settings page (the only way there) and the file manager. Kodi's
     power menu leads here (DialogButtonMenu.xml, nc_quick_key in Timers.xml: the S key, power
     and sleep keys, Home held through the skin's keymap); on Home with nothing over it the
     same keys show the same menu as Home's panel (QuickMenuPanel). Back or the same key again
     closes it, Up from the top too (onto the icon next to the clock when Home is behind).
     No script at all: two Python interpreters starting at once can crash Kodi. Power tiles run
     their builtin where the device can do it and say so where it cannot (no "are you sure").
     Ids: 1210 weather, 1220 power tiles, 1230 links (static items: more links are one item
     more). -->
<window type="dialog" id="1170">
    <depth>DepthDialog</depth>
    <defaultcontrol always="true">1220</defaultcontrol>
    <!-- Kodi keeps the lists' positions while the skin is loaded: open on power off -->
    <onload>SetFocus(1230,0,absolute)</onload>
    <onload>SetFocus(1220,0,absolute)</onload>
    <controls>
        <!-- the screen below dims a little -->
        <control type="image">
            <width>1920</width>
            <height>1080</height>
            <texture colordiffuse="bg">ui/white.png</texture>
            <animation effect="fade" start="0" end="55" time="200">WindowOpen</animation>
            <animation effect="fade" start="55" end="0" time="160">WindowClose</animation>
        </control>
        <control type="group" id="1200">
            <left>1232</left>
            <top>96</top>
            <width>640</width>
            <height>788</height>
            <animation effect="slide" start="40,-30" end="0,0" time="220" tween="cubic" easing="out">WindowOpen</animation>
            <animation effect="fade" start="0" end="100" time="180">WindowOpen</animation>
            <animation effect="slide" start="0,0" end="40,-30" time="160" tween="cubic" easing="in">WindowClose</animation>
            <animation effect="fade" start="100" end="0" time="160">WindowClose</animation>
            <include>QuickMenuBody</include>
        </control>
    </controls>
</window>
