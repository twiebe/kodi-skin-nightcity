<?xml version="1.0" encoding="UTF-8"?>
<!-- Quick menu: a small panel that slides in at the top right over whatever is on screen (Home,
     a page, the video). Clock and date, the weather, the power commands and links to the
     settings page (the only way there) and the file manager. Kodi's power menu leads here (DialogButtonMenu.xml: the S key,
     power and sleep keys, Home held through the skin's keymap), so does the icon next to the
     clock on Home (9109). Back or the same key again closes it, Up from the top too (onto
     that icon when Home is behind).
     No script at all: two Python interpreters starting at once can crash Kodi. Power tiles run
     their builtin where the device can do it and say so where it cannot (no "are you sure").
     Ids: 1210 weather, 1220 power tiles, 1230 links (static items: more links are one item
     more). -->
<window type="dialog" id="1170">
    <depth>DepthDialog</depth>
    <defaultcontrol always="true">1220</defaultcontrol>
    <!-- Kodi keeps the lists' positions while the skin is loaded: open on power off -->
    <onload>SetFocus(1230,0,absolute)</onload>
    <onload>SetFocus(1220,0,absolute)</onload>
    <controls>
        <!-- the screen below dims a little -->
        <control type="image">
            <width>1920</width>
            <height>1080</height>
            <texture colordiffuse="bg">ui/white.png</texture>
            <animation effect="fade" start="0" end="55" time="200">WindowOpen</animation>
            <animation effect="fade" start="55" end="0" time="160">WindowClose</animation>
        </control>
        <control type="group" id="1200">
            <left>1232</left>
            <top>96</top>
            <width>640</width>
            <height>788</height>
            <animation effect="slide" start="40,-30" end="0,0" time="220" tween="cubic" easing="out">WindowOpen</animation>
            <animation effect="fade" start="0" end="100" time="180">WindowOpen</animation>
            <animation effect="slide" start="0,0" end="40,-30" time="160" tween="cubic" easing="in">WindowClose</animation>
            <animation effect="fade" start="100" end="0" time="160">WindowClose</animation>
            <include>DialogFrame</include>
            <control type="label">
                <left>40</left>
                <top>34</top>
                <width>560</width>
                <height>72</height>
                <font>font_clock</font>
                <textcolor>accent2</textcolor>
                <label>$INFO[System.Time]</label>
            </control>
            <control type="label">
                <left>40</left>
                <top>106</top>
                <width>560</width>
                <height>36</height>
                <font>font_body</font>
                <textcolor>text_dim</textcolor>
                <label>$INFO[System.Date]</label>
            </control>

            <!-- weather: Kodi has it only with a weather add-on chosen in its settings -->
            <control type="button" id="1210">
                <left>40</left>
                <top>160</top>
                <width>560</width>
                <height>112</height>
                <label/>
                <texturenofocus border="16" colordiffuse="border_dim">ui/cut.png</texturenofocus>
                <texturefocus border="16" colordiffuse="focus">ui/cut_fill.png</texturefocus>
                <!-- Kodi opens no window while a modal dialog is open -->
                <onclick>Dialog.Close(1170,true)</onclick>
                <onclick condition="Weather.IsFetched">ActivateWindow(weather)</onclick>
                <onclick condition="!Weather.IsFetched">ActivateWindow(servicesettings,weather)</onclick>
                <ondown>1220</ondown>
                <!-- up leaves the menu, onto the icon next to the clock when Home is behind -->
                <onup>Dialog.Close(1170,true)</onup>
                <onup condition="Window.IsActive(home)">SetFocus(9109)</onup>
                <onleft>noop</onleft>
                <onright>noop</onright>
            </control>
            <control type="image">
                <left>64</left>
                <top>188</top>
                <width>56</width>
                <height>56</height>
                <texture colordiffuse="$VAR[QuickWeatherIcon]">ui/qm_weather.png</texture>
            </control>
            <control type="group">
                <visible>Weather.IsFetched</visible>
                <control type="label">
                    <left>140</left>
                    <top>176</top>
                    <width>150</width>
                    <height>80</height>
                    <aligny>center</aligny>
                    <font>font_clock</font>
                    <textcolor>$VAR[QuickWeatherText]</textcolor>
                    <label>$INFO[Weather.Temperature]</label>
                </control>
                <control type="label">
                    <left>296</left>
                    <top>180</top>
                    <width>284</width>
                    <height>36</height>
                    <font>font_body</font>
                    <textcolor>$VAR[QuickWeatherText]</textcolor>
                    <label>$INFO[Weather.Conditions]</label>
                </control>
                <control type="label">
                    <left>296</left>
                    <top>218</top>
                    <width>284</width>
                    <height>32</height>
                    <font>font_num_small</font>
                    <textcolor>$VAR[QuickWeatherSub]</textcolor>
                    <label>$INFO[Weather.Location]</label>
                </control>
            </control>
            <control type="label">
                <left>140</left>
                <top>160</top>
                <width>440</width>
                <height>112</height>
                <aligny>center</aligny>
                <font>font_caps</font>
                <textcolor>$VAR[QuickWeatherText]</textcolor>
                <label>[UPPERCASE]$LOCALIZE[31321][/UPPERCASE]</label>
                <visible>!Weather.IsFetched</visible>
            </control>

            <include content="RowHeader">
                <param name="label" value="$LOCALIZE[31089]"/>
                <param name="left" value="40"/>
                <param name="top" value="296"/>
                <param name="width" value="560"/>
            </include>
            <!-- no visible conditions: Kodi clicks a static list by position. Tiles the device
                 cannot do are dimmed (property can empty). -->
            <control type="panel" id="1220">
                <left>40</left>
                <top>336</top>
                <width>576</width>
                <height>292</height>
                <orientation>vertical</orientation>
                <onup>1210</onup>
                <ondown>1230</ondown>
                <onleft>noop</onleft>
                <onright>noop</onright>
                <itemlayout width="192" height="146">
                    <include content="QuickTile">
                        <param name="list" value="1220"/>
                        <param name="focused" value="false"/>
                    </include>
                </itemlayout>
                <focusedlayout width="192" height="146">
                    <include content="QuickTile">
                        <param name="list" value="1220"/>
                    </include>
                </focusedlayout>
                <content>
                    <item>
                        <label>$LOCALIZE[31143]</label>
                        <icon>ui/qm_power.png</icon>
                        <property name="can">$VAR[QuickCanPowerdown]</property>
                        <onclick condition="System.CanPowerDown">Powerdown</onclick>
                        <onclick condition="!System.CanPowerDown">Notification($LOCALIZE[31089],$LOCALIZE[31154])</onclick>
                    </item>
                    <item>
                        <label>$LOCALIZE[31144]</label>
                        <icon>ui/qm_reboot.png</icon>
                        <property name="can">$VAR[QuickCanReboot]</property>
                        <onclick condition="System.CanReboot">Reboot</onclick>
                        <onclick condition="!System.CanReboot">Notification($LOCALIZE[31089],$LOCALIZE[31154])</onclick>
                    </item>
                    <item>
                        <label>$LOCALIZE[31145]</label>
                        <icon>ui/qm_standby.png</icon>
                        <property name="can">$VAR[QuickCanSuspend]</property>
                        <onclick condition="System.CanSuspend">Suspend</onclick>
                        <onclick condition="!System.CanSuspend">Notification($LOCALIZE[31089],$LOCALIZE[31154])</onclick>
                    </item>
                    <item>
                        <label>$LOCALIZE[31147]</label>
                        <icon>ui/qm_restartapp.png</icon>
                        <property name="can">$VAR[QuickCanRestartApp]</property>
                        <onclick condition="System.Platform.Windows | System.Platform.Linux">RestartApp</onclick>
                        <onclick condition="![System.Platform.Windows | System.Platform.Linux]">Notification($LOCALIZE[31089],$LOCALIZE[31154])</onclick>
                    </item>
                    <item>
                        <label>$LOCALIZE[31146]</label>
                        <icon>ui/qm_quit.png</icon>
                        <property name="can">1</property>
                        <onclick>Quit</onclick>
                    </item>
                    <!-- shutdown timer: Kodi asks for the minutes; a running one shows what is
                         left and OK cancels it -->
                    <item>
                        <label>$LOCALIZE[31323]</label>
                        <label2>$INFO[System.AlarmPos]</label2>
                        <icon>ui/qm_timer.png</icon>
                        <property name="can">1</property>
                        <onclick condition="!System.HasAlarm(shutdowntimer)">AlarmClock(shutdowntimer,Shutdown())</onclick>
                        <onclick condition="System.HasAlarm(shutdowntimer)">CancelAlarm(shutdowntimer)</onclick>
                    </item>
                </content>
            </control>

            <include content="RowHeader">
                <param name="label" value="$LOCALIZE[31322]"/>
                <param name="left" value="40"/>
                <param name="top" value="640"/>
                <param name="width" value="560"/>
            </include>
            <control type="list" id="1230">
                <left>40</left>
                <top>680</top>
                <width>384</width>
                <height>76</height>
                <orientation>horizontal</orientation>
                <onup>1220</onup>
                <ondown>noop</ondown>
                <onleft>noop</onleft>
                <onright>noop</onright>
                <itemlayout width="192" height="72">
                    <include content="QuickLink">
                        <param name="focused" value="false"/>
                    </include>
                </itemlayout>
                <focusedlayout width="192" height="72">
                    <include content="QuickLink"/>
                </focusedlayout>
                <content>
                    <!-- the settings page of Home: the machine facts and Kodi's settings groups -->
                    <item>
                        <label>$LOCALIZE[5]</label>
                        <icon>ui/qm_settings.png</icon>
                        <onclick>Dialog.Close(1170,true)</onclick>
                        <onclick>SetProperty(nc.go,system,home)</onclick>
                        <onclick>ActivateWindow(1160)</onclick>
                    </item>
                    <item>
                        <!-- Files, the file manager: its own name does not fit the tile -->
                        <label>$LOCALIZE[744]</label>
                        <icon>ui/qm_files.png</icon>
                        <onclick>Dialog.Close(1170,true)</onclick>
                        <onclick>SetProperty(nc.go,files,home)</onclick>
                        <onclick>ActivateWindow(1160)</onclick>
                    </item>
                </content>
            </control>
        </control>
    </controls>
</window>
