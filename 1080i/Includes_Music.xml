<?xml version="1.0" encoding="UTF-8"?>
<!-- Music: the Music page of Home (spotlight of random albums, rows of albums, artists and
     genres), square cards and their click routing. The music windows are DialogMusicInfo.xml,
     MyMusicNav.xml, MusicVisualisation.xml and MusicOSD.xml. -->
<includes>
    <!-- A square music card: cover or photo, the title while there is no art, title and artist
         under the card -->
    <include name="MusicCard">
        <param name="focused" default="false"/>
        <param name="dim" default="false"/>
        <param name="labels" default="true"/>
        <!-- the title's colour: accent for the cursor, also while its list has no focus -->
        <param name="titlecolor" default="text_dim"/>
        <definition>
            <control type="group">
                <include content="CutCard">
                    <param name="width" value="200"/>
                    <param name="height" value="200"/>
                    <param name="mask" value="ui/mask_200x200.png"/>
                    <param name="glowheight" value="248"/>
                    <param name="image" value="$INFO[ListItem.Art(thumb)]"/>
                    <param name="focused" value="$PARAM[focused]"/>
                    <param name="dim" value="$PARAM[dim]"/>
                    <control type="textbox">
                        <left>16</left>
                        <top>16</top>
                        <width>168</width>
                        <height>168</height>
                        <font>font_label</font>
                        <textcolor>text_mute</textcolor>
                        <label>$INFO[ListItem.Label]</label>
                        <visible>String.IsEmpty(ListItem.Art(thumb))</visible>
                    </control>
                </include>
                <control type="label">
                    <top>214</top>
                    <width>200</width>
                    <height>30</height>
                    <font>font_small</font>
                    <textcolor>$PARAM[titlecolor]</textcolor>
                    <selectedcolor>$PARAM[titlecolor]</selectedcolor>
                    <label>$INFO[ListItem.Label]</label>
                    <visible>$PARAM[labels] + !String.IsEmpty(ListItem.Art(thumb))</visible>
                </control>
                <control type="label">
                    <top>244</top>
                    <width>200</width>
                    <height>28</height>
                    <font>font_tiny</font>
                    <textcolor>text_mute</textcolor>
                    <selectedcolor>text_mute</selectedcolor>
                    <label>$VAR[MusicCardLine]</label>
                    <visible>$PARAM[labels]</visible>
                </control>
            </control>
        </definition>
    </include>

    <!-- Click on a music card: albums and artists open their info page, a genre opens the
         library on it, anything else Kodi runs (a song plays) -->
    <include name="MusicClick">
        <onclick condition="String.IsEqual(ListItem.DBType,album) | String.IsEqual(ListItem.DBType,artist)">Action(Info)</onclick>
        <onclick condition="String.IsEqual(ListItem.DBType,genre)">ActivateWindow(Music,$INFO[ListItem.FolderPath],return)</onclick>
    </include>

    <!-- Click on an album card of the info page: Action(Info) would close the page, so the
         script closes it and opens the album's own -->
    <include name="MusicInfoClick">
        <onclick>NotifyAll(nightcity,music_info:$INFO[ListItem.DBType]:$INFO[ListItem.DBID])</onclick>
    </include>

    <!-- One line of list 50 on the info page: track number, title and length -->
    <include name="MusicTrackRow">
        <param name="focused" default="false"/>
        <!-- colours: plain in the item layout, the focus text colour on the focused row -->
        <param name="accent" default="state_text"/>
        <param name="text" default="text_dim"/>
        <param name="mute" default="text_mute"/>
        <definition>
            <control type="image">
                <left>24</left>
                <width>896</width>
                <height>56</height>
                <texture border="12" colordiffuse="focus">ui/cut_btn_fill.png</texture>
                <visible>$PARAM[focused]</visible>
            </control>
            <control type="label">
                <left>44</left>
                <width>80</width>
                <height>56</height>
                <aligny>center</aligny>
                <font>font_num</font>
                <textcolor>$PARAM[accent]</textcolor>
                <selectedcolor>$PARAM[accent]</selectedcolor>
                <label>$INFO[ListItem.TrackNumber]</label>
            </control>
            <control type="label">
                <left>130</left>
                <width>640</width>
                <height>56</height>
                <aligny>center</aligny>
                <font>font_label</font>
                <textcolor>$PARAM[text]</textcolor>
                <selectedcolor>$PARAM[text]</selectedcolor>
                <scroll>$PARAM[focused]</scroll>
                <label>$VAR[MusicTrackTitle]</label>
            </control>
            <control type="label">
                <left>780</left>
                <width>120</width>
                <height>56</height>
                <align>right</align>
                <aligny>center</aligny>
                <font>font_num</font>
                <textcolor>$PARAM[mute]</textcolor>
                <selectedcolor>$PARAM[mute]</selectedcolor>
                <label>$INFO[ListItem.Duration]</label>
            </control>
        </definition>
    </include>

    <!-- One row of the Music page: heading, the focused title and a counter on the right, a
         horizontal list of square cards. Hidden while empty; loader: the list whose items
         decide that (the row's own list, or an off-screen one for a row that can fill up). -->
    <include name="MusicRowBox">
        <param name="id"/>
        <param name="group"/>
        <param name="label"/>
        <param name="content"/>
        <param name="loader"/>
        <param name="up"/>
        <param name="down" default="noop"/>
        <param name="sortby" default=""/>
        <param name="sortorder" default=""/>
        <param name="limit" default="25"/>
        <!-- the include with the click actions: MusicClick on Home, MusicInfoClick on the info page -->
        <param name="click" default="MusicClick"/>
        <!-- header: NumberedRowHeader with num on the Music page -->
        <param name="header" default="RowHeader"/>
        <param name="num" default=""/>
        <definition>
            <control type="group" id="$PARAM[group]">
                <height>468</height>
                <visible>Integer.IsGreater(Container($PARAM[loader]).NumItems,0) | Container($PARAM[loader]).IsUpdating</visible>
                <include content="$PARAM[header]">
                    <param name="label" value="$PARAM[label]"/>
                    <param name="num" value="$PARAM[num]"/>
                    <param name="left" value="64"/>
                    <param name="top" value="6"/>
                </include>
                <control type="label">
                    <left>600</left>
                    <top>6</top>
                    <width>1150</width>
                    <height>34</height>
                    <align>right</align>
                    <font>font_caps_small</font>
                    <textcolor>text_dim</textcolor>
                    <selectedcolor>text_dim</selectedcolor>
                    <label>[UPPERCASE]$INFO[Container($PARAM[id]).ListItem.Label][/UPPERCASE]</label>
                    <visible>Control.HasFocus($PARAM[id])</visible>
                </control>
                <control type="label">
                    <left>64</left>
                    <top>6</top>
                    <width>1792</width>
                    <height>34</height>
                    <align>right</align>
                    <font>font_num</font>
                    <textcolor>state_text</textcolor>
                    <selectedcolor>state_text</selectedcolor>
                    <label>$INFO[Container($PARAM[id]).CurrentItem]/$INFO[Container($PARAM[id]).NumItems]</label>
                </control>
                <control type="list" id="$PARAM[id]">
                    <left>40</left>
                    <top>44</top>
                    <width>1880</width>
                    <height>424</height>
                    <orientation>horizontal</orientation>
                    <scrolltime tween="quadratic">200</scrolltime>
                    <preloaditems>2</preloaditems>
                    <onup>$PARAM[up]</onup>
                    <ondown>$PARAM[down]</ondown>
                    <include content="$PARAM[click]"/>
                    <itemlayout width="228" height="424">
                        <control type="group">
                            <left>24</left>
                            <top>34</top>
                            <include content="MusicCard">
                                <param name="dim" value="Control.HasFocus($PARAM[id])"/>
                            </include>
                        </control>
                    </itemlayout>
                    <focusedlayout width="228" height="424">
                        <control type="group">
                            <left>24</left>
                            <top>34</top>
                            <include content="MusicCard">
                                <param name="focused" value="Control.HasFocus($PARAM[id])"/>
                            </include>
                        </control>
                    </focusedlayout>
                    <content target="music" sortby="$PARAM[sortby]" sortorder="$PARAM[sortorder]" limit="$PARAM[limit]">$PARAM[content]</content>
                </control>
            </control>
        </definition>
    </include>

    <!-- The rows of the Music page, one at a time like every page -->
    <include name="MusicRows">
        <include content="MusicRowBox">
            <param name="id" value="9801"/>
            <param name="loader" value="9801"/>
            <param name="group" value="9811"/>
            <param name="header" value="NumberedRowHeader"/>
            <param name="num" value="$VAR[RowNumber_music_1]"/>
            <param name="up" value="9850"/>
            <param name="down" value="9812"/>
            <param name="label" value="$LOCALIZE[31400]"/>
            <param name="content" value="musicdb://recentlyaddedalbums/"/>
        </include>
        <!-- fills up after playback: its loader stays visible while the row is hidden -->
        <include content="MusicRowBox">
            <param name="id" value="9802"/>
            <param name="group" value="9812"/>
            <param name="header" value="NumberedRowHeader"/>
            <param name="num" value="$VAR[RowNumber_music_2]"/>
            <param name="loader" value="9822"/>
            <param name="up" value="9811"/>
            <param name="down" value="9813"/>
            <param name="label" value="$LOCALIZE[31401]"/>
            <param name="content" value="musicdb://recentlyplayedalbums/"/>
        </include>
        <include content="MusicRowBox">
            <param name="id" value="9803"/>
            <param name="loader" value="9803"/>
            <param name="group" value="9813"/>
            <param name="header" value="NumberedRowHeader"/>
            <param name="num" value="$VAR[RowNumber_music_3]"/>
            <param name="up" value="9812"/>
            <param name="down" value="9814"/>
            <param name="label" value="$LOCALIZE[31402]"/>
            <param name="content" value="special://skin/playlists/MusicRandomAlbums.xsp"/>
        </include>
        <include content="MusicRowBox">
            <param name="id" value="9804"/>
            <param name="loader" value="9804"/>
            <param name="group" value="9814"/>
            <param name="header" value="NumberedRowHeader"/>
            <param name="num" value="$VAR[RowNumber_music_4]"/>
            <param name="up" value="9813"/>
            <param name="down" value="9815"/>
            <param name="label" value="$LOCALIZE[31403]"/>
            <param name="content" value="musicdb://artists/"/>
            <param name="limit" value="50"/>
        </include>
        <include content="MusicRowBox">
            <param name="id" value="9805"/>
            <param name="loader" value="9805"/>
            <param name="group" value="9815"/>
            <param name="header" value="NumberedRowHeader"/>
            <param name="num" value="$VAR[RowNumber_music_5]"/>
            <param name="up" value="9814"/>
            <param name="label" value="$LOCALIZE[31404]"/>
            <param name="content" value="musicdb://genres/"/>
            <param name="limit" value="50"/>
        </include>
    </include>

    <!-- Off-screen loader of the recently played row (WidgetLoader for music) -->
    <include name="MusicLoaders">
        <control type="list" id="9822">
            <left>-3000</left>
            <top>0</top>
            <width>10</width>
            <height>10</height>
            <itemlayout width="1" height="1"/>
            <focusedlayout width="1" height="1"/>
            <content target="music" limit="1">musicdb://recentlyplayedalbums/</content>
        </control>
    </include>

    <!-- Hero of the Music page: the album spotlight (list 9002, random albums). Cover, text and
         buttons fade in one after the other like the other pages. -->
    <include name="MusicHero">
        <control type="group">
            <left>64</left>
            <top>116</top>
            <visible>String.IsEqual(Window(Home).Property(nc.page),music)</visible>
            <include content="PageFade"/>
            <include content="CutCard">
                <param name="width" value="280"/>
                <param name="height" value="280"/>
                <param name="mask" value="ui/mask_280x280.png"/>
                <param name="glowheight" value="328"/>
                <param name="glowwidth" value="328"/>
                <param name="image" value="$INFO[Container(9002).ListItem.Art(thumb)]"/>
                <param name="fadetime" value="400"/>
            </include>
        </control>
        <control type="group">
            <visible>String.IsEqual(Window(Home).Property(nc.page),music)</visible>
            <include content="PageFade">
                <param name="delay" value="FadeStep1"/>
            </include>
            <include content="Kicker">
                <param name="label" value="$INFO[Container(9002).ListItem.Artist]"/>
                <param name="left" value="384"/>
                <param name="top" value="116"/>
            </include>
            <include content="GlitchTitle">
                <param name="id" value="9860"/>
                <param name="label" value="$INFO[Container(9002).ListItem.Label]"/>
                <param name="left" value="384"/>
                <param name="top" value="160"/>
                <param name="width" value="1440"/>
            </include>
            <control type="grouplist">
                <left>384</left>
                <top>272</top>
                <width>1400</width>
                <height>36</height>
                <orientation>horizontal</orientation>
                <itemgap>10</itemgap>
                <include content="Tag">
                    <param name="label" value="$INFO[Container(9002).ListItem.Year]"/>
                    <param name="visible" value="!String.IsEmpty(Container(9002).ListItem.Year)"/>
                </include>
                <include content="Tag">
                    <param name="label" value="$INFO[Container(9002).ListItem.Genre]"/>
                    <param name="visible" value="!String.IsEmpty(Container(9002).ListItem.Genre)"/>
                </include>
            </control>
            <control type="textbox">
                <left>384</left>
                <top>330</top>
                <width>980</width>
                <height>116</height>
                <font>font_body</font>
                <textcolor>text_dim</textcolor>
                <label>$INFO[Container(9002).ListItem.Property(Album_Description)]</label>
            </control>
        </control>
        <!-- 9850: Now playing while music plays, play, info, the library. Left on the first
             button the album before, right on the last the next one (like the movie spotlight). -->
        <control type="grouplist" id="9850">
            <left>384</left>
            <top>490</top>
            <width>1400</width>
            <height>54</height>
            <orientation>horizontal</orientation>
            <itemgap>16</itemgap>
            <visible>String.IsEqual(Window(Home).Property(nc.page),music)</visible>
            <include content="PageFade">
                <param name="delay" value="FadeStep2"/>
            </include>
            <onup>9100</onup>
            <ondown>9810</ondown>
            <onleft>Skin.TimerStart(nc_spot_hold)</onleft>
            <onleft>Control.Move(9002,-1)</onleft>
            <onright>Skin.TimerStart(nc_spot_hold)</onright>
            <onright>Control.Move(9002,1)</onright>
            <!-- plays the album and opens the player screen; Back there comes back here -->
            <include content="PillButton">
                <param name="id" value="9852"/>
                <param name="label" value="▶ $LOCALIZE[31010]"/>
                <param name="color" value="accent"/>
                <param name="textcolor" value="accent"/>
                <param name="onclick" value="NotifyAll(nightcity,music_play:album:$INFO[Container(9002).ListItem.DBID]:1)"/>
            </include>
            <include content="PillButton">
                <param name="id" value="9853"/>
                <param name="label" value="$LOCALIZE[31011]"/>
                <param name="onclick" value="SetFocus(9002)"/>
                <param name="onclick2" value="Action(Info)"/>
            </include>
            <include content="PillButton">
                <param name="id" value="9854"/>
                <param name="label" value="$LOCALIZE[31407] »"/>
                <param name="onclick" value="ActivateWindow(Music,musicdb://albums/,return)"/>
            </include>
            <include>SpotlightMore</include>
        </control>
    </include>

    <!-- Top line of Home, while music plays: what plays, the first entry of the grouplist on
         the right (HomeTop 9190), left of the quick menu icon. It sits between the menu and the
         icon: Right from the last menu tab, Left from the icon; Left from it is the grouplist's
         own Left, the menu. OK opens the player screen; Back there comes back here. Down goes
         into the shown page like the menu. When the music stops while it has the focus,
         nc_np_gone (Timers.xml) moves the focus to the shown page's own tab. Directly in the
         grouplist (a group would need a fixed width): the grouplist sets its Left (the menu)
         and Right (the icon's group 9199). -->
    <include name="MusicNowPlaying">
        <control type="button" id="9108">
            <width max="560">auto</width>
            <height>44</height>
            <textoffsetx>14</textoffsetx>
            <aligny>center</aligny>
            <font>font_caps_small</font>
            <textcolor>text_dim</textcolor>
            <focusedcolor>focus_text</focusedcolor>
            <texturefocus border="12" colordiffuse="accent">ui/cut_btn_fill.png</texturefocus>
            <texturenofocus/>
            <label>$VAR[MusicNowPlayingLabel]</label>
            <visible>Player.HasAudio</visible>
            <!-- Right (the grouplist) goes to the icon: Back there comes back here -->
            <onunfocus>SetProperty(nc.quick.from,9108,home)</onunfocus>
            <!-- gone with the music: Kodi puts the focus on Home's default control, which may
                 belong to another page; nc_np_gone moves it on -->
            <onunfocus condition="!Player.HasAudio">SetProperty(nc.np.gone,1,home)</onunfocus>
            <onclick>ActivateWindow(visualisation)</onclick>
            <onup>noop</onup>
            <include>HomePageDown</include>
        </control>
    </include>
    <!-- A track of the music OSD's queue while it holds one album (MusicOSD.xml 701): number,
         title, the artist where it is not the album's, length. Like the episodes of a show: the
         cursor's title in the accent colour, also while the list has no focus; the focus fill
         while it has. The playing track has a progress line under it. -->
    <include name="MusicQueueRow">
        <param name="focused" default="false"/>
        <param name="number" default="state_text"/>
        <param name="title" default="text"/>
        <param name="mute" default="text_mute"/>
        <definition>
            <control type="image">
                <width>1792</width>
                <height>48</height>
                <texture border="12" colordiffuse="focus">ui/cut_btn_fill.png</texture>
                <visible>$PARAM[focused]</visible>
            </control>
            <control type="label">
                <left>20</left>
                <width>70</width>
                <height>48</height>
                <aligny>center</aligny>
                <font>font_label</font>
                <textcolor>$PARAM[number]</textcolor>
                <selectedcolor>$PARAM[number]</selectedcolor>
                <label>$INFO[ListItem.TrackNumber]</label>
            </control>
            <control type="label">
                <left>90</left>
                <width>1500</width>
                <height>48</height>
                <aligny>center</aligny>
                <font>font_label</font>
                <textcolor>$PARAM[title]</textcolor>
                <selectedcolor>$PARAM[title]</selectedcolor>
                <scroll>$PARAM[focused]</scroll>
                <label>$VAR[MusicTrackTitle]$VAR[MusicQueueArtist]</label>
            </control>
            <control type="label">
                <left>1600</left>
                <width>172</width>
                <height>48</height>
                <align>right</align>
                <aligny>center</aligny>
                <font>font_num</font>
                <textcolor>$PARAM[mute]</textcolor>
                <selectedcolor>$PARAM[mute]</selectedcolor>
                <label>$INFO[ListItem.Duration]</label>
            </control>
            <include content="ProgressLine">
                <param name="left" value="20"/>
                <param name="top" value="48"/>
                <param name="width" value="1752"/>
                <param name="info" value="Player.Progress"/>
                <param name="visible" value="ListItem.IsPlaying"/>
            </include>
        </definition>
    </include>
</includes>
