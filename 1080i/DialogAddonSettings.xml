                <top>84</top>
                <width>1080</width>
                <height>720</height>
                <itemgap>0</itemgap>
                <onleft>3</onleft>
                <ondown>9002</ondown>
            </control>
            <control type="label" id="6">
                <left>40</left>
                <top>812</top>
                <width>1520</width>
                <height>40</height>
                <font>font_tiny</font>
                <textcolor>text_dim</textcolor>
