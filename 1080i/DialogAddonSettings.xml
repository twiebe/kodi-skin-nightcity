<?xml version="1.0" encoding="UTF-8"?>
<!-- Add-on settings. Kodi ids: 2 heading, 3 categories, 5 settings, 6 description, 28 ok, 29 cancel,
     30 defaults, 7-15 templates. -->
<window>
