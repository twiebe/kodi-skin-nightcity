<?xml version="1.0" encoding="UTF-8"?>
<!-- Add-on settings. Kodi ids: 2 heading, 3 categories, 5 settings, 6 description, 28 ok, 29 cancel,
     30 defaults, 7-15 templates. -->
<window>
    <depth>DepthDialog</depth>
    <defaultcontrol always="true">5</defaultcontrol>
    <controls>
        <control type="group">
            <centerleft>50%</centerleft>
            <centertop>50%</centertop>
            <width>1600</width>
            <height>940</height>
            <include>DialogFrame</include>
            <include content="DialogHeading">
                <param name="id" value="2"/>
                <param name="width" value="1520"/>
            </include>
            <control type="grouplist" id="3">
                <left>30</left>
                <top>74</top>
                <width>420</width>
                <height>740</height>
                <itemgap>-20</itemgap>
                <onright>5</onright>
            </control>
            <control type="grouplist" id="5">
                <left>470</left>
                <top>74</top>
                <width>1100</width>
                <height>740</height>
                <itemgap>-20</itemgap>
                <onleft>3</onleft>
                <ondown>9002</ondown>
            </control>
            <control type="label" id="6">
                <left>40</left>
                <top>812</top>
                <width>1520</width>
                <height>40</height>
                <font>font_tiny</font>
                <textcolor>text_dim</textcolor>
                <aligny>center</aligny>
                <label></label>
            </control>
            <!-- left in the button row: Left from the settings goes back to the categories -->
            <include content="LevelHint">
                <param name="id" value="9059"/>
                <param name="key" value="←"/>
                <param name="label" value="$LOCALIZE[31176]"/>
                <param name="left" value="40"/>
                <param name="top" value="850"/>
                <param name="width" value="700"/>
                <param name="height" value="74"/>
                <param name="align" value="left"/>
                <param name="visible" value="ControlGroup(5).HasFocus() + Control.IsVisible(3)"/>
            </include>
            <control type="group">
                <left>200</left>
                <top>860</top>
                <control type="grouplist" id="9002">
                    <onup>5</onup>
                    <left>30</left>
                    <top>-10</top>
                    <width>1340</width>
                    <height>74</height>
                    <orientation>horizontal</orientation>
                    <itemgap>4</itemgap>
                    <align>right</align>
                    <include content="Button">
                        <param name="id" value="28"/>
                        <param name="label" value="$LOCALIZE[186]"/>
                        <param name="width" value="260"/>
                    </include>
                    <include content="Button">
                        <param name="id" value="29"/>
                        <param name="label" value="$LOCALIZE[222]"/>
                        <param name="width" value="260"/>
                    </include>
                    <include content="Button">
                        <param name="id" value="30"/>
                        <param name="label" value=""/>
                        <param name="width" value="260"/>
                    </include>
                </control>
            </control>
            <control type="group">
                <left>-4000</left>
                <include content="SettingsTemplates">
                    <param name="width" value="1100"/>
                </include>
                <include>SettingsCategoryTemplate</include>
            </control>
        </control>
    </controls>
</window>
