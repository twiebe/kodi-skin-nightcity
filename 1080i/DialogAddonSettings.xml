            <width>1600</width>
            <height>940</height>
            <include>DialogFrame</include>
            <include content="DialogHeading">
                <param name="id" value="2"/>
                <param name="width" value="1520"/>
            </include>
            <control type="grouplist" id="3">
                <left>40</left>
                <top>84</top>
                <width>400</width>
                <height>720</height>
                <itemgap>0</itemgap>
                <onright>5</onright>
            </control>
