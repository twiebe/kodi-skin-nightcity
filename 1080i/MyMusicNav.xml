<?xml version="1.0" encoding="UTF-8"?>
<!-- Music library: like the video library (MyVideoNav.xml), view 50 is a list with a detail pane,
     view 51 a wall of square cards. Kodi runs the clicks: a folder opens, a song plays, Info
     opens the album or artist page. -->
<window>
    <defaultcontrol always="true">50</defaultcontrol>
    <views>50,51</views>
    <onload>NotifyAll(nightcity,music_bar:changed)</onload>
    <controls>
        <include>Background</include>
        <include content="FanartBackdrop">
            <param name="art" value="ListItem.Art(fanart)"/>
        </include>
        <control type="group">
            <visible>String.IsEmpty(ListItem.Art(fanart))</visible>
            <include content="FanartBackdrop">
                <param name="art" value="ListItem.Art(artist.fanart)"/>
            </include>
        </control>
        <include content="StatusBar">
            <param name="title" value="$VAR[MusicNavTitle]"/>
            <param name="counter" value="$INFO[Container.CurrentItem]/$INFO[Container.NumItems]"/>
            <param name="weather" value="false"/>
        </include>
        <control type="list" id="50">
            <left>110</left>
            <top>118</top>
            <width>1260</width>
            <height>916</height>
            <viewtype label="535">list</viewtype>
            <scrolltime tween="quadratic">200</scrolltime>
            <onright>NotifyAll(nightcity,music_bar:prepare)</onright>
            <onright>9060</onright>
            <pagecontrol>5900</pagecontrol>
            <itemlayout width="1240" height="56">
                <!-- the item 10 px in: its glow reaches past it -->
                <control type="group">
                    <left>10</left>
                    <top>10</top>
                    <control type="label">
                        <left>20</left>
                        <width>40</width>
                        <height>56</height>
                        <aligny>center</aligny>
                        <font>font_label</font>
                        <textcolor>state_text</textcolor>
                        <selectedcolor>state_text</selectedcolor>
                        <label>$VAR[MusicNavMark]</label>
                    </control>
                    <control type="label">
                        <left>76</left>
                        <width>708</width>
                        <height>56</height>
                        <aligny>center</aligny>
                        <font>font_label</font>
                        <textcolor>text_dim</textcolor>
                        <selectedcolor>text_dim</selectedcolor>
                        <label>$VAR[MusicTrackTitle]</label>
                    </control>
                    <control type="label">
                        <left>800</left>
                        <width>420</width>
                        <height>56</height>
                        <align>right</align>
                        <aligny>center</aligny>
                        <font>font_small</font>
                        <textcolor>text_mute</textcolor>
                        <selectedcolor>text_mute</selectedcolor>
                        <label>$VAR[MusicNavRight]</label>
                    </control>
                </control>
            </itemlayout>
            <focusedlayout width="1240" height="56">
                <!-- the item 10 px in: its glow reaches past it -->
                <control type="group">
                    <left>10</left>
                    <top>10</top>
                    <control type="image">
                        <left>-10</left>
                        <top>-10</top>
                        <width>1260</width>
                        <height>76</height>
                        <texture border="22" colordiffuse="focus">ui/cut_btn_glow.png</texture>
                        <visible>Control.HasFocus(50)</visible>
                    </control>
                    <control type="label">
                        <left>20</left>
                        <width>40</width>
                        <height>56</height>
                        <aligny>center</aligny>
                        <font>font_label</font>
                        <textcolor>$VAR[MusicRowFocusAccent]</textcolor>
                        <selectedcolor>$VAR[MusicRowFocusAccent]</selectedcolor>
                        <label>$VAR[MusicNavMark]</label>
                    </control>
                    <control type="label">
                        <left>76</left>
                        <width>708</width>
                        <height>56</height>
                        <aligny>center</aligny>
                        <font>font_label</font>
                        <textcolor>$VAR[LibraryFocusColor]</textcolor>
                        <selectedcolor>$VAR[LibraryFocusColor]</selectedcolor>
                        <scroll>Control.HasFocus(50)</scroll>
                        <label>$VAR[MusicTrackTitle]</label>
                    </control>
                    <control type="label">
                        <left>800</left>
                        <width>420</width>
                        <height>56</height>
                        <align>right</align>
                        <aligny>center</aligny>
                        <font>font_small</font>
                        <textcolor>$VAR[LibraryFocusColor]</textcolor>
                        <selectedcolor>$VAR[LibraryFocusColor]</selectedcolor>
                        <label>$VAR[MusicNavRight]</label>
                    </control>
                </control>
            </focusedlayout>
        </control>
        <control type="panel" id="51">
            <left>40</left>
            <top>84</top>
            <width>1368</width>
            <height>996</height>
            <viewtype label="31042">icon</viewtype>
            <onright>NotifyAll(nightcity,music_bar:prepare)</onright>
            <onright>9060</onright>
            <pagecontrol>5900</pagecontrol>
            <scrolltime tween="quadratic">200</scrolltime>
            <orientation>vertical</orientation>
            <preloaditems>2</preloaditems>
            <itemlayout width="228" height="300">
                <control type="group">
                    <left>14</left>
                    <top>24</top>
                    <include content="MusicCard">
                        <param name="dim" value="Control.HasFocus(51)"/>
                    </include>
                </control>
            </itemlayout>
            <focusedlayout width="228" height="300">
                <control type="group">
                    <left>14</left>
                    <top>24</top>
                    <include content="MusicCard">
                        <param name="focused" value="Control.HasFocus(51)"/>
                    </include>
                </control>
            </focusedlayout>
        </control>
        <!-- The bar, as in Custom_1110_Library.xml: a faint rail with the view's scrollbar as its mark,
             Right from the menu makes it a cursor (scripts/nightcity.py LibBar). -->
        <control type="image">
            <description>rail</description>
            <left>1898</left>
            <top>98</top>
            <width>2</width>
            <height>900</height>
            <texture colordiffuse="border_dim">ui/white.png</texture>
        </control>
        <control type="scrollbar" id="5900">
            <left>1896</left>
            <top>98</top>
            <width>6</width>
            <height>900</height>
            <orientation>vertical</orientation>
            <showonepage>false</showonepage>
            <enable>false</enable>
            <visible>!Control.HasFocus(5200)</visible>
            <texturesliderbackground/>
            <texturesliderbar colordiffuse="text_mute">ui/white.png</texturesliderbar>
            <texturesliderbarfocus colordiffuse="text_mute">ui/white.png</texturesliderbarfocus>
        </control>
        <!-- Detail pane next to the list: cover, artist and year, description -->
        <control type="group">
            <left>1431</left>
            <top>128</top>
            <visible>Control.IsVisible(50) + !ListItem.IsParentFolder</visible>
            <include content="CutCard">
                <param name="width" value="360"/>
                <param name="height" value="360"/>
                <param name="mask" value="ui/mask_360x360.png"/>
                <param name="glowheight" value="408"/>
                <param name="glowwidth" value="408"/>
                <param name="image" value="$INFO[ListItem.Art(thumb)]"/>
            </include>
            <control type="label">
                <top>376</top>
                <width>360</width>
                <height>36</height>
                <font>font_small</font>
                <textcolor>state_text</textcolor>
                <label>$VAR[MusicNavMeta]</label>
            </control>
            <control type="textbox">
                <top>420</top>
                <width>360</width>
                <height>260</height>
                <font>font_tiny</font>
                <textcolor>text_dim</textcolor>
                <label>$INFO[ListItem.Property(Album_Description)]$INFO[ListItem.Property(Artist_Description)]</label>
            </control>
        </control>
        <!-- View and sort: Kodi ids 2 view (Kodi labels it), 3 sort by (Kodi labels it), 4 descending;
             on all albums, artists or songs the genre filter (scripts/nightcity.py music_filter) -->
        <control type="grouplist" id="9060">
            <left>1421</left>
            <top>818</top>
            <width>380</width>
            <height>248</height>
            <itemgap>-20</itemgap>
            <onleft condition="Control.IsVisible(51)">51</onleft>
            <onleft>50</onleft>
            <onright condition="!String.IsEmpty(Window(Home).Property(nc.lib.bar))">5200</onright>
            <include content="ListButton">
                <param name="id" value="2"/>
                <param name="width" value="380"/>
                <param name="onclick" value="NotifyAll(nightcity,music_bar:changed)"/>
            </include>
            <include content="ListButton">
                <param name="id" value="3"/>
                <param name="width" value="380"/>
                <param name="onclick" value="NotifyAll(nightcity,music_bar:changed)"/>
            </include>
            <control type="radiobutton" id="4">
                <width>380</width>
                <include>SettingsRowLook</include>
                <font>font_label</font>
                <label>$LOCALIZE[31096]</label>
                <onclick>NotifyAll(nightcity,music_bar:changed)</onclick>
                <radiowidth>42</radiowidth>
                <radioheight>32</radioheight>
                <textureradioonfocus colordiffuse="focus_text">ui/check_on_pad.png</textureradioonfocus>
                <textureradioonnofocus colordiffuse="state_text">ui/check_on_pad.png</textureradioonnofocus>
                <textureradiooffnofocus colordiffuse="text_mute">ui/check_off_pad.png</textureradiooffnofocus>
                <textureradioofffocus colordiffuse="focus_text">ui/check_off_pad.png</textureradioofffocus>
            </control>
            <include content="ListButton">
                <param name="id" value="9061"/>
                <param name="width" value="380"/>
                <param name="label" value="$LOCALIZE[31502]: $VAR[MusicFilterLabel]"/>
                <param name="visible" value="$EXP[MusicFilterable]"/>
                <param name="onclick" value="NotifyAll(nightcity,music_filter)"/>
            </include>
        </control>
        <include content="PillButton">
            <param name="id" value="5200"/>
            <param name="width" value="60"/>
            <param name="textoffsetx" value="10"/>
            <param name="label" value="$INFO[Window(Home).Property(nc.lib.label)]"/>
            <param name="visible" value="!String.IsEmpty(Window(Home).Property(nc.lib.bar))"/>
            <!-- alpha 0, not colour 0: that is "no colour" to Kodi, which then draws the texture white -->
            <param name="color" value="00FFFFFF"/>
            <param name="rest" value="00FFFFFF"/>
            <param name="plate" value="00FFFFFF"/>
            <param name="textcolor" value="00FFFFFF"/>
            <param name="onclick" value="NotifyAll(nightcity,music_bar:ok)"/>
            <param name="onfocus" value="NotifyAll(nightcity,music_bar:enter)"/>
            <onup>NotifyAll(nightcity,music_bar:step:-1)</onup>
            <ondown>NotifyAll(nightcity,music_bar:step:1)</ondown>
            <onleft>9060</onleft>
            <onright>noop</onright>
            <!-- the control keeps the window open: without one Kodi goes up a folder -->
            <onback>NotifyAll(nightcity,music_bar:cancel)</onback>
            <onback condition="Control.IsVisible(51)">51</onback>
            <onback>50</onback>
        </include>
    </controls>
</window>
