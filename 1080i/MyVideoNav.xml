<?xml version="1.0" encoding="UTF-8"?>
<!-- Video library: view 50 is a list with a detail pane, view 51 a poster wall. A plugin's list of
     movies or shows (JellyCon) has the rows of the library's list (LibraryRow) in view 50, with the
     details chosen for the movies or the shows. -->
<window>
    <defaultcontrol always="true">50</defaultcontrol>
    <views>50,51</views>
    <!-- the library's rows hold once the window is up, as in the library (Custom_1110_Library.xml) -->
    <onload>NotifyAll(nightcity,lib_layout)</onload>
    <onunload>ClearProperty(nc.lib.layout,home)</onunload>
    <controls>
        <include>Background</include>
        <include content="FanartBackdrop">
            <param name="art" value="ListItem.Art(fanart)"/>
        </include>
        <include content="StatusBar">
            <param name="title" value="$INFO[Container.FolderName]"/>
            <param name="counter" value="$INFO[Container.CurrentItem]/$INFO[Container.NumItems]"/>
            <param name="weather" value="false"/>
        </include>
        <!-- as wide as the library's list and at its left edge, for its rows; the plain row 70 px in -->
        <control type="list" id="50">
            <left>40</left>
            <top>118</top>
            <width>1368</width>
            <height>916</height>
            <viewtype label="535">list</viewtype>
            <scrolltime tween="quadratic">200</scrolltime>
            <onright>9060</onright>
            <itemlayout width="1368" height="60" condition="[Container.Content(movies) | Container.Content(tvshows)] + !$EXP[LibraryLayoutReady]"/>
            <focusedlayout width="1368" height="60" condition="[Container.Content(movies) | Container.Content(tvshows)] + !$EXP[LibraryLayoutReady]"/>
            <!-- the library's row, its glow at the top of the item like the plain row's -->
            <itemlayout width="1368" height="60" condition="[Container.Content(movies) | Container.Content(tvshows)] + $EXP[LibraryLayoutReady]">
                <control type="group">
                    <top>-14</top>
                    <include content="LibraryRow">
                        <param name="color" value="text_dim"/>
                        <param name="mute" value="text_mute"/>
                        <param name="mark" value="state_text"/>
                    </include>
                </control>
            </itemlayout>
            <focusedlayout width="1368" height="60" condition="[Container.Content(movies) | Container.Content(tvshows)] + $EXP[LibraryLayoutReady]">
                <control type="group">
                    <top>-14</top>
                    <control type="image">
                        <left>14</left>
                        <top>14</top>
                        <width>1340</width>
                        <height>76</height>
                        <include>LookListFocus</include>
                        <visible>Control.HasFocus(50)</visible>
                    </control>
                    <include content="LibraryRow">
                        <param name="color" value="$VAR[LibraryFocusColor]"/>
                        <param name="mute" value="$VAR[LibraryFocusColor]"/>
                        <param name="mark" value="$VAR[LibraryFocusColor]"/>
                        <param name="tag" value="$VAR[LibraryRowTag]"/>
                        <param name="tagtext" value="$VAR[LibraryRowTagText]"/>
                        <param name="scroll" value="Control.HasFocus(50)"/>
                    </include>
                </control>
            </focusedlayout>
            <itemlayout width="1310" height="56">
                <!-- the item 10 px in: its glow reaches past it -->
                <control type="group">
                    <left>80</left>
                    <top>10</top>
                    <control type="label">
                        <left>20</left>
                        <width>40</width>
                        <height>56</height>
                        <aligny>center</aligny>
                        <font>font_label</font>
                        <textcolor>state_text</textcolor>
                        <selectedcolor>state_text</selectedcolor>
                        <label>$VAR[LibraryMark]</label>
                    </control>
                    <control type="label">
                        <left>64</left>
                        <width>880</width>
                        <height>56</height>
                        <aligny>center</aligny>
                        <font>font_label</font>
                        <textcolor>text_dim</textcolor>
                        <selectedcolor>text_dim</selectedcolor>
                        <label>$INFO[ListItem.Label]</label>
                    </control>
                    <control type="label">
                        <left>960</left>
                        <width>260</width>
                        <height>56</height>
                        <align>right</align>
                        <aligny>center</aligny>
                        <font>font_small</font>
                        <textcolor>text_mute</textcolor>
                        <selectedcolor>text_mute</selectedcolor>
                        <label>$VAR[LibraryRight]</label>
                    </control>
                </control>
            </itemlayout>
            <focusedlayout width="1310" height="56">
                <!-- the item 10 px in: its glow reaches past it -->
                <control type="group">
                    <left>80</left>
                    <top>10</top>
                    <control type="image">
                        <left>-10</left>
                        <top>-10</top>
                        <width>1260</width>
                        <height>76</height>
                        <texture border="22" colordiffuse="focus">ui/cut_btn_glow.png</texture>
                        <visible>Control.HasFocus(50)</visible>
                    </control>
                    <control type="label">
                        <left>20</left>
                        <width>40</width>
                        <height>56</height>
                        <aligny>center</aligny>
                        <font>font_label</font>
                        <textcolor>$VAR[LibraryFocusColor]</textcolor>
                        <selectedcolor>$VAR[LibraryFocusColor]</selectedcolor>
                        <label>$VAR[LibraryMark]</label>
                    </control>
                    <control type="label">
                        <left>64</left>
                        <width>880</width>
                        <height>56</height>
                        <aligny>center</aligny>
                        <font>font_label</font>
                        <textcolor>$VAR[LibraryFocusColor]</textcolor>
                        <selectedcolor>$VAR[LibraryFocusColor]</selectedcolor>
                        <scroll>Control.HasFocus(50)</scroll>
                        <label>$INFO[ListItem.Label]</label>
                    </control>
                    <control type="label">
                        <left>960</left>
                        <width>260</width>
                        <height>56</height>
                        <align>right</align>
                        <aligny>center</aligny>
                        <font>font_small</font>
                        <textcolor>$VAR[LibraryFocusColor]</textcolor>
                        <selectedcolor>$VAR[LibraryFocusColor]</selectedcolor>
                        <label>$VAR[LibraryRight]</label>
                    </control>
                </control>
            </focusedlayout>
        </control>
        <!-- Detail pane next to the list -->
        <control type="group">
            <left>1440</left>
            <top>128</top>
            <visible>Control.IsVisible(50) + !ListItem.IsParentFolder</visible>
            <include content="CutCard">
                <param name="width" value="360"/>
                <param name="height" value="540"/>
                <param name="mask" value="ui/mask_360x540.png"/>
                <param name="image" value="$VAR[CardArt]"/>
            </include>
            <control type="label">
                <top>556</top>
                <width>360</width>
                <height>36</height>
                <font>font_small</font>
                <textcolor>state_text</textcolor>
                <label>$VAR[LibraryMeta]</label>
            </control>
            <control type="textbox">
                <top>600</top>
                <width>360</width>
                <height>150</height>
                <font>font_tiny</font>
                <textcolor>text_dim</textcolor>
                <label>$INFO[ListItem.Plot]</label>
            </control>
        </control>
        <control type="panel" id="51">
            <left>40</left>
            <top>84</top>
            <width>1368</width>
            <height>996</height>
            <viewtype label="31042">icon</viewtype>
            <onright>9060</onright>
            <scrolltime tween="quadratic">200</scrolltime>
            <orientation>vertical</orientation>
            <preloaditems>2</preloaditems>
            <itemlayout width="228" height="340">
                <control type="group">
                    <left>24</left>
                    <top>24</top>
                    <include content="CutCard">
                        <param name="image" value="$VAR[CardArt]"/>
                        <param name="dim" value="Control.HasFocus(51)"/>
                        <include>CardExtras</include>
                    </include>
                </control>
            </itemlayout>
            <focusedlayout width="228" height="340">
                <control type="group">
                    <left>24</left>
                    <top>24</top>
                    <include content="CutCard">
                        <param name="image" value="$VAR[CardArt]"/>
                        <param name="focused" value="Control.HasFocus(51)"/>
                        <include>CardExtras</include>
                    </include>
                </control>
            </focusedlayout>
        </control>
        <!-- View and sort: Kodi ids 2 view (Kodi labels it), 3 sort by (Kodi labels it), 4 descending;
             the details of the library's rows in a list of movies or shows. The last one at the bottom:
             "right" is the bottom in a vertical grouplist -->
        <control type="grouplist" id="9060">
            <left>1430</left>
            <top>838</top>
            <width>420</width>
            <height>228</height>
            <align>right</align>
            <itemgap>-20</itemgap>
            <onleft condition="Control.IsVisible(51)">51</onleft>
            <onleft>50</onleft>
            <include content="ListButton">
                <param name="id" value="2"/>
                <param name="width" value="420"/>
            </include>
            <include content="ListButton">
                <param name="id" value="3"/>
                <param name="width" value="420"/>
            </include>
            <control type="radiobutton" id="4">
                <width>420</width>
                <include>SettingsRowLook</include>
                <font>font_label</font>
                <label>$LOCALIZE[31096]</label>
                <radiowidth>42</radiowidth>
                <radioheight>32</radioheight>
                <textureradioonfocus colordiffuse="focus_text">ui/check_on_pad.png</textureradioonfocus>
                <textureradioonnofocus colordiffuse="state_text">ui/check_on_pad.png</textureradioonnofocus>
                <textureradiooffnofocus colordiffuse="text_mute">ui/check_off_pad.png</textureradiooffnofocus>
                <textureradioofffocus colordiffuse="focus_text">ui/check_off_pad.png</textureradioofffocus>
            </control>
            <!-- what a row shows (scripts/nightcity.py lib_details), for the library of the content -->
            <include content="ListButton">
                <param name="id" value="9061"/>
                <param name="width" value="420"/>
                <param name="label" value="$LOCALIZE[31602]: $VAR[LibraryDetailsLabel]"/>
                <param name="visible" value="Control.IsVisible(50) + [Container.Content(movies) | Container.Content(tvshows)]"/>
                <param name="onclick" value="NotifyAll(nightcity,lib_details)"/>
            </include>
        </control>
    </controls>
</window>
