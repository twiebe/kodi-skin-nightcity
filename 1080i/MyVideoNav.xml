<?xml version="1.0" encoding="UTF-8"?>
<!-- Video library: view 50 is a list with a detail pane, view 51 a poster wall. -->
<window>
    <defaultcontrol always="true">50</defaultcontrol>
    <views>50,51</views>
    <controls>
        <include>Background</include>
        <include content="FanartBackdrop">
            <param name="art" value="ListItem.Art(fanart)"/>
        </include>
        <include content="StatusBar">
            <param name="title" value="$INFO[Container.FolderName]"/>
            <param name="counter" value="$INFO[Container.CurrentItem]/$INFO[Container.NumItems]"/>
            <param name="weather" value="false"/>
        </include>
        <control type="list" id="50">
            <left>110</left>
            <top>118</top>
            <width>1260</width>
            <height>916</height>
            <viewtype label="535">list</viewtype>
            <scrolltime tween="quadratic">200</scrolltime>
            <onright>9060</onright>
            <itemlayout width="1240" height="56">
                <!-- the item 10 px in: its glow reaches past it -->
                <control type="group">
                    <left>10</left>
                    <top>10</top>
                    <control type="label">
                        <left>20</left>
                        <width>40</width>
                        <height>56</height>
                        <aligny>center</aligny>
                        <font>font_label</font>
                        <textcolor>state_text</textcolor>
                        <selectedcolor>state_text</selectedcolor>
                        <label>$VAR[LibraryMark]</label>
                    </control>
                    <control type="label">
                        <left>64</left>
                        <width>880</width>
                        <height>56</height>
                        <aligny>center</aligny>
                        <font>font_label</font>
                        <textcolor>text_dim</textcolor>
                        <selectedcolor>text_dim</selectedcolor>
                        <label>$INFO[ListItem.Label]</label>
                    </control>
                    <control type="label">
                        <left>960</left>
                        <width>260</width>
                        <height>56</height>
                        <align>right</align>
                        <aligny>center</aligny>
                        <font>font_small</font>
                        <textcolor>text_mute</textcolor>
                        <selectedcolor>text_mute</selectedcolor>
                        <label>$VAR[LibraryRight]</label>
                    </control>
                </control>
            </itemlayout>
            <focusedlayout width="1240" height="56">
                <!-- the item 10 px in: its glow reaches past it -->
                <control type="group">
                    <left>10</left>
                    <top>10</top>
                    <control type="image">
                        <left>-10</left>
                        <top>-10</top>
                        <width>1260</width>
                        <height>76</height>
                        <texture border="22" colordiffuse="focus">ui/cut_btn_glow.png</texture>
                        <visible>Control.HasFocus(50)</visible>
                    </control>
                    <control type="label">
                        <left>20</left>
                        <width>40</width>
                        <height>56</height>
                        <aligny>center</aligny>
                        <font>font_label</font>
                        <textcolor>$VAR[LibraryFocusColor]</textcolor>
                        <selectedcolor>$VAR[LibraryFocusColor]</selectedcolor>
                        <label>$VAR[LibraryMark]</label>
                    </control>
                    <control type="label">
                        <left>64</left>
                        <width>880</width>
                        <height>56</height>
                        <aligny>center</aligny>
                        <font>font_label</font>
                        <textcolor>$VAR[LibraryFocusColor]</textcolor>
                        <selectedcolor>$VAR[LibraryFocusColor]</selectedcolor>
                        <scroll>Control.HasFocus(50)</scroll>
                        <label>$INFO[ListItem.Label]</label>
                    </control>
                    <control type="label">
                        <left>960</left>
                        <width>260</width>
                        <height>56</height>
                        <align>right</align>
                        <aligny>center</aligny>
                        <font>font_small</font>
                        <textcolor>$VAR[LibraryFocusColor]</textcolor>
                        <selectedcolor>$VAR[LibraryFocusColor]</selectedcolor>
                        <label>$VAR[LibraryRight]</label>
                    </control>
                </control>
            </focusedlayout>
        </control>
        <!-- Detail pane next to the list -->
        <control type="group">
            <left>1440</left>
            <top>128</top>
            <visible>Control.IsVisible(50) + !ListItem.IsParentFolder</visible>
            <include content="CutCard">
                <param name="width" value="360"/>
                <param name="height" value="540"/>
                <param name="mask" value="ui/mask_360x540.png"/>
                <param name="image" value="$VAR[CardArt]"/>
            </include>
            <control type="label">
                <top>556</top>
                <width>360</width>
                <height>36</height>
                <font>font_small</font>
                <textcolor>state_text</textcolor>
                <label>$VAR[LibraryMeta]</label>
            </control>
            <control type="textbox">
                <top>600</top>
                <width>360</width>
                <height>150</height>
                <font>font_tiny</font>
                <textcolor>text_dim</textcolor>
                <label>$INFO[ListItem.Plot]</label>
            </control>
        </control>
        <control type="panel" id="51">
            <left>40</left>
            <top>84</top>
            <width>1368</width>
            <height>996</height>
            <viewtype label="31042">icon</viewtype>
            <onright>9060</onright>
            <scrolltime tween="quadratic">200</scrolltime>
            <orientation>vertical</orientation>
            <preloaditems>2</preloaditems>
            <itemlayout width="228" height="340">
                <control type="group">
                    <left>24</left>
                    <top>24</top>
                    <include content="CutCard">
                        <param name="image" value="$VAR[CardArt]"/>
                        <param name="dim" value="Control.HasFocus(51)"/>
                        <include>CardExtras</include>
                    </include>
                </control>
            </itemlayout>
            <focusedlayout width="228" height="340">
                <control type="group">
                    <left>24</left>
                    <top>24</top>
                    <include content="CutCard">
                        <param name="image" value="$VAR[CardArt]"/>
                        <param name="focused" value="Control.HasFocus(51)"/>
                        <include>CardExtras</include>
                    </include>
                </control>
            </focusedlayout>
        </control>
        <!-- View and sort: Kodi ids 2 view (Kodi labels it), 3 sort by (Kodi labels it), 4 descending -->
        <control type="grouplist" id="9060">
            <left>1430</left>
            <top>870</top>
            <width>420</width>
            <height>196</height>
            <itemgap>-20</itemgap>
            <onleft condition="Control.IsVisible(51)">51</onleft>
            <onleft>50</onleft>
            <include content="ListButton">
                <param name="id" value="2"/>
                <param name="width" value="420"/>
            </include>
            <include content="ListButton">
                <param name="id" value="3"/>
                <param name="width" value="420"/>
            </include>
            <control type="radiobutton" id="4">
                <width>420</width>
                <include>SettingsRowLook</include>
                <font>font_label</font>
                <label>$LOCALIZE[31096]</label>
                <radiowidth>42</radiowidth>
                <radioheight>32</radioheight>
                <textureradioonfocus colordiffuse="focus_text">ui/check_on_pad.png</textureradioonfocus>
                <textureradioonnofocus colordiffuse="state_text">ui/check_on_pad.png</textureradioonnofocus>
                <textureradiooffnofocus colordiffuse="text_mute">ui/check_off_pad.png</textureradiooffnofocus>
                <textureradioofffocus colordiffuse="focus_text">ui/check_off_pad.png</textureradioofffocus>
            </control>
        </control>
    </controls>
</window>
