<?xml version="1.0" encoding="UTF-8"?>
<!-- Event log: list 50 with the focused event's description below, a side column like the add-on
     browser. Kodi ids (GUIWindowEventLog.cpp): 20 clear, 21 level, 22 show higher levels; Kodi
     sets the labels of 21 and 22. -->
<window>
    <defaultcontrol always="true">50</defaultcontrol>
    <views>50</views>
    <controls>
        <include>Background</include>
        <include content="StatusBar">
            <param name="title" value="$LOCALIZE[14111]"/>
        </include>
        <!-- Left from the list leaves the page -->
        <include content="LevelHint">
            <param name="id" value="9059"/>
            <param name="key" value="←"/>
            <param name="label" value="$VAR[HintWindowBack]"/>
            <param name="left" value="64"/>
            <param name="top" value="64"/>
            <param name="width" value="600"/>
            <param name="height" value="30"/>
            <param name="align" value="left"/>
            <param name="visible" value="!System.HasActiveModalDialog + Control.HasFocus(50)"/>
            <param name="animate" value="!Player.HasVideo"/>
        </include>
        <!-- Left from the column goes back to the events -->
        <include content="LevelHint">
            <param name="id" value="9058"/>
            <param name="key" value="←"/>
            <param name="label" value="$LOCALIZE[14111]"/>
            <param name="left" value="64"/>
            <param name="top" value="64"/>
            <param name="width" value="600"/>
            <param name="height" value="30"/>
            <param name="align" value="left"/>
            <param name="visible" value="!System.HasActiveModalDialog + ControlGroup(9000).HasFocus()"/>
            <param name="animate" value="!Player.HasVideo"/>
        </include>
        <!-- the content fades in on open; background and status line stay -->
        <control type="group">
            <include>WindowFade</include>
            <include content="DialogList">
                <param name="id" value="50"/>
                <onleft>Action(Back)</onleft>
                <onright>9000</onright>
                <param name="left" value="110"/>
                <param name="top" value="90"/>
                <param name="width" value="1260"/>
                <param name="height" value="800"/>
                <param name="font" value="font_label"/>
                <param name="rowwidth" value="1240"/>
                <param name="inset" value="10"/>
            </include>
            <control type="textbox">
                <left>140</left>
                <top>900</top>
                <width>1200</width>
                <height>120</height>
                <font>font_small</font>
                <textcolor>text_dim</textcolor>
                <label>$INFO[Container(50).ListItem.Property(Event.Description)]</label>
            </control>
            <control type="grouplist" id="9000">
                <left>1430</left>
                <top>90</top>
                <width>420</width>
                <height>620</height>
                <orientation>vertical</orientation>
                <itemgap>-20</itemgap>
                <onleft>50</onleft>
                <include content="ListButton">
                    <param name="id" value="21"/>
                    <param name="width" value="420"/>
                </include>
                <control type="radiobutton" id="22">
                    <width>420</width>
                    <include>SettingsRowLook</include>
                    <label>$LOCALIZE[14120]</label>
                </control>
                <include content="ListButton">
                    <param name="id" value="20"/>
                    <param name="label" value="$LOCALIZE[192]"/>
                    <param name="width" value="420"/>
                </include>
                <!-- Kodi's logging settings, as in Estuary -->
                <include content="ListButton">
                    <param name="id" value="9001"/>
                    <param name="label" value="$LOCALIZE[14092]"/>
                    <param name="width" value="420"/>
                    <param name="onclick" value="ActivateWindow(SystemSettings,logging)"/>
                </include>
            </control>
        </control>
    </controls>
</window>
