<?xml version="1.0" encoding="UTF-8"?>
<!-- Event log: list 50 with the focused event's description below, a side column like the add-on
     browser. Kodi ids (GUIWindowEventLog.cpp): 20 clear, 21 level, 22 show higher levels; Kodi
     sets the labels of 21 and 22. -->
<window>
    <defaultcontrol always="true">50</defaultcontrol>
    <views>50</views>
    <controls>
        <include>Background</include>
        <include content="StatusBar">
            <param name="title" value="$LOCALIZE[14111]"/>
        </include>
        <!-- the content fades in on open; background and status line stay -->
        <control type="group">
            <include>WindowFade</include>
            <include content="DialogList">
                <param name="id" value="50"/>
                <onleft>Action(Back)</onleft>
                <onright>9000</onright>
                <param name="left" value="120"/>
                <param name="top" value="100"/>
                <param name="width" value="1240"/>
                <param name="height" value="780"/>
                <param name="font" value="font_label"/>
            </include>
            <control type="textbox">
                <left>140</left>
                <top>900</top>
                <width>1200</width>
                <height>120</height>
                <font>font_small</font>
                <textcolor>text_dim</textcolor>
                <label>$INFO[Container(50).ListItem.Property(Event.Description)]</label>
            </control>
            <control type="grouplist" id="9000">
                <left>1440</left>
                <top>100</top>
                <width>400</width>
                <height>600</height>
                <orientation>vertical</orientation>
                <itemgap>0</itemgap>
                <onleft>50</onleft>
                <include content="ListButton">
                    <param name="id" value="21"/>
                    <param name="width" value="400"/>
                </include>
                <control type="radiobutton" id="22">
                    <width>400</width>
                    <include>SettingsRowLook</include>
                    <label>$LOCALIZE[14120]</label>
                </control>
                <include content="ListButton">
                    <param name="id" value="20"/>
                    <param name="label" value="$LOCALIZE[192]"/>
                    <param name="width" value="400"/>
                </include>
                <!-- Kodi's logging settings, as in Estuary -->
                <include content="ListButton">
                    <param name="id" value="9001"/>
                    <param name="label" value="$LOCALIZE[14092]"/>
                    <param name="width" value="400"/>
                    <param name="onclick" value="ActivateWindow(SystemSettings,logging)"/>
                </include>
            </control>
        </control>
    </controls>
</window>
