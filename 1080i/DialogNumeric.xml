<?xml version="1.0" encoding="UTF-8"?>
<!-- Numeric input. Kodi ids: 1 heading, 4 input, 10-19 digits, 20 previous, 21 done, 22 next, 23 backspace.
     The rows are grouplists: up, down and the side buttons name the key by the focused one,
     else a grouplist hands the focus to the key that had it last. -->
<window>
    <depth>DepthDialog</depth>
    <defaultcontrol always="true">9010</defaultcontrol>
    <controls>
        <control type="group">
            <centerleft>50%</centerleft>
            <centertop>50%</centertop>
            <width>700</width>
            <height>520</height>
            <include>DialogFrame</include>
            <include content="DialogHeading">
                <param name="id" value="1"/>
                <param name="width" value="620"/>
            </include>
            <control type="label" id="4">
                <left>40</left>
                <top>84</top>
                <width>620</width>
                <height>56</height>
                <font>font_title</font>
                <textcolor>accent2</textcolor>
                <aligny>center</aligny>
                <label></label>
            </control>
            <control type="grouplist" id="9010">
                <ondown condition="Control.HasFocus(11)">14</ondown>
                <ondown condition="Control.HasFocus(12)">15</ondown>
                <ondown condition="Control.HasFocus(13)">16</ondown>
                <onright>23</onright>
                <left>40</left>
                <top>160</top>
                <width>400</width>
                <height>56</height>
                <orientation>horizontal</orientation>
                <itemgap>20</itemgap>
                <include content="Button">
                    <param name="id" value="11"/>
                    <param name="label" value="1"/>
                    <param name="width" value="120"/>
                </include>
                <include content="Button">
                    <param name="id" value="12"/>
                    <param name="label" value="2"/>
                    <param name="width" value="120"/>
                </include>
                <include content="Button">
                    <param name="id" value="13"/>
                    <param name="label" value="3"/>
                    <param name="width" value="120"/>
                </include>
            </control>
            <control type="grouplist" id="9011">
                <onup condition="Control.HasFocus(14)">11</onup>
                <onup condition="Control.HasFocus(15)">12</onup>
                <onup condition="Control.HasFocus(16)">13</onup>
                <ondown condition="Control.HasFocus(14)">17</ondown>
                <ondown condition="Control.HasFocus(15)">18</ondown>
                <ondown condition="Control.HasFocus(16)">19</ondown>
                <onright>21</onright>
                <left>40</left>
                <top>228</top>
                <width>400</width>
                <height>56</height>
                <orientation>horizontal</orientation>
                <itemgap>20</itemgap>
                <include content="Button">
                    <param name="id" value="14"/>
                    <param name="label" value="4"/>
                    <param name="width" value="120"/>
                </include>
                <include content="Button">
                    <param name="id" value="15"/>
                    <param name="label" value="5"/>
                    <param name="width" value="120"/>
                </include>
                <include content="Button">
                    <param name="id" value="16"/>
                    <param name="label" value="6"/>
                    <param name="width" value="120"/>
                </include>
            </control>
            <control type="grouplist" id="9012">
                <onup condition="Control.HasFocus(17)">14</onup>
                <onup condition="Control.HasFocus(18)">15</onup>
                <onup condition="Control.HasFocus(19)">16</onup>
                <ondown condition="Control.HasFocus(17)">20</ondown>
                <ondown condition="Control.HasFocus(18)">10</ondown>
                <ondown condition="Control.HasFocus(19)">22</ondown>
                <onright>21</onright>
                <left>40</left>
                <top>296</top>
                <width>400</width>
                <height>56</height>
                <orientation>horizontal</orientation>
                <itemgap>20</itemgap>
                <include content="Button">
                    <param name="id" value="17"/>
                    <param name="label" value="7"/>
                    <param name="width" value="120"/>
                </include>
                <include content="Button">
                    <param name="id" value="18"/>
                    <param name="label" value="8"/>
                    <param name="width" value="120"/>
                </include>
                <include content="Button">
                    <param name="id" value="19"/>
                    <param name="label" value="9"/>
                    <param name="width" value="120"/>
                </include>
            </control>
            <control type="grouplist" id="9013">
                <onup condition="Control.HasFocus(20)">17</onup>
                <onup condition="Control.HasFocus(10)">18</onup>
                <onup condition="Control.HasFocus(22)">19</onup>
                <onright>21</onright>
                <left>40</left>
                <top>364</top>
                <width>400</width>
                <height>56</height>
                <orientation>horizontal</orientation>
                <itemgap>20</itemgap>
                <include content="Button">
                    <param name="id" value="20"/>
                    <param name="label" value="◄"/>
                    <param name="width" value="120"/>
                </include>
                <include content="Button">
                    <param name="id" value="10"/>
                    <param name="label" value="0"/>
                    <param name="width" value="120"/>
                </include>
                <include content="Button">
                    <param name="id" value="22"/>
                    <param name="label" value="►"/>
                    <param name="width" value="120"/>
                </include>
            </control>
            <control type="grouplist" id="9014">
                <onleft condition="Control.HasFocus(23)">13</onleft>
                <onleft condition="Control.HasFocus(21)">16</onleft>
                <onup>23</onup>
                <ondown>21</ondown>
                <left>480</left>
                <top>160</top>
                <width>180</width>
                <height>300</height>
                <orientation>vertical</orientation>
                <itemgap>20</itemgap>
                <include content="Button">
                    <param name="id" value="23"/>
                    <param name="label" value="del"/>
                    <param name="width" value="180"/>
                </include>
                <include content="Button">
                    <param name="id" value="21"/>
                    <param name="label" value="ok"/>
                    <param name="width" value="180"/>
                </include>
            </control>
        </control>
    </controls>
</window>
