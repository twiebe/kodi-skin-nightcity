<?xml version="1.0" encoding="UTF-8"?>
<!-- Building blocks of the info page (DialogVideoInfo.xml) -->
<includes>
    <!-- One line of the details column on the right: key in muted caps, value beside it.
         Inside a vertical grouplist, so missing facts leave no gap. -->
    <include name="InfoDetail">
        <param name="key"/>
        <param name="value"/>
        <definition>
            <control type="group">
                <width>456</width>
                <height>40</height>
                <visible>!String.IsEmpty($PARAM[value])</visible>
                <control type="label">
                    <width>150</width>
                    <height>40</height>
                    <font>font_caps_small</font>
                    <textcolor>text_mute</textcolor>
                    <label>[UPPERCASE]$PARAM[key][/UPPERCASE]</label>
                </control>
                <control type="label">
                    <left>150</left>
                    <width>306</width>
                    <height>40</height>
                    <font>font_small</font>
                    <textcolor>text</textcolor>
                    <label>$INFO[$PARAM[value]]</label>
                </control>
            </control>
        </definition>
    </include>

    <!-- One season in the tab line: like a menu entry, the shown season in accent with a line
         under it (DialogVideoInfo.xml, 5200) -->
    <include name="SeasonTab">
        <param name="color"/>
        <definition>
            <control type="label">
                <width>240</width>
                <height>44</height>
                <aligny>center</aligny>
                <font>font_caps</font>
                <textcolor>$PARAM[color]</textcolor>
                <label>[UPPERCASE]$VAR[SeasonTabLabel][/UPPERCASE]</label>
            </control>
        </definition>
    </include>

    <!-- Episode in the bottom list: 16:9 still with cut corners, the unwatched dog-ear from CutCard, number and title
         below (on the still the number got lost on bright pictures), a progress line for started episodes -->
    <include name="EpisodeCard">
        <param name="focused" default="false"/>
        <param name="selected" default="false"/>
        <param name="dim" default="false"/>
        <definition>
            <control type="group">
                <left>24</left>
                <top>30</top>
                <include content="CutCard">
                    <param name="width" value="320"/>
                    <param name="height" value="180"/>
                    <param name="image" value="$INFO[ListItem.Art(thumb)]"/>
                    <param name="mask" value="ui/mask_320x180.png"/>
                    <param name="glowwidth" value="368"/>
                    <param name="glowheight" value="228"/>
                    <param name="focused" value="$PARAM[focused]"/>
                    <param name="dim" value="$PARAM[dim]"/>
                </include>
                <control type="label">
                    <top>192</top>
                    <width>320</width>
                    <height>36</height>
                    <font>font_label</font>
                    <textcolor>text</textcolor>
                    <label>[COLOR accent]$VAR[EpisodeCardNum][/COLOR]  $INFO[ListItem.Title]</label>
                    <visible>!$PARAM[selected]</visible>
                </control>
                <control type="label">
                    <top>192</top>
                    <width>320</width>
                    <height>36</height>
                    <font>font_label</font>
                    <textcolor>accent</textcolor>
                    <scroll>true</scroll>
                    <label>$VAR[EpisodeCardNum]  $INFO[ListItem.Title]</label>
                    <visible>$PARAM[selected]</visible>
                </control>
                <include content="ProgressLine">
                    <param name="top" value="234"/>
                    <param name="width" value="320"/>
                    <param name="info" value="ListItem.PercentPlayed"/>
                    <param name="visible" value="Integer.IsGreater(ListItem.PercentPlayed,0)"/>
                </include>
            </control>
        </definition>
    </include>

    <!-- Actor in the cast row: photo with cut corners, name and role below -->
    <include name="CastCard">
        <param name="focused" default="false"/>
        <param name="dim" default="false"/>
        <definition>
            <control type="group">
                <left>24</left>
                <top>34</top>
                <include content="CutCard">
                    <param name="width" value="160"/>
                    <param name="height" value="220"/>
                    <param name="mask" value="ui/mask_160x220.png"/>
                    <param name="image" value="$INFO[ListItem.Art(thumb)]"/>
                    <param name="glowwidth" value="208"/>
                    <param name="glowheight" value="268"/>
                    <param name="focused" value="$PARAM[focused]"/>
                    <param name="dim" value="$PARAM[dim]"/>
                    <control type="textbox">
                        <left>14</left>
                        <top>14</top>
                        <width>132</width>
                        <height>190</height>
                        <font>font_label</font>
                        <textcolor>text_mute</textcolor>
                        <label>$INFO[ListItem.Label]</label>
                        <visible>String.IsEmpty(ListItem.Art(thumb))</visible>
                    </control>
                </include>
                <control type="label">
                    <top>232</top>
                    <width>160</width>
                    <height>32</height>
                    <font>font_small</font>
                    <textcolor>text</textcolor>
                    <label>$INFO[ListItem.Label]</label>
                </control>
                <control type="label">
                    <top>262</top>
                    <width>160</width>
                    <height>30</height>
                    <font>font_tiny</font>
                    <textcolor>text_mute</textcolor>
                    <label>$INFO[ListItem.Label2]</label>
                </control>
            </control>
        </definition>
    </include>
    <!-- "Ends at" of a movie or episode with a runtime, as a tag in a row of tags: now plus the
         time left from the resume point (EndTimeResume); for the item that is playing the
         player's own finish time, the stored resume point is stale then and a TMDb Helper item
         has none (Arctic Fuse 3, 99010ae). Pink: it is state, it moves with the clock.
         Window level only: inside an item layout Kodi reads Player.FileNameAndPath and
         VideoPlayer.* from the list item, so every item would count as playing. -->
    <include name="EndsAtTags">
        <param name="item"/>
        <definition>
            <include content="EndsAtTagPair">
                <param name="item" value="$PARAM[item]"/>
                <param name="type" value="[String.IsEqual($PARAM[item].DBType,movie) | String.IsEqual($PARAM[item].DBType,episode)]"/>
                <!-- an item with a file is playing when that file plays: another version of
                     the title can have another runtime. ListItem.FileNameAndPath drops
                     user:pass@ from the path and Player.FileNameAndPath does not, so a library
                     item also matches by DBID and file name. A TMDb Helper item (from a TMDb
                     chain, e.g. the OSD's cast row) stands for no file and matches the playing
                     title by IMDb or TMDb id, an episode by show, season and episode -->
                <param name="playing" value="Player.HasVideo + !VideoPlayer.Content(livetv) + [[!String.IsEmpty($PARAM[item].FileNameAndPath) + String.IsEqual($PARAM[item].FileNameAndPath,Player.FileNameAndPath)] | [Integer.IsGreater($PARAM[item].DBID,0) + Integer.IsEqual($PARAM[item].DBID,VideoPlayer.DBID) + [[String.IsEqual($PARAM[item].DBType,movie) + VideoPlayer.Content(movies)] | [String.IsEqual($PARAM[item].DBType,episode) + VideoPlayer.Content(episodes)]] + !String.IsEmpty($PARAM[item].FileName) + String.IsEqual($PARAM[item].FileName,Player.Filename)] | [String.StartsWith($PARAM[item].FileNameAndPath,plugin://plugin.video.themoviedb.helper/) + [[String.IsEqual($PARAM[item].DBType,movie) + VideoPlayer.Content(movies) + [[!String.IsEmpty($PARAM[item].IMDBNumber) + String.IsEqual($PARAM[item].IMDBNumber,VideoPlayer.IMDBNumber)] | [!String.IsEmpty($PARAM[item].UniqueID(tmdb)) + String.IsEqual($PARAM[item].UniqueID(tmdb),Window(Home).Property(TMDbHelper.Player.TMDb_ID))]]] | [String.IsEqual($PARAM[item].DBType,episode) + VideoPlayer.Content(episodes) + !String.IsEmpty($PARAM[item].UniqueID(tvshow.tmdb)) + String.IsEqual($PARAM[item].UniqueID(tvshow.tmdb),Window(Home).Property(TMDbHelper.Player.TVShow.TMDb_ID)) + Integer.IsEqual($PARAM[item].Season,VideoPlayer.Season) + Integer.IsEqual($PARAM[item].Episode,VideoPlayer.Episode)]]]]"/>
            </include>
        </definition>
    </include>
    <include name="EndsAtTagPair">
        <definition>
            <!-- without a runtime EndTimeResume is the current time -->
            <include content="Tag">
                <param name="label" value="$LOCALIZE[31059] $INFO[$PARAM[item].EndTimeResume]"/>
                <param name="color" value="accent2"/>
                <param name="visible" value="$PARAM[type] + !String.IsEmpty($PARAM[item].Duration) + !String.IsEmpty($PARAM[item].EndTimeResume) + ![$PARAM[playing]]"/>
            </include>
            <include content="Tag">
                <param name="label" value="$LOCALIZE[31059] $INFO[Player.FinishTime]"/>
                <param name="color" value="accent2"/>
                <param name="visible" value="$PARAM[type] + $PARAM[playing] + !String.IsEmpty(Player.FinishTime)"/>
            </include>
        </definition>
    </include>

    <!-- Every rating of a movie, show or episode in one line: the value in the text colour, the
         source muted. From TMDb Helper's service (docs/media-info-af3.md): IMDb with its Top 250
         rank, TMDb, Rotten Tomatoes critics and audience, Metacritic, Trakt, Letterboxd,
         MDbList; IMDb and TMDb else from Kodi's library; with no named rating at all the plain
         library rating as before. item = info prefix; tmdb: the condition under which TMDb
         Helper's ListItem properties describe item. All but TMDb come from a second thread of
         TMDb Helper, until it is done they can still be the ones of the title before. -->
    <include name="RatingsLine">
        <param name="id" default="0"/>
        <param name="item"/>
        <param name="tmdb"/>
        <param name="left" default="0"/>
        <param name="top" default="0"/>
        <!-- the sources that do not fit stay out, the last first -->
        <param name="width" default="1000"/>
        <!-- where the ratings are: TMDb Helper's properties, or those the service keeps for a
             hero (nc.hero.<container>.), which only holds them once all are there -->
        <param name="prefix" default="TMDbHelper.ListItem."/>
        <param name="wait" default="String.IsEmpty(Window(Home).Property(TMDbHelper.IsUpdatingRatings))"/>
        <definition>
            <include content="RatingsLineBody">
                <param name="id" value="$PARAM[id]"/>
                <param name="item" value="$PARAM[item]"/>
                <param name="left" value="$PARAM[left]"/>
                <param name="top" value="$PARAM[top]"/>
                <param name="width" value="$PARAM[width]"/>
                <param name="prefix" value="$PARAM[prefix]"/>
                <param name="tmdb" value="[$PARAM[tmdb]]"/>
                <param name="online" value="[$PARAM[tmdb]] + [$PARAM[wait]]"/>
                <param name="library" value="Skin.HasSetting(nc.ratings.library)"/>
            </include>
        </definition>
    </include>
    <!-- each source shows while its toggle is on (SkinSettings.xml 631-638), Kodi's own IMDb and
         TMDb ratings too -->
    <include name="RatingsLineBody">
        <definition>
            <include content="RatingsLineEntries">
                <param name="id" value="$PARAM[id]"/>
                <param name="item" value="$PARAM[item]"/>
                <param name="left" value="$PARAM[left]"/>
                <param name="top" value="$PARAM[top]"/>
                <param name="width" value="$PARAM[width]"/>
                <param name="prefix" value="$PARAM[prefix]"/>
                <param name="library" value="$PARAM[library]"/>
                <param name="imdb" value="$PARAM[online] + !String.IsEmpty(Window(Home).Property($PARAM[prefix]IMDb_Rating)) + !Skin.HasSetting(nc.ratings.hide.imdb)"/>
                <param name="tmdbr" value="$PARAM[tmdb] + !String.IsEmpty(Window(Home).Property($PARAM[prefix]TMDb_Rating)) + Skin.HasSetting(nc.ratings.show.tmdb)"/>
                <param name="rt" value="$PARAM[online] + !String.IsEmpty(Window(Home).Property($PARAM[prefix]RottenTomatoes_Rating)) + !Skin.HasSetting(nc.ratings.hide.rt)"/>
                <param name="rtu" value="$PARAM[online] + !String.IsEmpty(Window(Home).Property($PARAM[prefix]RottenTomatoes_UserMeter)) + Skin.HasSetting(nc.ratings.show.rtu)"/>
                <param name="mc" value="$PARAM[online] + !String.IsEmpty(Window(Home).Property($PARAM[prefix]MetaCritic_Rating)) + Skin.HasSetting(nc.ratings.show.mc)"/>
                <param name="trakt" value="$PARAM[online] + !String.IsEmpty(Window(Home).Property($PARAM[prefix]Trakt_Rating)) + Skin.HasSetting(nc.ratings.show.trakt)"/>
                <param name="lb" value="$PARAM[online] + !String.IsEmpty(Window(Home).Property($PARAM[prefix]Letterboxd_Rating)) + Skin.HasSetting(nc.ratings.show.lb)"/>
                <param name="mdb" value="$PARAM[online] + !String.IsEmpty(Window(Home).Property($PARAM[prefix]MDBList_Rating)) + Skin.HasSetting(nc.ratings.show.mdb)"/>
                <param name="own_imdb" value="![$PARAM[online] + !String.IsEmpty(Window(Home).Property($PARAM[prefix]IMDb_Rating))] + !String.IsEmpty($PARAM[item].Rating(imdb)) + $PARAM[library] + !Skin.HasSetting(nc.ratings.hide.imdb)"/>
                <param name="own_moviedb" value="![$PARAM[tmdb] + !String.IsEmpty(Window(Home).Property($PARAM[prefix]TMDb_Rating))] + !String.IsEmpty($PARAM[item].Rating(themoviedb)) + $PARAM[library] + Skin.HasSetting(nc.ratings.show.tmdb)"/>
                <param name="own_tmdb" value="![$PARAM[tmdb] + !String.IsEmpty(Window(Home).Property($PARAM[prefix]TMDb_Rating))] + String.IsEmpty($PARAM[item].Rating(themoviedb)) + !String.IsEmpty($PARAM[item].Rating(tmdb)) + $PARAM[library] + Skin.HasSetting(nc.ratings.show.tmdb)"/>
            </include>
        </definition>
    </include>
    <include name="RatingsLineEntries">
        <definition>
            <control type="group" id="$PARAM[id]">
                <left>$PARAM[left]</left>
                <top>$PARAM[top]</top>
                <visible>!String.IsEmpty($PARAM[item].Title)</visible>
                <visible>[$PARAM[imdb]] | [$PARAM[tmdbr]] | [$PARAM[rt]] | [$PARAM[rtu]] | [$PARAM[mc]] | [$PARAM[trakt]] | [$PARAM[lb]] | [$PARAM[mdb]] | [$PARAM[own_imdb]] | [$PARAM[own_moviedb]] | [$PARAM[own_tmdb]] | [!String.IsEmpty($PARAM[item].Rating) + !String.IsEqual($PARAM[item].Rating,0.0) + $PARAM[library]]</visible>
                <!-- comes in softly, goes at once: on a new title the old values would fade on it -->
                <animation effect="fade" start="0" end="100" time="200" condition="!Player.HasVideo">Visible</animation>
                <control type="grouplist">
                    <width>$PARAM[width]</width>
                    <height>34</height>
                    <orientation>horizontal</orientation>
                    <itemgap>24</itemgap>
                    <include content="RatingEntry">
                        <param name="label" value="[COLOR accent3]★[/COLOR]"/>
                    </include>
                    <!-- the star stands closer to the first rating than the ratings to each other:
                         the spacer takes back the two item gaps around it but 12 px -->
                    <control type="group">
                        <width>-36</width>
                    </control>
                    <include content="RatingEntry">
                        <param name="label" value="[COLOR text]$INFO[Window(Home).Property($PARAM[prefix]IMDb_Rating)][/COLOR] IMDb$INFO[Window(Home).Property($PARAM[prefix]Top250), #,]"/>
                        <param name="visible" value="$PARAM[imdb]"/>
                    </include>
                    <include content="RatingEntry">
                        <param name="label" value="[COLOR text]$INFO[$PARAM[item].Rating(imdb)][/COLOR] IMDb"/>
                        <param name="visible" value="$PARAM[own_imdb]"/>
                    </include>
                    <include content="RatingEntry">
                        <param name="label" value="[COLOR text]$INFO[Window(Home).Property($PARAM[prefix]TMDb_Rating)][/COLOR] TMDb"/>
                        <param name="visible" value="$PARAM[tmdbr]"/>
                    </include>
                    <include content="RatingEntry">
                        <param name="label" value="[COLOR text]$INFO[$PARAM[item].Rating(themoviedb)][/COLOR] TMDb"/>
                        <param name="visible" value="$PARAM[own_moviedb]"/>
                    </include>
                    <include content="RatingEntry">
                        <param name="label" value="[COLOR text]$INFO[$PARAM[item].Rating(tmdb)][/COLOR] TMDb"/>
                        <param name="visible" value="$PARAM[own_tmdb]"/>
                    </include>
                    <include content="RatingEntry">
                        <param name="label" value="[COLOR text]$INFO[Window(Home).Property($PARAM[prefix]RottenTomatoes_Rating),,%][/COLOR] RT"/>
                        <param name="visible" value="$PARAM[rt]"/>
                    </include>
                    <include content="RatingEntry">
                        <param name="label" value="[COLOR text]$INFO[Window(Home).Property($PARAM[prefix]RottenTomatoes_UserMeter),,%][/COLOR] RT $LOCALIZE[31440]"/>
                        <param name="visible" value="$PARAM[rtu]"/>
                    </include>
                    <include content="RatingEntry">
                        <param name="label" value="[COLOR text]$INFO[Window(Home).Property($PARAM[prefix]MetaCritic_Rating)][/COLOR] Metacritic"/>
                        <param name="visible" value="$PARAM[mc]"/>
                    </include>
                    <include content="RatingEntry">
                        <param name="label" value="[COLOR text]$INFO[Window(Home).Property($PARAM[prefix]Trakt_Rating)][/COLOR] Trakt"/>
                        <param name="visible" value="$PARAM[trakt]"/>
                    </include>
                    <include content="RatingEntry">
                        <param name="label" value="[COLOR text]$INFO[Window(Home).Property($PARAM[prefix]Letterboxd_Rating)][/COLOR] Letterboxd"/>
                        <param name="visible" value="$PARAM[lb]"/>
                    </include>
                    <include content="RatingEntry">
                        <param name="label" value="[COLOR text]$INFO[Window(Home).Property($PARAM[prefix]MDBList_Rating),,%][/COLOR] MDbList"/>
                        <param name="visible" value="$PARAM[mdb]"/>
                    </include>
                    <!-- the library's rating has no source name (Jellyfin for Kodi stores its
                         community rating so); Kodi's own ones only with "Ratings only from TMDb
                         Helper" off -->
                    <include content="RatingEntry">
                        <param name="label" value="[COLOR text]$INFO[$PARAM[item].Rating][/COLOR]"/>
                        <param name="visible" value="![$PARAM[imdb]] + ![$PARAM[tmdbr]] + ![$PARAM[rt]] + ![$PARAM[rtu]] + ![$PARAM[mc]] + ![$PARAM[trakt]] + ![$PARAM[lb]] + ![$PARAM[mdb]] + ![$PARAM[own_imdb]] + ![$PARAM[own_moviedb]] + ![$PARAM[own_tmdb]] + !String.IsEmpty($PARAM[item].Rating) + !String.IsEqual($PARAM[item].Rating,0.0) + $PARAM[library]"/>
                    </include>
                </control>
            </control>
        </definition>
    </include>
    <include name="RatingEntry">
        <param name="visible" default="true"/>
        <definition>
            <control type="label">
                <width>auto</width>
                <height>34</height>
                <font>font_caps_small</font>
                <textcolor>text_mute</textcolor>
                <label>[UPPERCASE]$PARAM[label][/UPPERCASE]</label>
                <visible>$PARAM[visible]</visible>
            </control>
        </definition>
    </include>
</includes>
