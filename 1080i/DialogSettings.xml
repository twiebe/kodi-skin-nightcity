<?xml version="1.0" encoding="UTF-8"?>
<!-- Settings dialog (OSD audio/video/subtitle settings and more). Kodi ids: 2 heading, 5 settings,
     6 description, 28 ok, 29 cancel, 30 custom, 7-15 templates. -->
<window>
    <depth>DepthDialog</depth>
    <defaultcontrol always="true">5</defaultcontrol>
    <controls>
        <control type="group">
            <centerleft>50%</centerleft>
            <centertop>50%</centertop>
            <width>1400</width>
            <height>900</height>
            <include>DialogFrame</include>
            <include content="DialogHeading">
                <param name="id" value="2"/>
                <param name="width" value="1320"/>
            </include>
            <control type="grouplist" id="5">
                <left>40</left>
                <top>84</top>
                <width>1320</width>
                <height>640</height>
                <itemgap>0</itemgap>
                <ondown>9002</ondown>
            </control>
            <control type="label" id="6">
                <left>40</left>
                <top>736</top>
                <width>1320</width>
                <height>72</height>
                <font>font_tiny</font>
                <textcolor>text_dim</textcolor>
                <aligny>center</aligny>
                <label></label>
            </control>
            <control type="group">
                <top>820</top>
                <control type="grouplist" id="9002">
                    <onup>5</onup>
                    <left>40</left>
                    <top>0</top>
                    <width>1320</width>
                    <height>54</height>
                    <orientation>horizontal</orientation>
                    <itemgap>24</itemgap>
                    <align>right</align>
                    <include content="Button">
                        <param name="id" value="28"/>
                        <param name="label" value="$LOCALIZE[186]"/>
                        <param name="width" value="240"/>
                    </include>
                    <include content="Button">
                        <param name="id" value="29"/>
                        <param name="label" value="$LOCALIZE[222]"/>
                        <param name="width" value="240"/>
                    </include>
                    <include content="Button">
                        <param name="id" value="30"/>
                        <param name="label" value=""/>
                        <param name="width" value="240"/>
                    </include>
                </control>
            </control>
            <control type="group">
                <left>-4000</left>
                <include content="SettingsTemplates">
                    <param name="width" value="1320"/>
                </include>
            </control>
        </control>
    </controls>
</window>
