<?xml version="1.0" encoding="UTF-8"?>
<!-- Startup: the first screen after boot (CoreELEC shows no Kodi splash). The NIGHTCITY wordmark
     with a glitch now and then, a ticker on a thin track and a status line, until the nc_startup
     timer (Timers.xml) hands over to Home: once the startup script set nc.startup.ready and the
     screen was up for a moment, or after a timeout. The script applies the one-off settings; the
     nc_startup_script timer starts it a second after the service add-ons, which Kodi starts
     together with this window. TMDbHelper.Service switches on TMDb Helper's poller (it idles
     without it), TMDbHelper.DirectCallAuto lets its window manager open the info pages of a
     chain itself (Custom_1190_TMDbHelper.xml), TMDbHelper.UseLocalWidgetContainer makes it read
     TMDbHelper.WidgetContainer of the window on top (DialogVideoInfo.xml names its episode list). -->
<window>
    <onload>Skin.SetBool(TMDbHelper.Service)</onload>
    <onload>Skin.SetBool(TMDbHelper.DirectCallAuto)</onload>
    <onload>Skin.SetBool(TMDbHelper.UseLocalWidgetContainer)</onload>
    <onload>ClearProperty(nc.startup.ready,home)</onload>
    <controls>
        <include>Background</include>
        <control type="group">
            <animation effect="fade" start="0" end="100" time="400" delay="100">WindowOpen</animation>
            <animation effect="fade" start="100" end="0" time="250">WindowClose</animation>
            <include content="LookStartupWordmark">
                <param name="glitch" value="$EXP[LookGlitch]"/>
            </include>
            <include content="LookStartupTrack">
                <param name="waiting" value="!$EXP[StartupOnline]"/>
                <param name="online" value="$EXP[StartupOnline]"/>
                <param name="glitch" value="$EXP[LookGlitch]"/>
                <param name="calm" value="!$EXP[LookGlitch]"/>
            </include>
        </control>
    </controls>
</window>
