                <animation effect="slide" start="0,0" end="0,104" time="0" condition="String.IsEqual(Window(Home).Property(nc.$PARAM[prefix].rows),6)">Conditional</animation>
                <animation effect="slide" start="0,0" end="0,52" time="0" condition="String.IsEqual(Window(Home).Property(nc.$PARAM[prefix].rows),7)">Conditional</animation>
                <control type="group">
                    <height>124</height>
