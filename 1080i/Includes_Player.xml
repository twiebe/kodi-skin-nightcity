    <!-- Row n of a track panel -->
    <include name="TrackItem">
        <param name="prefix"/>
        <param name="n"/>
        <definition>
            <item>
                <label>$INFO[Window(Home).Property(nc.$PARAM[prefix].$PARAM[n].label)]</label>
                <property name="tag">$INFO[Window(Home).Property(nc.$PARAM[prefix].$PARAM[n].tag)]</property>
                <property name="current">$INFO[Window(Home).Property(nc.$PARAM[prefix].$PARAM[n].current)]</property>
                <onclick>NotifyAll(nightcity,row:$PARAM[prefix]:$PARAM[n])</onclick>
                <visible>Integer.IsGreaterOrEqual(Window(Home).Property(nc.$PARAM[prefix].count),$PARAM[n])</visible>
            </item>
        </definition>
    </include>

    <!-- Video panel of the OSD, beside the track panels and in their look: what the video is
         (codec, resolution, SDR/HDR, frame rate, aspect, bitrate when Kodi knows it) and a last
         row that opens Kodi's video settings. Left and right focus the neighbouring buttons. -->
    <include name="VideoPanel">
        <param name="id"/>
        <param name="button"/>
        <param name="left"/>
        <param name="right"/>
        <definition>
            <control type="group">
                <left>1256</left>
                <top>494</top>
                <width>600</width>
                <height>436</height>
                <visible>Control.HasFocus($PARAM[button]) | Control.HasFocus($PARAM[id])</visible>
                <!-- the chapter and cast rows open over the OSD, which keeps its focus on the
                     button: they replace the controls, the panel goes with them -->
                <visible>!Window.IsActive(videobookmarks) + !Window.IsActive(1141)</visible>
                <animation effect="fade" time="120">VisibleChange</animation>
                <!-- without a bitrate one row less, the panel keeps its bottom edge -->
                <animation effect="slide" start="0,0" end="0,52" time="0" condition="String.IsEmpty(VideoPlayer.VideoBitrate)">Conditional</animation>
                <control type="group">
                    <height>436</height>
                    <visible>!String.IsEmpty(VideoPlayer.VideoBitrate)</visible>
                    <include>DialogFrame</include>
                </control>
                <control type="group">
                    <height>384</height>
                    <visible>String.IsEmpty(VideoPlayer.VideoBitrate)</visible>
                    <include>DialogFrame</include>
                </control>
                <include content="Kicker">
                    <param name="label" value="$LOCALIZE[31055]"/>
                    <param name="left" value="24"/>
                    <param name="top" value="18"/>
                    <param name="width" value="552"/>
                </include>
                <!-- a grouplist ignores the left of its rows, so it is inset by the row margin; it
                     also replaces the up and down of its rows with its own, and without an id of
                     its own it takes a builtin (navigation 0) for wrapping around: a plain id -->
                <control type="grouplist">
                    <left>12</left>
                    <top>56</top>
                    <width>576</width>
                    <height>364</height>
                    <orientation>vertical</orientation>
                    <itemgap>0</itemgap>
                    <onup>noop</onup>
                    <ondown>$PARAM[button]</ondown>
                    <include content="VideoFact">
                        <param name="key" value="$LOCALIZE[21445]"/>
                        <param name="value" value="[UPPERCASE]$INFO[VideoPlayer.VideoCodec][/UPPERCASE]"/>
                    </include>
                    <include content="VideoFact">
                        <param name="key" value="$LOCALIZE[169]"/>
                        <param name="value" value="$VAR[PlayerResolution]$INFO[Player.Process(videowidth), · ,x]$INFO[Player.Process(videoheight)]"/>
                    </include>
                    <include content="VideoFact">
                        <param name="key" value="$LOCALIZE[20474]"/>
                        <param name="value" value="$VAR[PlayerHdr]"/>
                    </include>
                    <include content="VideoFact">
                        <param name="key" value="$LOCALIZE[31230]"/>
                        <param name="value" value="$INFO[Player.Process(videofps),, fps]"/>
                    </include>
                    <include content="VideoFact">
                        <param name="key" value="$LOCALIZE[21374]"/>
                        <param name="value" value="$INFO[VideoPlayer.VideoAspect]"/>
                    </include>
                    <include content="VideoFact">
                        <param name="key" value="$LOCALIZE[623]"/>
                        <param name="value" value="$INFO[VideoPlayer.VideoBitrate,, kbit/s]"/>
                        <param name="visible" value="!String.IsEmpty(VideoPlayer.VideoBitrate)"/>
                    </include>
                    <control type="button" id="$PARAM[id]">
                        <width>576</width>
                        <height>52</height>
                        <label>… $LOCALIZE[31139]</label>
                        <font>font_small</font>
                        <textoffsetx>12</textoffsetx>
                        <aligny>center</aligny>
                        <textcolor>text_dim</textcolor>
                        <focusedcolor>focus_text</focusedcolor>
                        <texturefocus border="12" colordiffuse="focus">ui/cut_btn_fill.png</texturefocus>
                        <texturenofocus/>
                        <onclick>ActivateWindow(osdvideosettings)</onclick>
                        <onleft>SetFocus($PARAM[left])</onleft>
                        <onright>SetFocus($PARAM[right])</onright>
                    </control>
                </control>
            </control>
        </definition>
    </include>

    <!-- One fact row of the video panel: key left, value right, track row size -->
    <include name="VideoFact">
        <param name="key"/>
        <param name="value"/>
        <param name="visible" default="true"/>
        <definition>
            <control type="group">
                <width>576</width>
                <height>52</height>
                <visible>$PARAM[visible]</visible>
                <control type="label">
                    <left>12</left>
                    <width>240</width>
                    <height>52</height>
                    <aligny>center</aligny>
                    <font>font_small</font>
                    <textcolor>text_mute</textcolor>
                    <label>[LOWERCASE]$PARAM[key][/LOWERCASE]</label>
                </control>
                <control type="label">
                    <left>252</left>
                    <width>312</width>
                    <height>52</height>
                    <align>right</align>
                    <aligny>center</aligny>
                    <font>font_small</font>
                    <textcolor>text</textcolor>
                    <label>$PARAM[value]</label>
                </control>
            </control>
        </definition>
    </include>
</includes>
