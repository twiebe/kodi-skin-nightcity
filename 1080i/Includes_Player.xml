    <!-- Track panel of the OSD (subtitles or audio) above the right buttons: one row per track
         from the script's nc.<prefix>.* properties (Home), the playing one marked with a dark blue bar and accent text, "off"
         first for subtitles, and a last row that opens Kodi's full settings (`settings`). The panel grows upwards
         with the number of rows (nc.<prefix>.rows, at most 8). Left and right focus the
         neighbouring buttons of the row (`left`, `right`). -->
    <!-- What plays, above the seek line: poster, kicker, title, badges and a short plot. The text
         column ends left of the OSD track panels. -->
    <!-- Card of the chapter row (VideoOSDBookmarks.xml): the chapter's thumbnail, its name and
         start time; a bookmark shows its own thumbnail. For Jellyfin streams the server's
         chapter images, else Kodi's own (ChapterThumb). -->
    <include name="ChapterCard">
        <param name="focused" default="false"/>
        <param name="dim" default="false"/>
        <definition>
            <control type="group">
                <left>24</left>
                <top>34</top>
                <include content="CutCard">
                    <param name="width" value="320"/>
                    <param name="height" value="180"/>
                    <param name="mask" value="ui/mask_320x180.png"/>
                    <param name="image" value="$VAR[ChapterThumb]"/>
                    <param name="glowwidth" value="368"/>
                    <param name="glowheight" value="228"/>
                    <param name="focused" value="$PARAM[focused]"/>
                    <param name="dim" value="$PARAM[dim]"/>
                </include>
                <control type="label">
                    <top>192</top>
                    <width>320</width>
                    <height>32</height>
                    <font>font_small</font>
                    <textcolor>text</textcolor>
                    <label>$INFO[ListItem.Label]</label>
                </control>
                <control type="label">
                    <top>222</top>
                    <width>320</width>
                    <height>30</height>
                    <font>font_num</font>
                    <textcolor>text_mute</textcolor>
                    <label>$INFO[ListItem.Label2]</label>
                </control>
            </control>
        </definition>
    </include>

    <include name="PlayerDetails">
        <definition>
            <control type="group">
                <left>64</left>
                <top>620</top>
                <!-- the chapter and cast rows of the OSD take this space -->
                <visible>!Window.IsActive(videobookmarks) + !Window.IsActive(1141)</visible>
                <animation effect="slide" end="0,-130" time="150" condition="Window.IsVisible(videoosd)">Conditional</animation>
                <!-- second step, after the controls and the seek line -->
                <include content="PlayerFade"/>
                <include content="CutCard">
                    <param name="image" value="$VAR[PlayerPoster]"/>
                </include>
                <include content="Kicker">
                    <param name="label" value="$VAR[PlayerKicker]"/>
                    <param name="left" value="232"/>
                    <param name="width" value="900"/>
                </include>
                <include content="GlitchTitle">
                    <param name="label" value="$INFO[VideoPlayer.Title]"/>
                    <param name="left" value="232"/>
                    <param name="top" value="32"/>
                    <param name="width" value="900"/>
                    <param name="height" value="60"/>
                    <param name="font" value="font_title"/>
                </include>
                <control type="grouplist">
                    <left>232</left>
                    <top>104</top>
                    <width>900</width>
                    <height>36</height>
                    <orientation>horizontal</orientation>
                    <itemgap>8</itemgap>
                    <include content="Tag">
                        <param name="label" value="$VAR[PlayerResolution]"/>
                        <param name="visible" value="!String.IsEmpty(VideoPlayer.VideoResolution)"/>
                    </include>
                    <include content="Tag">
                        <param name="label" value="$VAR[PlayerHdr]"/>
                        <param name="visible" value="!String.IsEmpty(VideoPlayer.VideoResolution)"/>
                    </include>
                    <include content="Tag">
                        <param name="label" value="$VAR[PlayerAudio]"/>
                        <param name="visible" value="!String.IsEmpty(VideoPlayer.AudioCodec)"/>
                    </include>
                </control>
                <control type="textbox" id="420">
                    <left>232</left>
                    <top>156</top>
                    <width>900</width>
                    <!-- three whole lines of font_body (38 px each): a taller box shows
                         the top of a fourth line; longer plots scroll -->
                    <height>116</height>
                    <font>font_body</font>
                    <textcolor>text_dim</textcolor>
                    <autoscroll delay="6000" time="2000" repeat="8000">true</autoscroll>
                    <label>$VAR[PlayerPlot]</label>
                    <!-- skin settings, Player: the poster keeps the height, no gap to close -->
                    <visible>!Skin.HasSetting(nc.osd.plot.off)</visible>
                </control>
            </control>
        </definition>
    </include>

    <include name="TrackPanel">
        <param name="id"/>
        <param name="button"/>
        <param name="prefix"/>
        <param name="heading"/>
        <param name="settings"/>
        <param name="left"/>
        <param name="right"/>
