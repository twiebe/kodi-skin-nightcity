<?xml version="1.0" encoding="UTF-8"?>
<includes>
    <!-- Where the player's next level lies, quiet like the key hint under the episodes of an info
         page: one line of muted small caps, centred on the bottom edge (top=1030, the key that
         leads down) or the top edge (top=140, Up). A shadow keeps it readable over bright video.
         It fades with its window and its condition. -->
    <include name="LevelHint">
        <param name="id"/>
        <param name="key" default="↓"/>
        <param name="label"/>
        <param name="top" default="1030"/>
        <param name="visible" default="true"/>
        <definition>
            <control type="group" id="$PARAM[id]">
                <left>0</left>
                <top>$PARAM[top]</top>
                <visible>$PARAM[visible]</visible>
                <animation effect="fade" time="150">VisibleChange</animation>
                <control type="label">
                    <width>1920</width>
                    <height>36</height>
                    <align>center</align>
                    <aligny>center</aligny>
                    <font>font_caps_small</font>
                    <textcolor>text_mute</textcolor>
                    <shadowcolor>bg</shadowcolor>
                    <label>[UPPERCASE]$PARAM[key] $PARAM[label][/UPPERCASE]</label>
                </control>
            </control>
        </definition>
    </include>

    <!-- The seek line: track, buffer, position with a bright head, chapter marks. 1792 wide,
         placed by the caller. The position id is a param because the seek bar dialog needs
         Kodi's 401 there; Player.SeekBar follows the seek preview as well as playback. -->
    <include name="PlayerBar">
        <param name="progressid" default="0"/>
        <definition>
            <control type="progress">
                <width>1792</width>
                <height>4</height>
                <texturebg colordiffuse="border_dim">ui/white.png</texturebg>
                <midtexture colordiffuse="glow">ui/white.png</midtexture>
                <info>Player.ProgressCache</info>
            </control>
            <control type="progress" id="$PARAM[progressid]">
                <width>1792</width>
                <height>4</height>
                <texturebg/>
                <midtexture colordiffuse="accent">ui/white.png</midtexture>
                <info>Player.SeekBar</info>
            </control>
            <control type="ranges">
                <top>-4</top>
                <width>1792</width>
                <height>12</height>
                <texturebg/>
                <!-- Kodi hands the chapters over as ranges from one chapter start to the
                     next, so a chapter starts where a range ends -->
                <lefttexture/>
                <midtexture/>
                <righttexture colordiffuse="accent">ui/tick.png</righttexture>
                <info>Player.Chapters</info>
            </control>
            <!-- the head at the end of an invisible fill -->
            <control type="progress">
                <top>-6</top>
                <width>1792</width>
                <height>16</height>
                <texturebg>ui/seek_track.png</texturebg>
                <midtexture>ui/seek_track.png</midtexture>
                <righttexture colordiffuse="text">ui/seek_head.png</righttexture>
                <info>Player.SeekBar</info>
            </control>
        </definition>
    </include>

    <!-- Time bubble over the head while seeking: jump and target time. Kodi cannot place a
         control by a value, so SeekBubbles holds one copy per 4 % of the line. -->
    <include name="SeekBubble">
        <param name="left"/>
        <param name="visible"/>
        <definition>
            <control type="group">
                <left>$PARAM[left]</left>
                <top>-70</top>
                <visible>$PARAM[visible]</visible>
                <control type="image">
                    <width>260</width>
                    <height>50</height>
                    <texture border="12" colordiffuse="surface">ui/cut_btn_fill.png</texture>
                </control>
                <control type="image">
                    <width>260</width>
                    <height>50</height>
                    <texture border="12" colordiffuse="focus">ui/cut_btn.png</texture>
                </control>
                <control type="label">
                    <width>260</width>
                    <height>50</height>
                    <align>center</align>
                    <aligny>center</aligny>
                    <font>font_num</font>
                    <textcolor>text</textcolor>
                    <label>$VAR[SeekDelta,[COLOR state_text],[/COLOR]  ]$VAR[PlayerTime]</label>
                </control>
            </control>
        </definition>
    </include>

