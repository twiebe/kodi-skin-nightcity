                </control>
                <control type="group">
                    <height>384</height>
                    <visible>String.IsEqual(Window(Home).Property(nc.$PARAM[prefix].rows),6)</visible>
                    <include>DialogFrame</include>
                </control>
                <control type="group">
                    <height>436</height>
                    <visible>String.IsEqual(Window(Home).Property(nc.$PARAM[prefix].rows),7)</visible>
                    <include>DialogFrame</include>
                </control>
                <control type="group">
                    <height>488</height>
                    <visible>String.IsEqual(Window(Home).Property(nc.$PARAM[prefix].rows),8)</visible>
