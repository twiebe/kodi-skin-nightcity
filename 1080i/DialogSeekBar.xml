<?xml version="1.0" encoding="UTF-8"?>
<!-- Seek line at the bottom, shown while seeking, paused, with the OSD or the info bar open.
     Kodi drives 401. Above it what plays (PlayerDetails). A dark gradient behind both, the video itself is never tinted. With the OSD
     open the line moves up above the OSD buttons, and stays there while the OSD fades out
     (Window.IsVisible: IsActive turns false as its close animation starts). -->
<window>
    <depth>DepthOSD</depth>
    <zorder>0</zorder>
    <visible>Window.IsActive(fullscreenvideo)</visible>
    <visible>!Window.IsActive(sliderdialog)</visible>
    <visible>Player.Seeking | Player.HasPerformedSeek(3) | [Player.Paused + !Player.Caching] | Player.Forwarding | Player.Rewinding | Player.ShowInfo | Player.ShowTime | Window.IsActive(fullscreeninfo) | Window.IsActive(videoosd) | Window.IsActive(playerprocessinfo) | !String.IsEmpty(Player.SeekNumeric)</visible>
    <animation effect="fade" time="150">WindowOpen</animation>
    <!-- closing is the opening backwards: what plays (PlayerFade) fades out first, the controls
         and the seek line PlayerFadeStep later; 300 ms in all, as Kodi drops keys while the OSD
         runs its close animation -->
    <animation type="WindowClose">
        <effect type="fade" start="100" end="0" time="WindowFadeTime" delay="PlayerFadeStep"/>
    </animation>
    <controls>
        <control type="image">
            <left>0</left>
            <top>440</top>
            <width>1920</width>
            <height>640</height>
            <texture colordiffuse="scrim">ui/fade_b.png</texture>
        </control>
        <include>PlayerDetails</include>
        <control type="group">
            <left>64</left>
            <top>1000</top>
            <animation effect="slide" end="0,-130" time="150" condition="Window.IsVisible(videoosd)">Conditional</animation>
            <include content="PlayerBar">
                <param name="progressid" value="401"/>
            </include>
            <include>SeekBubbles</include>
            <control type="label">
                <top>16</top>
                <width>900</width>
                <height>40</height>
                <font>font_num</font>
                <textcolor>text_dim</textcolor>
                <label>[COLOR accent]$VAR[PlayerTime][/COLOR] / $INFO[Player.Duration]</label>
            </control>
            <control type="label">
                <left>892</left>
                <top>16</top>
                <width>900</width>
                <height>40</height>
                <align>right</align>
                <font>font_num</font>
                <textcolor>text_dim</textcolor>
                <label>-$INFO[Player.TimeRemaining]</label>
                <visible>!Window.IsVisible(videoosd) + !Window.IsActive(fullscreeninfo)</visible>
            </control>
        </control>
        <!-- over the bare video Up and Down skip chapters (Kodi's keymap), OK opens the OSD -->
        <include content="LevelHint">
            <param name="id" value="490"/>
            <param name="key" value="⏎"/>
            <param name="label" value="$LOCALIZE[31232]"/>
            <param name="visible" value="!Window.IsVisible(videoosd) + !Window.IsActive(playerprocessinfo)"/>
        </include>
    </controls>
</window>
