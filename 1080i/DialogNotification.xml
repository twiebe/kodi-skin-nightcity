<?xml version="1.0" encoding="UTF-8"?>
<!-- Toast notification, top right. Kodi ids: 400 icon, 401 caption, 402 text. -->
<window>
    <depth>DepthDialog+</depth>
    <animation effect="slide" start="700,0" end="0,0" time="200">WindowOpen</animation>
    <animation effect="slide" start="0,0" end="700,0" time="200">WindowClose</animation>
    <controls>
        <control type="group">
            <left>1240</left>
            <top>80</top>
            <width>640</width>
            <height>130</height>
            <include>DialogFrame</include>
            <control type="image" id="400">
                <left>20</left>
                <top>25</top>
                <width>80</width>
                <height>80</height>
                <aspectratio>keep</aspectratio>
            </control>
            <!-- the heading pink, yellow when it warns: Kodi sets 401, a copy shows it then (a
                 colour variable would not see this dialog's controls) -->
            <control type="label" id="401">
                <left>120</left>
                <top>18</top>
                <width>500</width>
                <height>40</height>
                <font>font_label</font>
                <textcolor>accent2</textcolor>
                <visible>!$EXP[NotificationWarns]</visible>
            </control>
            <control type="label">
                <left>120</left>
                <top>18</top>
                <width>500</width>
                <height>40</height>
                <font>font_label</font>
                <textcolor>warn</textcolor>
                <label>$INFO[Control.GetLabel(401)]</label>
                <visible>$EXP[NotificationWarns]</visible>
            </control>
            <control type="fadelabel" id="402">
                <left>120</left>
                <top>66</top>
                <width>500</width>
                <height>40</height>
                <font>font_small</font>
                <textcolor>text</textcolor>
                <scroll>true</scroll>
                <scrollout>false</scrollout>
                <pauseatend>2000</pauseatend>
            </control>
        </control>
    </controls>
</window>
