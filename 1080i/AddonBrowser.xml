<?xml version="1.0" encoding="UTF-8"?>
<!-- Add-on browser: list 50 plus a side column. Kodi ids: 7 foreign filter, 8 broken filter, 9 check updates, 5 settings. -->
<window>
    <defaultcontrol always="true">50</defaultcontrol>
    <views>50</views>
    <controls>
        <include>Background</include>
        <include content="StatusBar">
            <param name="title" value="$LOCALIZE[24001]$INFO[Container.FolderName,[COLOR text_mute] ▪ [/COLOR],]"/>
            <param name="pathwidth" value="780"/>
        </include>
        <!-- Left from the column goes back to the list; Left on the list is Back, a folder up or out of the window, which no hint can name -->
        <include content="LevelHint">
            <param name="id" value="9058"/>
            <param name="key" value="←"/>
            <param name="label" value="$INFO[Container.FolderName]"/>
            <param name="top" value="30"/>
            <param name="visible" value="!System.HasActiveModalDialog + ControlGroup(9000).HasFocus()"/>
            <param name="animate" value="!Player.HasVideo"/>
        </include>
        <!-- the content fades in on open; background and status line stay -->
        <control type="group">
            <include>WindowFade</include>
            <include content="DialogList">
                <param name="id" value="50"/>
                <onleft>Action(Back)</onleft>
                <onright>9000</onright>
                <param name="left" value="110"/>
                <param name="top" value="90"/>
                <param name="width" value="1260"/>
                <param name="height" value="935"/>
                <param name="label2" value="$INFO[ListItem.Label2]"/>
                <!-- same size as the rows of the other settings pages -->
                <param name="font" value="font_label"/>
                <param name="rowwidth" value="1240"/>
                <param name="inset" value="10"/>
            </include>
            <control type="grouplist" id="9000">
                <left>1430</left>
                <top>90</top>
                <width>420</width>
                <height>620</height>
                <orientation>vertical</orientation>
                <itemgap>-20</itemgap>
                <onleft>50</onleft>
                <control type="radiobutton" id="7">
                    <width>420</width>
                    <include>SettingsRowLook</include>
                    <label>$LOCALIZE[31090]</label>
                </control>
                <control type="radiobutton" id="8">
                    <width>420</width>
                    <include>SettingsRowLook</include>
                    <label>$LOCALIZE[31091]</label>
                </control>
                <include content="ListButton">
                    <param name="id" value="9"/>
                    <param name="label" value="$LOCALIZE[24034]"/>
                    <param name="width" value="420"/>
                </include>
                <include content="ListButton">
                    <param name="id" value="5"/>
                    <param name="label" value="$LOCALIZE[5]"/>
                    <param name="width" value="420"/>
                </include>
            </control>
        </control>
    </controls>
</window>
